<Item class="Folder" referent="RBX655FB5A413D84EE7BEB9F53F614CD8E6"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBXE54DBD2D26804EA9991939B79C140B66"><Properties><string name="Name">Actions</string><ProtectedString name="Source"><![CDATA[-- Everything that changes the game state, by name. The server runs these on the real game state
-- (the client only asks for them). Pure Lua (no Roblox APIs), so the logic tests can run it too.
-- Actions.run(state, name, args) -> ok, message, data
local Root = script:FindFirstAncestor("Headliner")
local Config = require(Root.Config)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local StageItems = require(Root.Data.StageItems)
local Util = require(Root.Logic.Util)
local Sim = require(Root.Logic.Sim)
local GS = require(Root.Logic.GameState)

local Actions = {}
local A = {}
Actions.handlers = A

local function str(x, maxLen)
	if type(x) ~= "string" then
		return nil
	end
	x = x:gsub("^%s+", ""):gsub("%s+$", "")
	if #x == 0 then
		return nil
	end
	return x:sub(1, maxLen or 40)
end

local function num(x)
	if type(x) ~= "number" or x ~= x or x == math.huge or x == -math.huge then
		return nil
	end
	return x
end

local function tourShow(state, tourId, idx)
	local tour = GS.getTour(state, tourId)
	local s = tour and type(idx) == "number" and tour.shows[idx]
	return tour, s
end

-- day events with ids instead of table references (they go over the network)
local function serializeDay(ev)
	local out = { soldOut = {}, played = {}, live = {}, completed = {}, achievements = ev.achievements or {}, levelUp = ev.levelUp }
	for _, so in ipairs(ev.soldOut or {}) do
		table.insert(out.soldOut, { tourId = so.tour.id, idx = so.idx })
	end
	for _, p in ipairs(ev.played or {}) do
		table.insert(out.played, { tourId = p.tour.id, idx = p.idx, result = p.result })
	end
	for _, l in ipairs(ev.live or {}) do
		table.insert(out.live, { tourId = l.tourId, idx = l.idx })
	end
	for _, t in ipairs(ev.completed or {}) do
		table.insert(out.completed, t.id)
	end
	return out
end
Actions.serializeDay = serializeDay

local function merge(into, ev)
	for _, k in ipairs({ "soldOut", "played", "live", "completed", "achievements" }) do
		for _, x in ipairs(ev[k]) do
			table.insert(into[k], x)
		end
	end
	into.levelUp = ev.levelUp or into.levelUp
end

------------------------------------------------------------------ time & shows
function A.nextDay(state)
	-- shows of today must be played (or skipped) before the next day starts
	for _, t in ipairs(state.tours) do
		for _, s in ipairs(t.shows) do
			if not s.done and s.day <= state.day then
				return false, "A show is waiting for you today."
			end
		end
	end
	return true, nil, serializeDay(GS.advanceDay(state))
end

-- plays one show of today (live or skipped): the result is decided and applied right away
function A.playShow(state, a)
	local tour, s = tourShow(state, a.tourId, a.idx)
	if not s or s.done then
		return false, "This show was already played."
	end
	if s.day > state.day then
		return false, "This show is not today."
	end
	local r = GS.prepareShow(state, tour, a.idx)
	local res = GS.applyShow(state, tour, a.idx, r)
	return true, nil, { result = r, achievements = res.achievements, completed = res.completed }
end

------------------------------------------------------------------ artists
function A.sign(state, a)
	local ok, msg = GS.sign(state, a.artistId)
	local ach = ok and GS.checkAchievements(state) or {}
	return ok, msg, { achievements = ach }
end

------------------------------------------------------------------ tours
function A.createTour(state, a)
	local d = a.draft
	if type(d) ~= "table" or type(d.shows) ~= "table" then
		return false, "Nothing to book."
	end
	local shows = {}
	for _, s in ipairs(d.shows) do
		if type(s) == "table" and Countries.venueById[s.venueId or ""] then
			table.insert(shows, { venueId = s.venueId, day = num(s.day) and math.floor(s.day) or nil, price = num(s.price) })
		end
	end
	local prices = {}
	if type(d.prices) == "table" then
		for look, list in pairs(d.prices) do
			if type(list) == "table" then
				prices[look] = {}
				for sec, p in pairs(list) do
					if type(sec) == "string" and num(p) then
						prices[look][sec] = Util.clamp(math.floor(p), 5, 4000)
					end
				end
			end
		end
	end
	local designs = {}
	if type(d.designs) == "table" then
		for cls, id in pairs(d.designs) do
			if type(cls) == "string" and type(id) == "string" then
				designs[cls] = id
			end
		end
	end
	local ok, res = GS.createTour(state, {
		artistId = d.artistId,
		name = str(d.name, 40),
		designId = d.designId,
		designs = designs,
		price = num(d.price),
		prices = prices,
		firstIn = num(d.firstIn),
		gap = num(d.gap),
		shows = shows,
	})
	if not ok then
		return false, res
	end
	return true, nil, { tourId = res.id }
end

-- the tour plan (built step by step in different rooms) is stored on the server
local function cleanDraft(state, d)
	local out = { shows = {}, prices = {}, designs = {} }
	local ad = Artists.byId[(type(d.artistId) == "string") and d.artistId or ""]
	if ad and state.artists[ad.id].signed and not GS.activeTour(state, ad.id) then
		out.artistId = ad.id
	end
	if not out.artistId then
		return out
	end
	out.name = str(d.name, 40)
	out.price = num(d.price)
	out.pricesSet = d.pricesSet == true
	out.stageSet = d.stageSet == true
	if type(d.shows) == "table" then
		for _, s in ipairs(d.shows) do
			if #out.shows >= Config.MAX_SHOWS_PER_TOUR then
				break
			end
			if type(s) == "table" and Countries.venueById[s.venueId or ""] and num(s.day) then
				table.insert(out.shows, { venueId = s.venueId, day = math.floor(s.day) })
			end
		end
	end
	if type(d.prices) == "table" then
		for look, list in pairs(d.prices) do
			if type(look) == "string" and type(list) == "table" then
				out.prices[look] = {}
				for sec, p in pairs(list) do
					if type(sec) == "string" and num(p) then
						out.prices[look][sec] = Util.clamp(math.floor(p), 5, 4000)
					end
				end
			end
		end
	end
	if type(d.designs) == "table" then
		for cls, id in pairs(d.designs) do
			if type(cls) == "string" and type(id) == "string" and GS.getDesign(state, id) then
				out.designs[cls] = id
			end
		end
	end
	return out
end

function A.setDraft(state, a)
	if type(a.draft) ~= "table" then
		return false, "Bad plan."
	end
	state.draft = cleanDraft(state, a.draft)
	return true
end

-- the plan becomes a real tour: tickets go on sale
function A.announceTour(state, a)
	local d = cleanDraft(state, state.draft or {})
	if not d.artistId then
		return false, "Pick an artist in the MEETING ROOM first."
	end
	if #d.shows == 0 then
		return false, "Plan the dates at the WORLD MAP table first."
	end
	-- venue sizes without a chosen stage get the biggest stage that fits
	for _, s in ipairs(d.shows) do
		local vc = GS.venueClass(Countries.venueById[s.venueId])
		if not d.designs[vc] then
			local vo, best, bestO = Config.STAGE_CLASS_BY_ID[vc].order, nil, 0
			for _, des in ipairs(state.designs) do
				local o = Config.STAGE_CLASS_BY_ID[des.class].order
				if o <= vo and o > bestO then
					best, bestO = des, o
				end
			end
			d.designs[vc] = best and best.id or nil
		end
	end
	local ok, msg, data = A.createTour(state, { draft = { artistId = d.artistId, name = str(a.name, 40) or d.name, designs = d.designs, prices = d.prices, price = d.price, shows = d.shows } })
	if ok then
		state.draft = {}
	end
	return ok, msg, data
end

function A.buyMarketing(state, a)
	return GS.buyMarketing(state, a.tourId, a.id)
end

function A.setTourPrice(state, a)
	local p = num(a.price)
	if not p then
		return false, "Bad price."
	end
	GS.setTourPrice(state, a.tourId, p)
	return true
end

function A.cancelTour(state, a)
	return GS.cancelTour(state, a.tourId)
end

function A.cancelShow(state, a)
	return GS.cancelShow(state, a.tourId, num(a.idx))
end

function A.renameTour(state, a)
	local tour = GS.getTour(state, a.tourId)
	local name = str(a.name, 40)
	if not tour or not name then
		return false, "Could not rename."
	end
	tour.name = name
	return true
end

-- live = false: the show is simulated (the player does not go there)
function A.setLive(state, a)
	local _, s = tourShow(state, a.tourId, a.idx)
	if not s or s.done then
		return false
	end
	s.skipLive = (a.live == false) or nil
	return true
end

------------------------------------------------------------------ stages
function A.newDesign(state, a)
	local cls = Config.STAGE_CLASS_BY_ID[a.class or ""] and a.class or "Arena"
	local layout = (a.layout == "center") and "center" or "end"
	if #state.designs >= Config.MAX_DESIGNS then
		return false, "You can have up to " .. Config.MAX_DESIGNS .. " stages. Delete one first."
	end
	if a.preset then
		for _, p in ipairs(StageItems.PRESETS) do
			if p.name == a.preset then
				local d, msg = GS.addDesignFromTemplate(state, p)
				if not d then
					return false, msg
				end
				return true, nil, { designId = d.id }
			end
		end
		return false, "Unknown template."
	end
	local name = str(a.name, 24) or (cls .. " " .. (layout == "center" and "Center" or "Stage") .. " " .. (#state.designs + 1))
	local d = GS.addDesign(state, name, {}, cls, layout)
	local msg = nil
	if a.start == "deck" then
		local c = Config.STAGE_CLASS_BY_ID[cls]
		local rec
		if layout == "center" then
			rec = { t = "deck_round", x = 0, z = 0, r = 0, w = math.min(70, math.floor(c.center * 0.5)), h = 6, y = 0 }
		else
			rec = { t = "deck", x = 0, z = c.minZ + math.floor((c.maxX - c.minX) * 0.12) + 2, r = 0, w = math.floor((c.maxX - c.minX) * 0.6), d = math.floor((c.maxX - c.minX) * 0.25), h = (c.order == 1) and 4 or 6, y = 0 }
		end
		local ok, err = GS.buyItem(state, d, rec)
		if not ok then
			msg = err
		end
	end
	return true, msg, { designId = d.id }
end

function A.copyDesign(state, a)
	local d = GS.getDesign(state, a.designId)
	if not d then
		return false, "Stage not found."
	end
	if #state.designs >= Config.MAX_DESIGNS then
		return false, "You can have up to " .. Config.MAX_DESIGNS .. " stages. Delete one first."
	end
	local value = GS.designValue(d)
	if state.money < value then
		return false, "Not enough money for the equipment."
	end
	state.money = state.money - value
	local items = Util.deepCopy(d.items)
	for _, it in ipairs(items) do
		it.uid = nil
	end
	local c = GS.addDesign(state, (d.name .. " copy"):sub(1, 24), items, d.class, d.layout)
	return true, nil, { designId = c.id }
end

-- the tutorial: the step the player reached, or done (finished / skipped)
function A.tutorial(state, a)
	state.tutorial = type(state.tutorial) == "table" and state.tutorial or {}
	if a.done == true then
		state.tutorial = { done = true }
	elseif num(a.step) then
		state.tutorial.step = Util.clamp(math.floor(a.step), 1, 99)
	end
	return true
end

function A.renameDesign(state, a)
	local d = GS.getDesign(state, a.designId)
	local name = str(a.name, 24)
	if not d or not name then
		return false, "Please type a name."
	end
	d.name = name
	return true, "Stage renamed: " .. name
end

function A.deleteDesign(state, a)
	return GS.deleteDesign(state, a.designId)
end

-- The stage builder edits a design on the client and sends the whole design back when it closes.
-- The server pays the difference item by item (uid): new items cost their price, removed items are
-- sold for RESALE, changed items pay or refund the price difference.
local ITEM_FIELDS = { t = "string", x = "number", y = "number", z = "number", r = "number", w = "number", d = "number", h = "number", yo = "number", uid = "string" }
local function cleanItem(it)
	if type(it) ~= "table" or type(it.t) ~= "string" or not StageItems.byId[it.t] then
		return nil
	end
	local out = {}
	for k, v in pairs(it) do
		if type(k) == "string" and #k <= 24 then
			local want = ITEM_FIELDS[k]
			if want then
				if type(v) == want and (want ~= "number" or num(v)) then
					out[k] = v
				end
			elseif type(v) == "string" then
				out[k] = v:sub(1, 200)
			elseif type(v) == "boolean" or num(v) then
				out[k] = v
			elseif type(v) == "table" then
				-- small nested settings (screen content per song etc.)
				local ok, copy = pcall(Util.deepCopy, v)
				if ok then
					out[k] = copy
				end
			end
		end
	end
	return out
end

function Actions.designCost(old, newItems)
	local byUid = {}
	for _, it in ipairs(old.items) do
		if it.uid then
			byUid[it.uid] = it
		end
	end
	local cost, seen = 0, {}
	for _, it in ipairs(newItems) do
		local def = StageItems.byId[it.t]
		local o = it.uid and byUid[it.uid]
		if o and not seen[it.uid] and o.t == it.t then
			seen[it.uid] = true
			local diff = Sim.itemPrice(def, it) - Sim.itemPrice(def, o)
			cost = cost + (diff > 0 and diff or Util.round(diff * Config.RESALE))
		else
			cost = cost + Sim.itemPrice(def, it)
		end
	end
	for uid, o in pairs(byUid) do
		if not seen[uid] then
			cost = cost - Util.round(Sim.itemPrice(StageItems.byId[o.t], o) * Config.RESALE)
		end
	end
	return cost
end

function A.saveDesign(state, a)
	local d = GS.getDesign(state, a.designId)
	local nd = a.design
	if not d or type(nd) ~= "table" or type(nd.items) ~= "table" then
		return false, "Stage not found."
	end
	local items = {}
	for _, it in ipairs(nd.items) do
		local c = cleanItem(it)
		if c then
			table.insert(items, c)
		end
	end
	local cls = Config.STAGE_CLASS_BY_ID[d.class] or Config.STAGE_CLASSES[1]
	if #items > math.max(cls.maxItems, #d.items) then
		return false, "Too many items for this stage size."
	end
	GS.ensureUids({ items = items })
	local cost = Actions.designCost(d, items)
	if cost > 0 and state.money < cost and not state.sandbox then
		return false, "Not enough money for the new equipment (" .. Util.money(cost) .. ")."
	end
	state.money = state.money - cost
	d.items = items
	d.name = str(nd.name, 24) or d.name
	return true, nil, { cost = cost }
end

------------------------------------------------------------------ the building
function A.visit(state, a)
	if type(a.station) == "string" and #a.station < 20 then
		state.visited = state.visited or {}
		state.visited[a.station] = true
	end
	return true
end

------------------------------------------------------------------ sandbox tools (developer test mode only)
-- jumps ahead day by day until a show is due (or `days` days passed)
function A.devSkip(state, a)
	if not state.sandbox then
		return false, "Only in the sandbox."
	end
	local all = serializeDay({})
	local maxDays = Util.clamp(math.floor(num(a.days) or 60), 1, 365)
	for _ = 1, maxDays do
		local ok, _, ev = A.nextDay(state)
		if not ok then
			break
		end
		merge(all, ev)
		if a.untilShow and #ev.live > 0 then
			break
		end
	end
	return true, nil, all
end

function A.devTickets(state, a)
	if not state.sandbox then
		return false, "Only in the sandbox."
	end
	state.stats.tickets = state.stats.tickets + math.floor(num(a.n) or 10000)
	return true
end

------------------------------------------------------------------ entry point
function Actions.run(state, name, args)
	local fn = A[name]
	if type(name) ~= "string" or not fn then
		return false, "Unknown action."
	end
	if type(args) ~= "table" then
		args = {}
	end
	local ok, msg, data = fn(state, args)
	if state.sandbox and state.money < Config.SANDBOX_MONEY then
		state.money = Config.SANDBOX_MONEY
	end
	return ok == true, msg, data
end

local _ = Artists
return Actions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7EDAE94CC6964CC68FAB1F975D6DC524"><Properties><string name="Name">GameState</string><ProtectedString name="Source"><![CDATA[-- Game state: everything that gets saved. Pure Lua (no Roblox APIs).
local Root = script:FindFirstAncestor("Headliner")
local Config = require(Root.Config)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local StageItems = require(Root.Data.StageItems)
local Achievements = require(Root.Data.Achievements)
local Rivals = require(Root.Data.Rivals)
local Util = require(Root.Logic.Util)
local Sim = require(Root.Logic.Sim)
local Social = require(Root.Logic.Social)

local GS = {}

------------------------------------------------------------------ creation
function GS.freshArtist(ad)
	return {
		id = ad.id,
		signed = false,
		fans = Util.deepCopy(ad.fans),
		hype = ad.hype,
		lastPlayed = {},
		shows = 0,
		gross = 0,
	}
end

function GS.newId(state, prefix)
	local id = prefix .. tostring(state.nextId)
	state.nextId = state.nextId + 1
	return id
end

function GS.log(state, text)
	table.insert(state.log, 1, { day = state.day, text = text })
	while #state.log > 40 do
		table.remove(state.log)
	end
end

-- a random id for a placed stage item (made on the client and the server, so it is not a counter)
local uidCount = 0
function GS.uid()
	uidCount = uidCount + 1
	return "u" .. tostring(math.random(1, 999999999)) .. "_" .. tostring(uidCount)
end

-- every item of a design gets a uid (the server pays the difference of a changed design by uid)
function GS.ensureUids(design)
	local seen = {}
	for _, it in ipairs(design.items or {}) do
		if type(it.uid) ~= "string" or seen[it.uid] then
			it.uid = GS.uid()
		end
		seen[it.uid] = true
	end
end

-- opts = { sandbox = true } for the developer test mode
function GS.new(labelName, starterId, opts)
	opts = opts or {}
	local state = {
		version = Config.SAVE_VERSION,
		labelName = labelName or Config.DEFAULT_LABEL_NAME,
		money = Config.START_MONEY,
		day = 0,
		artists = {},
		designs = {},
		tours = {},
		nextId = 1,
		achievements = {},
		log = {},
		social = {},
		levelSeen = 1,
		sandbox = opts.sandbox == true,
		visited = {},
		tutorial = (opts.sandbox == true) and { done = true } or { step = 1 }, -- the guide (Client/Tutorial.lua): step reached, done = true when finished or skipped
		-- the tour being planned, step by step in different rooms (see GS.planStage)
		draft = {},
		stats = {
			shows = 0,
			sellouts = 0,
			tickets = 0,
			totalGross = 0,
			bestShowGross = 0,
			bestShowText = "",
			biggestSellout = 0,
			fiveStars = 0,
			bestTourGross = 0,
			maxRegions = 0,
		},
	}
	for _, ad in ipairs(Artists.list) do
		state.artists[ad.id] = GS.freshArtist(ad)
	end
	local starter = Artists.byId[starterId or ""] or Artists.byId.lila
	state.artists[starter.id].signed = true
	for _, p in ipairs(StageItems.PRESETS) do
		if not p.shop then
			GS.addDesign(state, p.name, Util.deepCopy(p.items), p.class, p.layout).template = p.name
		end
	end
	GS.log(state, state.labelName .. " opens its doors with " .. starter.name .. " on the roster.")
	if state.sandbox then
		state.money = Config.SANDBOX_MONEY
		state.levelSeen = #Config.LEVELS
		GS.log(state, "SANDBOX: unlimited money, every level, artist, venue and room is open.")
	end
	return state
end

-- Repairs / upgrades a loaded save so missing fields never crash the game
function GS.sanitize(data)
	if type(data) ~= "table" or data.version ~= Config.SAVE_VERSION then
		return GS.new()
	end
	local fresh = GS.new()
	-- saves from before the tutorial existed: no tutorial for a label that already played
	if type(data.tutorial) ~= "table" then
		data.tutorial = ((type(data.stats) == "table" and (data.stats.shows or 0) > 0) or (type(data.tours) == "table" and #data.tours > 0)) and { done = true } or { step = 1 }
	end
	for k, v in pairs(fresh) do
		if type(data[k]) ~= type(v) then
			data[k] = v
		end
	end
	for k, v in pairs(fresh.stats) do
		if type(data.stats[k]) ~= type(v) then
			data.stats[k] = v
		end
	end
	for _, ad in ipairs(Artists.list) do
		local a = data.artists[ad.id]
		if type(a) ~= "table" then
			data.artists[ad.id] = GS.freshArtist(ad)
		else
			a.fans = type(a.fans) == "table" and a.fans or Util.deepCopy(ad.fans)
			for rid, n in pairs(ad.fans) do
				if type(a.fans[rid]) ~= "number" then
					a.fans[rid] = n
				end
			end
			a.lastPlayed = type(a.lastPlayed) == "table" and a.lastPlayed or {}
			a.hype = type(a.hype) == "number" and a.hype or ad.hype
			a.shows = a.shows or 0
			a.gross = a.gross or 0
		end
	end
	for _, d in ipairs(data.designs) do
		if type(d.items) ~= "table" then
			d.items = {}
		end
		GS.ensureUids(d)
	end
	if #data.designs == 0 then
		GS.addDesign(data, "My Design", {}, "Club", "end")
	end
	return data
end

------------------------------------------------------------------ artists
function GS.signedArtists(state)
	local out = {}
	for _, ad in ipairs(Artists.list) do
		if state.artists[ad.id].signed then
			table.insert(out, ad)
		end
	end
	return out
end

function GS.unsignedArtists(state)
	local out = {}
	for _, ad in ipairs(Artists.list) do
		if not state.artists[ad.id].signed then
			table.insert(out, ad)
		end
	end
	return out
end

function GS.activeTour(state, artistId)
	for _, t in ipairs(state.tours) do
		if t.artistId == artistId and t.status ~= "done" then
			return t
		end
	end
	return nil
end

function GS.level(state)
	if state.sandbox then
		local n = #Config.LEVELS
		return n, Config.LEVELS[n], nil
	end
	local lvl = 1
	for i, l in ipairs(Config.LEVELS) do
		if state.stats.tickets >= l.tickets then
			lvl = i
		end
	end
	return lvl, Config.LEVELS[lvl], Config.LEVELS[lvl + 1]
end

function GS.sign(state, artistId)
	local ad = Artists.byId[artistId]
	local a = state.artists[artistId]
	if not ad or a.signed then
		return false, "Already signed."
	end
	if ad.level > GS.level(state) then
		return false, ad.name .. " only talks to a " .. Config.LEVELS[ad.level].name .. " (level " .. ad.level .. ")."
	end
	if state.money < ad.signCost then
		return false, "Not enough money to sign " .. ad.name .. "."
	end
	state.money = state.money - ad.signCost
	a.signed = true
	GS.log(state, "Signed " .. ad.name .. " for " .. Util.money(ad.signCost) .. "!")
	Social.add(state, "sign", { artistId = ad.id }, 2)
	return true, ad.name .. " joined your label!"
end

-- can the label book this venue yet? (level 1 = clubs, see Config.VENUE_LEVEL)
function GS.venueLevel(venue)
	return Config.VENUE_LEVEL[venue.type] or 1
end
function GS.venueUnlocked(state, venue)
	return GS.level(state) >= GS.venueLevel(venue)
end

------------------------------------------------------------------ the label building: rooms open one after another
GS.STATIONS = { "laptop", "maptable", "meeting", "stagehall", "charts" }
function GS.unlocks(state)
	local st = state.stats
	local anyDone = false
	for _, t in ipairs(state.tours) do
		if t.status == "done" then
			anyDone = true
		end
	end
	local all = state.sandbox == true
	return {
		laptop = true,
		maptable = true,
		meeting = true,
		phone = true,
		stagehall = true, -- build a stage right from the first tour
		charts = all or anyDone or st.shows >= 5,
	}
end
GS.UNLOCK_HINT = {
	stagehall = "Opens after your first show",
	charts = "Opens after your first finished tour",
}

-- how far the tour plan is: "artist" (meeting room) -> "dates" (world map) -> "tickets" (laptop)
-- -> "stage" (stage hall) -> "announce" (laptop); nil = nothing planned
GS.PLAN_STEPS = {
	{ id = "artist", name = "ARTIST", where = "Meeting room", station = "meeting" },
	{ id = "dates", name = "DATES", where = "World map", station = "maptable" },
	{ id = "tickets", name = "TICKETS", where = "Laptop", station = "laptop" },
	{ id = "stage", name = "STAGE", where = "Stage hall", station = "stagehall" },
	{ id = "announce", name = "ANNOUNCE", where = "Laptop", station = "laptop" },
}
function GS.planStage(state)
	local d = state.draft or {}
	if not d.artistId then
		return "artist"
	elseif #(d.shows or {}) == 0 then
		return "dates"
	elseif not d.pricesSet then
		return "tickets"
	elseif not d.stageSet then
		return "stage"
	end
	return "announce"
end

-- what the player should do next: { text, target = station id or nil }
function GS.objective(state)
	local un = GS.unlocks(state)
	local visited = state.visited or {}
	local active = nil
	for _, t in ipairs(state.tours) do
		if t.status ~= "done" then
			active = t
		end
	end
	local d = state.draft or {}
	if d.artistId then
		local name = Artists.byId[d.artistId].name
		local stage = GS.planStage(state)
		if stage == "dates" then
			return { text = "Plan the dates of " .. name .. "'s tour at the WORLD MAP table.", target = "maptable" }
		elseif stage == "tickets" then
			return { text = "Set the ticket prices on the LAPTOP (TOUR PLAN).", target = "laptop" }
		elseif stage == "stage" then
			return { text = "Pick or build the stage in the STAGE HALL.", target = "stagehall" }
		end
		return { text = "Check the plan on the LAPTOP and announce the tour!", target = "laptop" }
	end
	if #state.tours == 0 then
		return { text = "Sit down in the MEETING ROOM and pick the artist for your first tour.", target = "meeting" }
	end
	if un.charts and not visited.charts then
		return { text = "The CHARTS screen is on! See where your tours rank.", target = "charts" }
	end
	local talent = false
	for _, ad in ipairs(Artists.list) do
		if not state.artists[ad.id].signed and ad.level <= GS.level(state) and ad.signCost <= state.money then
			talent = true
		end
	end
	if talent and not visited.meeting and state.stats.shows >= 1 then
		return { text = "New talent wants to meet you. Sit down in the MEETING ROOM.", target = "meeting" }
	end
	if active then
		local nextDay = nil
		for _, s in ipairs(active.shows) do
			if not s.done and (not nextDay or s.day < nextDay) then
				nextDay = s.day
			end
		end
		if nextDay then
			local d = nextDay - state.day
			return { text = "Next show in " .. d .. " day" .. (d == 1 and "" or "s") .. ". Ticket sales are on the LAPTOP.", target = nil }
		end
	end
	return { text = "No tour on sale. Pick the next artist in the MEETING ROOM.", target = "meeting" }
end

------------------------------------------------------------------ designs
function GS.addDesign(state, name, items, class, layout)
	local d = { id = GS.newId(state, "d"), name = name, items = items or {}, class = class or "Arena", layout = layout or "end" }
	GS.ensureUids(d)
	table.insert(state.designs, d)
	return d
end

-- A new design built from a template (pays for the equipment). Returns design or nil, message
function GS.addDesignFromTemplate(state, preset, name)
	local cost = GS.designValue({ items = preset.items })
	if state.money < cost then
		return nil, "This template needs equipment worth " .. Util.money(cost) .. "."
	end
	if #state.designs >= Config.MAX_DESIGNS then
		return nil, "You can have up to " .. Config.MAX_DESIGNS .. " stages. Delete one first."
	end
	state.money = state.money - cost
	return GS.addDesign(state, name or preset.name, Util.deepCopy(preset.items), preset.class, preset.layout)
end

-- Places where the artist performs a song: artist spots, lifts and instruments the artist plays.
GS.PLAY_ITEMS = { lift = true, poplift = true, towerlift = true, piano = true, keys = true, drums = true, djbooth = true, acoustic = true, harp = true }
-- lifts: the artist comes up out of the stage (lift, pop-up) or is lifted high into the air (tower)
GS.LIFT_ITEMS = { lift = true, poplift = true, towerlift = true }

-- The setlist of a design. Lifts and instruments keep the song number set in the builder,
-- artist spots take the free song numbers in the order they were placed.
-- returns { count = songs, songOf = { [rec] = n }, place = { [n] = rec } }
function GS.songPlan(design, extraSpot)
	local items = (design and design.items) or {}
	local place, songOf = {}, {}
	for _, it in ipairs(items) do
		if GS.PLAY_ITEMS[it.t] then
			local n = it.play
			if (it.t == "lift" or it.t == "poplift") and n == nil then
				n = 1
			end
			if type(n) == "number" and n >= 1 then
				songOf[it] = n
				place[n] = place[n] or it
			end
		end
	end
	local n = 1
	local function addSpot(it)
		while place[n] do
			n = n + 1
		end
		place[n] = it
		songOf[it] = n
	end
	for _, it in ipairs(items) do
		-- a tower lift without a fixed song takes the next free song like a spot
		if it.t == "spot" or (it.t == "towerlift" and it.play == nil) then
			addSpot(it)
		end
	end
	if extraSpot then
		addSpot(extraSpot)
	end
	local top = 0
	for k in pairs(place) do
		if k > top then
			top = k
		end
	end
	local count = (top == 0) and 4 or Util.clamp(top, 3, StageItems.MAX_SPOTS)
	return { count = count, songOf = songOf, place = place }
end

-- number of songs a design plays (at least 3, nothing placed = 4)
function GS.songCount(design)
	return GS.songPlan(design).count
end

------------------------------------------------------------------ calendar: when is a venue free?
-- Venues host other events too (other bands, sport, fairs). This is the same in every game: a few days a month
-- are taken, stadiums more often (match days). Your own shows (any artist) also block the venue.
local BUSY_SHARE = { club = 0.12, theatre = 0.18, arena = 0.22, amphi = 0.2, stadium = 0.3 }
local function venueHash(id)
	local h = 0
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 100003
	end
	return h
end
-- returns nil if free, otherwise a short reason
function GS.venueBusy(state, venueId, day, ignore)
	for _, t in ipairs(state.tours or {}) do
		if t ~= ignore then
			for _, s in ipairs(t.shows) do
				if s.venueId == venueId and s.day == day and not s.done then
					return Artists.byId[t.artistId].name
				end
			end
		end
	end
	local v = Countries.venueById[venueId]
	local look = Countries.VENUE_TYPES[v.type].look
	-- other events come in short runs: decide per 2-day block, then per day
	local h = venueHash(venueId)
	local block = math.floor(day / 2)
	local x = math.sin(block * 12.9898 + h * 0.78233) * 43758.5453
	x = x - math.floor(x)
	if x < (BUSY_SHARE[look] or 0.18) then
		local y = math.sin(day * 4.1414 + h * 1.337) * 9631.17
		y = y - math.floor(y)
		if y < 0.75 then
			return (look == "stadium") and "football" or "other event"
		end
	end
	return nil
end

-- the earliest free day for a show at a venue, not before `from` and not on a day of `taken` (set of days)
function GS.nextFreeDay(state, venueId, from, taken)
	for d = from, from + 120 do
		if not GS.venueBusy(state, venueId, d) and not (taken and taken[d]) then
			return d
		end
	end
	return from
end

-- days needed between two shows: the next day in the same country or a neighbour country,
-- one travel day in between on the same continent, two travel days to another continent
function GS.travelGap(a, b)
	if not a or not b then
		return 0
	end
	if a.venueId == b.venueId then
		return 1
	end
	return 1 + Countries.travelDays(Countries.venueById[a.venueId].countryId, Countries.venueById[b.venueId].countryId)
end

-- Show days of a route: another night in the same venue is the next day, a new venue `gap` days later
function GS.scheduleDays(startDay, shows, gap)
	local days = {}
	for i, s in ipairs(shows) do
		if i == 1 then
			days[i] = startDay
		elseif shows[i - 1].venueId == s.venueId then
			days[i] = days[i - 1] + 1
		else
			days[i] = days[i - 1] + gap
		end
	end
	return days
end

-- Buying / selling stage equipment
function GS.buyItem(state, design, rec)
	local def = StageItems.byId[rec.t]
	local price = Sim.itemPrice(def, rec)
	if state.money < price then
		return false, "Not enough money for " .. def.name .. " (" .. Util.money(price) .. ")."
	end
	state.money = state.money - price
	if type(rec.uid) ~= "string" then
		rec.uid = GS.uid()
	end
	table.insert(design.items, rec)
	return true
end

function GS.sellItem(state, design, rec)
	for i, r in ipairs(design.items) do
		if r == rec then
			table.remove(design.items, i)
			state.money = state.money + Util.round(Sim.itemPrice(StageItems.byId[rec.t], rec) * Config.RESALE)
			return true
		end
	end
	return false
end

-- Changes size/height of a placed item and pays (or refunds) the price difference
function GS.changeItem(state, rec, changes)
	local def = StageItems.byId[rec.t]
	local old = Sim.itemPrice(def, rec)
	local test = Util.deepCopy(rec)
	for k, v in pairs(changes) do
		test[k] = v
	end
	local diff = Sim.itemPrice(def, test) - old
	if diff > 0 and state.money < diff then
		return false, "Not enough money (" .. Util.money(diff) .. " needed)."
	end
	state.money = state.money - (diff > 0 and diff or Util.round(diff * Config.RESALE))
	for k, v in pairs(changes) do
		rec[k] = v
	end
	return true
end

function GS.designValue(design)
	return Sim.designStats(design, nil).value
end

-- stage size class of a venue: "Club" | "Theatre" | "Arena" | "Stadium"
function GS.venueClass(venue)
	return Countries.VENUE_TYPES[venue.type].stage
end

-- the production used for one show of a tour
function GS.showDesign(state, tour, idx)
	local v = Countries.venueById[tour.shows[idx].venueId]
	local id = tour.designs and tour.designs[GS.venueClass(v)] or tour.designId
	return GS.getDesign(state, id) or GS.getDesign(state, tour.designId)
end

function GS.getDesign(state, id)
	for _, d in ipairs(state.designs) do
		if d.id == id then
			return d
		end
	end
	return nil
end

function GS.designInUse(state, id)
	for _, t in ipairs(state.tours) do
		local used = t.designId == id
		for _, did in pairs(t.designs or {}) do
			if did == id then
				used = true
			end
		end
		if used and t.status ~= "done" then
			return true
		end
	end
	return false
end

function GS.deleteDesign(state, id)
	if GS.designInUse(state, id) then
		return false, "This design is used by an active tour."
	end
	if #state.designs <= 1 then
		return false, "You need at least one design."
	end
	for i, d in ipairs(state.designs) do
		if d.id == id then
			table.remove(state.designs, i)
			-- the example stages were free: deleting them gives no money back
			if not d.template then
				state.money = state.money + Util.round(GS.designValue(d) * Config.RESALE)
			end
			if state.draft and state.draft.designs then
				for cls, did in pairs(state.draft.designs) do
					if did == id then
						state.draft.designs[cls] = nil
					end
				end
			end
			return true
		end
	end
	return false, "Design not found."
end

------------------------------------------------------------------ tours
function GS.getTour(state, id)
	for _, t in ipairs(state.tours) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function GS.tourCapacity(tour)
	local c = 0
	for _, s in ipairs(tour.shows) do
		c = c + s.cap
	end
	return c
end

function GS.marketingCost(tour, mk)
	return Util.round(mk.base + mk.perSeat * GS.tourCapacity(tour))
end

-- draft = { artistId, name, designId, firstIn, gap, watchFirst, shows = { {venueId, price} } }
function GS.createTour(state, draft)
	local ad = Artists.byId[draft.artistId or ""]
	if not ad or not state.artists[ad.id].signed then
		return false, "Pick an artist first."
	end
	if GS.activeTour(state, ad.id) then
		return false, ad.name .. " is already on tour."
	end
	if #draft.shows == 0 then
		return false, "Add at least one show (click a country, then + Add)."
	end
	if #draft.shows > Config.MAX_SHOWS_PER_TOUR then
		return false, "Too many shows (max " .. Config.MAX_SHOWS_PER_TOUR .. ")."
	end
	if state.money <= 0 then
		return false, "You are in debt! Earn money before announcing a new tour."
	end
	-- one stage production per venue size (club / theatre / arena / stadium)
	local designs = {}
	for _, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		if not v then
			return false, "Unknown venue."
		end
		if not GS.venueUnlocked(state, v) then
			return false, v.name .. " needs label level " .. GS.venueLevel(v) .. "."
		end
		local vc = GS.venueClass(v)
		local d = GS.getDesign(state, (draft.designs and draft.designs[vc]) or draft.designId or "")
		if not d then
			return false, "Pick a stage design for your " .. vc .. " venues."
		end
		if not Sim.designFits(d, v) then
			return false, "\"" .. d.name .. "\" (" .. d.class .. " stage) is too big for " .. v.name .. "."
		end
		designs[vc] = d.id
	end
	local design = GS.getDesign(state, designs[GS.venueClass(Countries.venueById[draft.shows[1].venueId])])
	local firstIn = Util.clamp(math.floor(draft.firstIn or Config.MIN_LEAD_DAYS), Config.MIN_LEAD_DAYS, Config.MAX_LEAD_DAYS)
	local gap = Util.clamp(math.floor(draft.gap or 2), 1, Config.MAX_GAP_DAYS)
	local name = draft.name
	if type(name) ~= "string" or name:gsub("%s", "") == "" then
		name = ad.name .. " World Tour"
	end

	local tour = {
		id = GS.newId(state, "t"),
		artistId = ad.id,
		name = name:sub(1, 40),
		price = math.max(5, math.floor(draft.price or 30)),
		designId = design.id,
		designs = designs,
		status = "announced",
		announcedDay = state.day,
		marketing = {},
		shows = {},
		gross = 0,
		net = 0,
		attendance = 0,
		sellouts = 0,
		played = 0,
		ratingSum = 0,
	}
	local prev = nil
	local dated = true
	for _, s in ipairs(draft.shows) do
		dated = dated and s.day ~= nil
	end
	if dated then
		table.sort(draft.shows, function(a, b)
			return a.day < b.day
		end)
		for i = 2, #draft.shows do
			if draft.shows[i].day == draft.shows[i - 1].day then
				return false, "Two shows on the same day. Move one of them in the calendar."
			end
		end
	end
	local days = GS.scheduleDays(state.day + firstIn, draft.shows, gap)
	for i, s in ipairs(draft.shows) do
		if s.day then
			days[i] = s.day
			if s.day <= state.day + 2 then
				return false, "A show date is too soon (the first show needs a few days of ticket sales)."
			end
			local busy = GS.venueBusy(state, s.venueId, s.day)
			if busy then
				return false, Countries.venueById[s.venueId].name .. " is not free on that day (" .. busy .. ")."
			end
		end
	end
	for i, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		local look = Countries.VENUE_TYPES[v.type].look
		local prices = (draft.prices and draft.prices[look]) and Util.deepCopy(draft.prices[look]) or Sim.defaultPrices(draft.price or s.price or 30, look)
		table.insert(tour.shows, {
			venueId = v.id,
			countryId = v.countryId,
			cap = v.cap,
			prices = prices,
			price = Sim.avgPrice(look, prices),
			day = days[i],
			sold = 0,
			noise = 1 - Config.DEMAND_NOISE + math.random() * 2 * Config.DEMAND_NOISE,
			travel = Sim.travelCost(prev, v, #(GS.getDesign(state, designs[GS.venueClass(v)]) or design).items),
			done = false,
			-- you are asked to go to the opening night; the other shows run by themselves
			-- (pick them on the laptop: TOURS > WATCH)
			skipLive = (i > 1) or nil,
		})
		prev = v
	end
	tour.price = tour.shows[1].price
	table.insert(state.tours, 1, tour)
	Sim.updateTourSales(state, tour)
	GS.log(state, ad.name .. " announced \"" .. tour.name .. "\" (" .. #tour.shows .. " shows).")
	Social.onAnnounce(state, tour, Sim.ticketBase(state, ad.id))
	return true, tour
end

function GS.buyMarketing(state, tourId, mid)
	local tour = GS.getTour(state, tourId)
	if not tour or tour.status == "done" then
		return false, "Tour not active."
	end
	for _, mk in ipairs(Config.MARKETING) do
		if mk.id == mid then
			if tour.marketing[mid] then
				return false, "Already running."
			end
			local cost = GS.marketingCost(tour, mk)
			if state.money < cost then
				return false, "Not enough money."
			end
			state.money = state.money - cost
			tour.marketing[mid] = true
			Sim.updateTourSales(state, tour)
			return true, mk.name .. " campaign started (" .. Util.money(cost) .. ")."
		end
	end
	return false, "Unknown campaign."
end

function GS.setPrice(state, tourId, idx, price)
	local tour = GS.getTour(state, tourId)
	local s = tour and tour.shows[idx]
	if not s or s.done then
		return
	end
	s.price = Util.clamp(math.floor(price), 5, 2000)
	Sim.updateTourSales(state, tour)
end

-- One ticket price for the whole tour (only unplayed shows change)
function GS.setTourPrice(state, tourId, price)
	local tour = GS.getTour(state, tourId)
	if not tour or tour.status == "done" then
		return
	end
	local old = math.max(1, tour.price or price)
	tour.price = Util.clamp(math.floor(price), 5, 2000)
	local f = tour.price / old
	for _, s in ipairs(tour.shows) do
		if not s.done then
			local v = Countries.venueById[s.venueId]
			if s.prices then
				for id, p in pairs(s.prices) do
					s.prices[id] = Util.clamp(Util.round(p * f), 5, 4000)
				end
				s.price = Sim.avgPrice(Countries.VENUE_TYPES[v.type].look, s.prices)
			else
				s.price = tour.price
			end
		end
	end
	Sim.updateTourSales(state, tour)
end

function GS.cancelTour(state, tourId)
	local tour = GS.getTour(state, tourId)
	if not tour then
		return false, "Tour not found."
	end
	if tour.played > 0 then
		return false, "Shows were already played. You can't cancel anymore."
	end
	for i, t in ipairs(state.tours) do
		if t == tour then
			table.remove(state.tours, i)
			break
		end
	end
	local a = state.artists[tour.artistId]
	a.hype = Util.clamp(a.hype - 8, 0, 100)
	GS.log(state, "Cancelled \"" .. tour.name .. "\". Fans are disappointed (hype -8).")
	Social.add(state, "cancel", { artistId = tour.artistId, tour = tour }, 3)
	return true, "Tour cancelled. Tickets refunded."
end

------------------------------------------------------------------ shows
function GS.prepareShow(state, tour, idx, rnd)
	return Sim.showResult(state, tour, idx, GS.showDesign(state, tour, idx), rnd)
end

-- Applies a show result. Returns { completed = bool, achievements = {ids} }
function GS.applyShow(state, tour, idx, r)
	local s = tour.shows[idx]
	if s.done then
		return { completed = false, achievements = {} }
	end
	local v = Countries.venueById[s.venueId]
	local ad = Artists.byId[tour.artistId]
	local a = state.artists[tour.artistId]
	s.done = true
	s.sold = r.sold
	s.result = {
		sold = r.sold, gross = r.gross, net = r.net, stars = r.stars, rating = Util.round(r.rating), review = r.review,
		rent = r.rent, production = r.production, travel = r.travel, artistCut = r.artistCut, cap = r.cap, fansGained = r.fansGained,
	}

	state.money = state.money + r.net
	tour.gross = tour.gross + r.gross
	tour.net = tour.net + r.net
	tour.attendance = tour.attendance + r.sold
	tour.played = tour.played + 1
	tour.ratingSum = tour.ratingSum + r.rating
	tour.status = "touring"
	if r.soldOut then
		tour.sellouts = tour.sellouts + 1
	end

	-- fans: most of the new fans are local, some spread worldwide
	local gained = r.fansGained
	a.fans[r.region] = (a.fans[r.region] or 0) + math.floor(gained * 0.85)
	for rid, _ in pairs(a.fans) do
		if rid ~= r.region then
			a.fans[rid] = a.fans[rid] + math.floor(gained * 0.03)
		end
	end
	a.hype = Util.clamp(a.hype + r.hypeDelta, 0, 100)
	a.shows = a.shows + 1
	a.gross = a.gross + r.gross

	local st = state.stats
	st.shows = st.shows + 1
	st.tickets = st.tickets + r.sold
	st.totalGross = st.totalGross + r.gross
	if r.soldOut then
		st.sellouts = st.sellouts + 1
		if v.cap > st.biggestSellout then
			st.biggestSellout = v.cap
		end
	end
	if r.stars >= 5 then
		st.fiveStars = st.fiveStars + 1
	end
	if r.gross > st.bestShowGross then
		st.bestShowGross = r.gross
		st.bestShowText = ad.name .. " @ " .. v.name
	end

	Social.onShow(state, tour, idx, r, GS.showDesign(state, tour, idx))
	local completed = tour.played >= #tour.shows
	if completed then
		GS.finishTour(state, tour)
	end
	return { completed = completed, achievements = GS.checkAchievements(state) }
end

-- the last show of a tour is over (or the remaining ones were cancelled)
function GS.finishTour(state, tour)
	local a = state.artists[tour.artistId]
	local st = state.stats
	do
		tour.status = "done"
		tour.endDay = state.day
		local regions, nreg = {}, 0
		for _, sh in ipairs(tour.shows) do
			a.lastPlayed[sh.countryId] = state.day
			local reg = Countries.byId[sh.countryId].region
			if not regions[reg] then
				regions[reg] = true
				nreg = nreg + 1
			end
		end
		if nreg > st.maxRegions then
			st.maxRegions = nreg
		end
		if tour.gross > st.bestTourGross then
			st.bestTourGross = tour.gross
		end
		GS.log(state, "\"" .. tour.name .. "\" finished: " .. Util.money(tour.gross) .. " gross, " .. Util.number(tour.attendance) .. " fans.")
	end
end

-- what cancelling one show costs: the venue is paid anyway, fans who bought tickets are disappointed
function GS.cancelShowCost(state, tour, idx)
	local s = tour.shows[idx]
	local v = Countries.venueById[s.venueId]
	local share = math.min(1, (s.sold or 0) / math.max(1, s.cap))
	return Sim.venueRent(v), math.floor(2 + share * 6 + 0.5)
end

function GS.cancelShow(state, tourId, idx)
	local tour = GS.getTour(state, tourId)
	local s = tour and type(idx) == "number" and tour.shows[idx]
	if not tour or not s or tour.status == "done" then
		return false, "Show not found."
	end
	if s.done then
		return false, "This show was already played."
	end
	if s.day <= state.day then
		return false, "The show is today. Too late to cancel."
	end
	if tour.played == 0 and #tour.shows <= 1 then
		return false, "This is the only show. Cancel the whole tour instead."
	end
	local cost, hype = GS.cancelShowCost(state, tour, idx)
	if state.money < cost and not state.sandbox then
		return false, "Not enough money to pay the venue (" .. Util.money(cost) .. ")."
	end
	local v = Countries.venueById[s.venueId]
	state.money = state.money - cost
	tour.net = tour.net - cost
	tour.cancelledShows = (tour.cancelledShows or 0) + 1
	local a = state.artists[tour.artistId]
	a.hype = Util.clamp(a.hype - hype, 0, 100)
	table.remove(tour.shows, idx)
	GS.log(state, "Cancelled " .. Artists.byId[tour.artistId].name .. " @ " .. v.name .. ": venue paid " .. Util.money(cost) .. ", hype -" .. hype .. ".")
	Social.add(state, "cancelshow", { artistId = tour.artistId, tour = tour, venueId = v.id }, 2)
	if tour.played >= #tour.shows then
		GS.finishTour(state, tour)
	else
		Sim.updateTourSales(state, tour)
	end
	return true, "Show in " .. v.city .. " cancelled. Venue paid (" .. Util.money(cost) .. "), fans are disappointed (hype -" .. hype .. ")."
end

-- Advances one day. Returns events for the UI.
function GS.advanceDay(state, rnd)
	state.day = state.day + 1
	local ev = { soldOut = {}, played = {}, live = {}, completed = {}, achievements = {} }

	for _, a in pairs(state.artists) do
		a.hype = a.hype + (40 - a.hype) * 0.004
	end

	-- iterate over a copy because tours can finish during the loop
	local active = {}
	for _, t in ipairs(state.tours) do
		if t.status ~= "done" then
			table.insert(active, t)
		end
	end
	for _, tour in ipairs(active) do
		for _, idx in ipairs(Sim.updateTourSales(state, tour)) do
			table.insert(ev.soldOut, { tour = tour, idx = idx })
			Social.onSoldOut(state, tour, idx)
		end
		-- a week before a show with weak sales the fans start to talk about it
		for idx, s in ipairs(tour.shows) do
			if not s.done and not s.lowPosted and s.day - state.day <= 7 and s.sold < s.cap * 0.5 then
				s.lowPosted = true
				Social.onLowSales(state, tour, idx)
			end
		end
		for idx, s in ipairs(tour.shows) do
			if not s.done and s.day <= state.day then
				-- every show of today is played live (the player goes there), unless it was set to "auto"
				if s.day == state.day and not s.skipLive then
					table.insert(ev.live, { tourId = tour.id, idx = idx })
				else
					local r = GS.prepareShow(state, tour, idx, rnd)
					local res = GS.applyShow(state, tour, idx, r)
					table.insert(ev.played, { tour = tour, idx = idx, result = r })
					if res.completed then
						table.insert(ev.completed, tour)
					end
					for _, id in ipairs(res.achievements) do
						table.insert(ev.achievements, id)
					end
				end
			end
		end
	end
	for _, id in ipairs(GS.checkAchievements(state)) do
		table.insert(ev.achievements, id)
	end
	Social.daily(state)
	ev.levelUp = GS.checkLevelUp(state)
	return ev
end

------------------------------------------------------------------ charts & goals
function GS.chart(state)
	local rows = {}
	for _, r in ipairs(Rivals) do
		table.insert(rows, { artist = r.artist, tour = r.tour, gross = r.gross, shows = r.shows, attendance = r.attendance, player = false })
	end
	for _, t in ipairs(state.tours) do
		if t.gross > 0 then
			table.insert(rows, {
				artist = Artists.byId[t.artistId].name,
				tour = t.name,
				gross = t.gross,
				shows = t.played,
				attendance = t.attendance,
				player = true,
				tourId = t.id,
				live = t.status ~= "done",
			})
		end
	end
	table.sort(rows, function(x, y)
		return x.gross > y.gross
	end)
	local best = nil
	for i, r in ipairs(rows) do
		r.rank = i
		if r.player and not best then
			best = i
		end
	end
	return rows, best
end

-- Returns the new level name if the label just levelled up
function GS.checkLevelUp(state)
	local lvl, def = GS.level(state)
	if lvl > (state.levelSeen or 1) then
		state.levelSeen = lvl
		if state.visited then
			state.visited.meeting = nil -- new talent wants to meet
		end
		GS.log(state, "Your label is now a " .. def.name .. "! New artists can be signed.")
		return def.name
	end
	return nil
end

function GS.checkAchievements(state)
	local st = state.stats
	local _, bestRank = GS.chart(state)
	local cond = {
		first_show = st.shows >= 1,
		first_sellout = st.sellouts >= 1,
		theatre_sellout = st.biggestSellout >= 2500,
		arena_sellout = st.biggestSellout >= 10000,
		stadium_sellout = st.biggestSellout >= 40000,
		mega_sellout = st.biggestSellout >= 80000,
		five_stars = st.fiveStars >= 1,
		sellouts_10 = st.sellouts >= 10,
		sellouts_50 = st.sellouts >= 50,
		tour_1m = st.bestTourGross >= 1000000,
		tour_10m = st.bestTourGross >= 10000000,
		tour_100m = st.bestTourGross >= 100000000,
		world_tour = st.maxRegions >= 4,
		chart_top10 = bestRank ~= nil and bestRank <= 10,
		chart_1 = bestRank == 1,
		rich = state.money >= 10000000,
		superstar = state.artists.nova ~= nil and state.artists.nova.signed,
	}
	local new = {}
	for _, ach in ipairs(Achievements.list) do
		if cond[ach.id] and not state.achievements[ach.id] then
			state.achievements[ach.id] = state.day
			table.insert(new, ach.id)
			GS.log(state, "Achievement unlocked: " .. ach.name)
		end
	end
	return new
end

return GS
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXDDA41099D54841D2AC94DE51ADCCE8A5"><Properties><string name="Name">Sim</string><ProtectedString name="Source"><![CDATA[-- Simulation formulas: demand, ticket sales, production value, show results.
-- Pure Lua (no Roblox APIs) so it can be unit tested outside of Roblox.
local Root = script:FindFirstAncestor("Headliner")
local Config = require(Root.Config)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local StageItems = require(Root.Data.StageItems)
local Reviews = require(Root.Data.Reviews)
local Util = require(Root.Logic.Util)

local Sim = {}

------------------------------------------------------------------ production
-- How many production points a venue of this size "expects"
function Sim.expectedProduction(cap)
	return 6 * math.sqrt(cap / 100)
end

-- Resizable items cost (and impress) more when they are bigger
function Sim.itemScale(def, rec)
	if not def.size or not rec then
		return 1
	end
	local sw = (rec.w or def.size.w) / def.size.w
	if def.shape == "round" then
		return sw * sw
	end
	local sd = def.size.d and ((rec.d or def.size.d) / def.size.d) or 1
	return sw * sd
end

local function ledMult(rec, m)
	return (rec and rec.skin == "led") and m or 1
end

function Sim.itemPrice(def, rec)
	return Util.round(def.cost * Config.ITEM_PRICE_MULT * Sim.itemScale(def, rec) * ledMult(rec, 1.8))
end

function Sim.itemPts(def, rec)
	return def.pts * Sim.itemScale(def, rec) ^ 0.75 * ledMult(rec, 2)
end

-- Can this design be used in that venue? (stage class must not be bigger than the venue's)
function Sim.designFits(design, venue)
	local dc = Config.STAGE_CLASS_BY_ID[(design and design.class) or "Club"]
	local vc = Config.STAGE_CLASS_BY_ID[Countries.VENUE_TYPES[venue.type].stage]
	return dc.order <= vc.order
end

function Sim.designStats(design, genre)
	local st = { cost = 0, value = 0, raw = 0, eff = 0, count = 0, categories = 0 }
	if not design then
		return st
	end
	local tagMap = (genre and StageItems.GENRE_TAGS[genre]) or {}
	local cats = {}
	for _, it in ipairs(design.items) do
		local def = StageItems.byId[it.t]
		if def then
			st.count = st.count + 1
			local pts = Sim.itemPts(def, it)
			st.value = st.value + Sim.itemPrice(def, it)
			st.raw = st.raw + pts
			local mult = 1
			for _, tag in ipairs(def.tags) do
				local m = tagMap[tag]
				if m then
					mult = mult * m
				end
			end
			mult = Util.clamp(mult, 0.6, 1.7)
			st.eff = st.eff + pts * mult
			if not cats[def.cat] then
				cats[def.cat] = true
				st.categories = st.categories + 1
			end
		end
	end
	st.cost = Util.round(st.value * Config.PRODUCTION_RATE) -- running cost per show
	if st.categories >= 5 then
		st.eff = st.eff * 1.15
	elseif st.categories >= 4 then
		st.eff = st.eff * 1.1
	end
	return st
end

-- 0..100. Extra production beyond 1.7x of what the venue expects adds nothing (size limits: see Sim.designFits).
function Sim.productionScore(design, genre, cap)
	local st = Sim.designStats(design, genre)
	local expected = Sim.expectedProduction(cap)
	local maxFit = expected * 1.7
	local used = math.min(st.eff, maxFit)
	local ratio = used / expected
	local score = 100 * (1 - math.exp(-1.6 * ratio)) / (1 - math.exp(-1.6 * 1.7))
	return Util.clamp(score, 0, 100), st, expected, maxFit
end

------------------------------------------------------------------ seat sections (like a ticket shop seat map)
-- per venue look: share of the capacity, price factor against the base ticket price, standing or seated
Sim.SECTIONS = {
	club = {
		{ id = "ga", name = "Standing", share = 1, mult = 1, standing = true },
	},
	theatre = {
		{ id = "stalls", name = "Stalls (standing)", share = 0.5, mult = 1, standing = true },
		{ id = "circle", name = "Dress Circle", share = 0.3, mult = 1.15 },
		{ id = "upper", name = "Upper Circle", share = 0.2, mult = 0.75 },
	},
	arena = {
		{ id = "golden", name = "Golden Circle", share = 0.08, mult = 1.8, standing = true },
		{ id = "floor", name = "Floor (standing)", share = 0.27, mult = 1, standing = true },
		{ id = "lower", name = "Lower Tier", share = 0.4, mult = 1.15 },
		{ id = "upper", name = "Upper Tier", share = 0.25, mult = 0.75 },
	},
	amphi = {
		{ id = "pit", name = "Pit (standing)", share = 0.3, mult = 1.1, standing = true },
		{ id = "bowl", name = "Seated Bowl", share = 0.45, mult = 1 },
		{ id = "lawn", name = "Lawn", share = 0.25, mult = 0.65, standing = true },
	},
	stadium = {
		{ id = "golden", name = "Golden Circle", share = 0.07, mult = 1.9, standing = true },
		{ id = "field", name = "Field (standing)", share = 0.28, mult = 1, standing = true },
		{ id = "lower", name = "Lower Tier", share = 0.35, mult = 1.1 },
		{ id = "upper", name = "Upper Tier", share = 0.3, mult = 0.7 },
	},
}
function Sim.lookOf(venue)
	return Countries.VENUE_TYPES[venue.type].look
end
function Sim.sections(venue)
	return Sim.SECTIONS[Sim.lookOf(venue)] or Sim.SECTIONS.arena
end
-- default prices of the sections of a look for a base price
function Sim.defaultPrices(base, look)
	local out = {}
	for _, sec in ipairs(Sim.SECTIONS[look] or Sim.SECTIONS.arena) do
		out[sec.id] = math.max(5, Util.round(base * sec.mult))
	end
	return out
end
-- average ticket price (weighted by the size of the sections)
function Sim.avgPrice(look, prices)
	local sum, w = 0, 0
	for _, sec in ipairs(Sim.SECTIONS[look] or Sim.SECTIONS.arena) do
		sum = sum + (prices[sec.id] or 0) * sec.share
		w = w + sec.share
	end
	return math.max(5, Util.round(sum / math.max(0.01, w)))
end
-- Splits ticket buyers over the sections: a section that is cheap for what it offers sells faster,
-- an expensive one slower; fans who find a sold-out section partly move on to the others.
-- returns soldBy = { [id] = n }, total sold, gross
function Sim.splitSections(look, cap, prices, demand)
	local secs = Sim.SECTIONS[look] or Sim.SECTIONS.arena
	local avg = Sim.avgPrice(look, prices)
	local want, room, weight, sumW = {}, {}, {}, 0
	for _, sec in ipairs(secs) do
		local p = math.max(1, prices[sec.id] or avg * sec.mult)
		weight[sec.id] = sec.share * Util.clamp((sec.mult * avg / p) ^ 1.6, 0.05, 4)
		sumW = sumW + weight[sec.id]
	end
	local spill = 0
	for _, sec in ipairs(secs) do
		local c = math.floor(cap * sec.share)
		want[sec.id] = demand * weight[sec.id] / math.max(1e-6, sumW)
		room[sec.id] = c
		if want[sec.id] > c then
			spill = spill + (want[sec.id] - c) * 0.6
			want[sec.id] = c
		end
	end
	for _ = 1, 3 do
		if spill < 1 then
			break
		end
		local open = 0
		for _, sec in ipairs(secs) do
			if want[sec.id] < room[sec.id] then
				open = open + weight[sec.id]
			end
		end
		if open <= 0 then
			break
		end
		local s2 = spill
		spill = 0
		for _, sec in ipairs(secs) do
			if want[sec.id] < room[sec.id] then
				local add = s2 * weight[sec.id] / open
				want[sec.id] = want[sec.id] + add
				if want[sec.id] > room[sec.id] then
					spill = spill + (want[sec.id] - room[sec.id])
					want[sec.id] = room[sec.id]
				end
			end
		end
	end
	local soldBy, total, gross = {}, 0, 0
	for _, sec in ipairs(secs) do
		local n = math.floor(want[sec.id])
		soldBy[sec.id] = n
		total = total + n
		gross = gross + n * (prices[sec.id] or avg)
	end
	return soldBy, total, gross
end
-- prices of a show (old saves only have one price)
function Sim.showPrices(s, venue)
	if s.prices then
		return s.prices
	end
	local out = {}
	for _, sec in ipairs(Sim.sections(venue)) do
		out[sec.id] = s.price
	end
	return out
end

------------------------------------------------------------------ prices & demand
function Sim.ticketBase(state, artistId)
	local a = state.artists[artistId]
	local ad = Artists.byId[artistId]
	local total = Util.totalFans(a.fans)
	return (15 + 22 * math.log10(1 + total / 40000)) * ad.pricePower
end

function Sim.fairPrice(state, artistId, countryId)
	local c = Countries.byId[countryId]
	return math.max(5, Util.round(Sim.ticketBase(state, artistId) * c.priceLevel))
end

-- Number of people in a country who want to see this artist on one tour (at a fair price)
function Sim.countryPool(state, artistId, countryId)
	local a = state.artists[artistId]
	local ad = Artists.byId[artistId]
	local c = Countries.byId[countryId]
	local fans = a.fans[c.region] or 0
	local hypeMult = 0.6 + (a.hype / 100) * 0.8
	local genreMult = c.genres[ad.genre] or 1
	local fatigue = 1
	local last = a.lastPlayed[countryId]
	if last then
		fatigue = 0.45 + 0.55 * Util.clamp((state.day - last) / 180, 0, 1)
	end
	return fans * c.share * Config.ATTEND_RATE * hypeMult * genreMult * fatigue
end

function Sim.priceMult(fair, price)
	return Util.clamp((fair / math.max(1, price)) ^ 1.6, 0.05, 3)
end

-- shows: array of { venueId=, price=, noise=? }. Returns an array of demand (tickets wanted) per show.
-- Fans of a country are spread evenly over that country's shows ("water filling"): if a small venue
-- sells out, the fans who could not get a ticket move on to the other shows in the same country.
function Sim.demands(state, artistId, shows, mult)
	local byCountry, order = {}, {}
	for i, s in ipairs(shows) do
		local cid = Countries.venueById[s.venueId].countryId
		if not byCountry[cid] then
			byCountry[cid] = {}
			table.insert(order, cid)
		end
		table.insert(byCountry[cid], i)
	end
	local out = {}
	for _, cid in ipairs(order) do
		local idxs = byCountry[cid]
		local pool = Sim.countryPool(state, artistId, cid) * (mult or 1)
		local fair = Sim.fairPrice(state, artistId, cid)
		local pm, need, alloc, full = {}, {}, {}, {}
		for _, i in ipairs(idxs) do
			local s = shows[i]
			pm[i] = Sim.priceMult(fair, s.price) * (s.noise or 1)
			need[i] = Countries.venueById[s.venueId].cap / pm[i] -- fans needed to sell out
			alloc[i] = 0
		end
		local remaining, open = pool, idxs
		for _ = 1, #idxs do
			if remaining <= 0 or #open == 0 then
				break
			end
			local per = remaining / #open
			remaining = 0
			local nextOpen = {}
			for _, i in ipairs(open) do
				local left = need[i] - alloc[i]
				if per >= left then
					alloc[i] = need[i]
					full[i] = true
					remaining = remaining + (per - left)
				else
					alloc[i] = alloc[i] + per
					table.insert(nextOpen, i)
				end
			end
			open = nextOpen
		end
		local even = pool / #idxs
		for _, i in ipairs(idxs) do
			local d = alloc[i] * pm[i]
			if full[i] then
				d = math.max(d, even * pm[i]) -- keeps "how hot" a sold-out show is (sells out earlier)
			end
			out[i] = d
		end
	end
	return out
end

function Sim.marketingMult(tour)
	local m = 1
	for _, mk in ipairs(Config.MARKETING) do
		if tour.marketing and tour.marketing[mk.id] then
			m = m * (1 + mk.boost)
		end
	end
	return m
end

-- Share of the final demand that has bought a ticket after `elapsed` of `total` pre-sale days
function Sim.salesFraction(elapsed, total)
	if total <= 0 then
		return 1
	end
	local tau = Util.clamp(elapsed / total, 0, 1)
	return 0.4 + 0.6 * tau ^ 0.8
end

-- Updates sold tickets of all unplayed shows. Returns list of show indexes that just sold out.
function Sim.updateTourSales(state, tour)
	local newlySoldOut = {}
	local d = Sim.demands(state, tour.artistId, tour.shows, Sim.marketingMult(tour))
	for i, s in ipairs(tour.shows) do
		if not s.done then
			s.demand = d[i]
			local total = s.day - tour.announcedDay
			local elapsed = state.day - tour.announcedDay
			local v = Countries.venueById[s.venueId]
			local soldBy, target = Sim.splitSections(Sim.lookOf(v), s.cap, Sim.showPrices(s, v), d[i] * Sim.salesFraction(elapsed, total))
			s.secSold = s.secSold or {}
			local sum = 0
			for id, n in pairs(soldBy) do
				s.secSold[id] = math.max(s.secSold[id] or 0, n)
				sum = sum + s.secSold[id]
			end
			target = math.max(target, sum)
			if target > s.sold then
				s.sold = target
			end
			if s.sold >= s.cap and not s.soldOutDay then
				s.soldOutDay = state.day
				table.insert(newlySoldOut, i)
			end
		end
	end
	return newlySoldOut
end

-- Promoter advice: what venue size fits this artist in a country (ticket buyers at a fair price)
function Sim.recommendation(state, artistId, countryId)
	local pool = Sim.countryPool(state, artistId, countryId)
	local label
	if pool < 600 then
		label = "small clubs (under 600)"
	elseif pool < 2500 then
		label = "clubs or a small theatre (up to ~2,500)"
	elseif pool < 8000 then
		label = "theatres and halls (2,500 - 8,000)"
	elseif pool < 30000 then
		label = "an arena (10,000 - 25,000)"
	elseif pool < 90000 then
		label = "arenas, maybe several nights"
	else
		label = "stadiums"
	end
	return label, pool
end

------------------------------------------------------------------ costs
function Sim.venueRent(venue)
	local vt = Countries.VENUE_TYPES[venue.type]
	local c = Countries.byId[venue.countryId]
	return Util.round(500 + venue.cap * vt.rentPerSeat * c.priceLevel)
end

function Sim.travelCost(prevVenue, venue, itemCount)
	if prevVenue and prevVenue.id == venue.id then
		return 0 -- another night in the same venue: the stage stays up
	end
	local km = 0
	if prevVenue then
		if prevVenue.countryId == venue.countryId then
			km = 300
		else
			local a = Countries.byId[prevVenue.countryId]
			local b = Countries.byId[venue.countryId]
			km = Util.distanceKm(a.lat, a.lon, b.lat, b.lon)
		end
	end
	return Util.round((1000 + km * 1.2) * (1 + (itemCount or 0) / 40))
end

------------------------------------------------------------------ planner estimate
-- draft = { artistId=, designId=, shows = { {venueId=, price=}, ... } }
function Sim.estimate(state, draft, design)
	local res = { rows = {}, tickets = 0, capacity = 0, gross = 0, costs = 0, net = 0 }
	if not draft.artistId or #draft.shows == 0 then
		return res
	end
	-- design can be one design or a function(venue) -> design (one production per venue size)
	local function stFor(v)
		local dd = design
		if type(design) == "function" then
			dd = design(v)
		end
		return Sim.designStats(dd, nil)
	end
	local d = Sim.demands(state, draft.artistId, draft.shows, 1)
	local prev = nil
	for i, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		local prices = Sim.showPrices(s, v)
		local _, sold, gross = Sim.splitSections(Sim.lookOf(v), v.cap, prices, d[i])
		local rent = Sim.venueRent(v)
		local st = stFor(v)
		local travel = Sim.travelCost(prev, v, st.count)
		local cut = Util.round(gross * Config.ARTIST_SHARE)
		local costs = rent + st.cost + travel + cut
		local n = Config.DEMAND_NOISE
		local low = math.min(1, d[i] * (1 - n) / v.cap)
		local high = math.min(1, d[i] * (1 + n) / v.cap)
		local _, soldLo, grossLo = Sim.splitSections(Sim.lookOf(v), v.cap, prices, d[i] * (1 - n))
		local _, soldHi, grossHi = Sim.splitSections(Sim.lookOf(v), v.cap, prices, d[i] * (1 + n))
		low, high = soldLo / v.cap, soldHi / v.cap
		res.rows[i] = { demand = d[i], sold = sold, fill = sold / v.cap, fillLow = low, fillHigh = high, gross = gross, costs = costs, net = gross - costs }
		res.grossLow = (res.grossLow or 0) + grossLo
		res.grossHigh = (res.grossHigh or 0) + grossHi
		res.tickets = res.tickets + sold
		res.capacity = res.capacity + v.cap
		res.gross = res.gross + gross
		res.costs = res.costs + costs
		prev = v
	end
	res.net = res.gross - res.costs
	res.netLow = (res.grossLow or 0) - res.costs + Util.round((res.gross - (res.grossLow or 0)) * Config.ARTIST_SHARE)
	res.netHigh = (res.grossHigh or 0) - res.costs - Util.round(((res.grossHigh or 0) - res.gross) * Config.ARTIST_SHARE)
	return res
end

------------------------------------------------------------------ show result
function Sim.showResult(state, tour, idx, design, rnd)
	rnd = rnd or math.random
	local s = tour.shows[idx]
	local v = Countries.venueById[s.venueId]
	local c = Countries.byId[v.countryId]
	local ad = Artists.byId[tour.artistId]

	local sold = math.min(s.sold, v.cap)
	local prices = Sim.showPrices(s, v)
	local gross = 0
	if s.secSold then
		local n = 0
		for id, k in pairs(s.secSold) do
			gross = gross + k * (prices[id] or s.price)
			n = n + k
		end
		gross = gross + math.max(0, sold - n) * s.price
	else
		gross = sold * s.price
	end
	local rent = Sim.venueRent(v)
	local prodScore, st = Sim.productionScore(design, ad.genre, v.cap)
	local travel = s.travel or 0
	local cut = Util.round(gross * Config.ARTIST_SHARE)
	local net = gross - rent - st.cost - travel - cut
	local fill = sold / v.cap

	local rating = 0.45 * ad.skill + 0.45 * prodScore + 10 * fill - 5 + (rnd() * 8 - 4)
	rating = Util.clamp(rating, 1, 100)
	local stars = 1
	if rating >= 88 then
		stars = 5
	elseif rating >= 75 then
		stars = 4
	elseif rating >= 60 then
		stars = 3
	elseif rating >= 45 then
		stars = 2
	end

	local list = Reviews[stars]
	local review = list[math.floor(rnd() * #list) + 1] or list[1]
	review = review:gsub("{artist}", ad.name):gsub("{venue}", v.name):gsub("{city}", v.city)

	local soldOut = sold >= v.cap
	-- word of mouth: good reviews spread to fans who were not there (diminishing for huge artists)
	local regionFans = state.artists[tour.artistId].fans[c.region] or 0
	local buzz = regionFans * 0.012 * math.max(0, stars - 2) / (1 + regionFans / 2000000)
	return {
		sold = sold,
		cap = v.cap,
		fill = fill,
		price = s.price,
		secSold = s.secSold,
		gross = gross,
		rent = rent,
		production = st.cost,
		travel = travel,
		artistCut = cut,
		net = net,
		rating = rating,
		stars = stars,
		prodScore = prodScore,
		fansGained = math.floor(sold * (0.5 + 3 * (rating / 100) ^ 2) + buzz),
		hypeDelta = (rating - 60) / 12 + (soldOut and 1 or -0.5),
		review = review,
		soldOut = soldOut,
		region = c.region,
	}
end

return Sim
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6173F36E713141D7A9420E771CFB851B"><Properties><string name="Name">Social</string><ProtectedString name="Source"><![CDATA[-- Generates fan posts for the SOCIAL feed. Pure Lua (no Roblox APIs).
local Root = script:FindFirstAncestor("Headliner")
local Data = require(Root.Data.Social)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local Util = require(Root.Logic.Util)

local Social = {}
Social.MAX = 200

local function pick(list, rnd)
	return list[math.floor(rnd() * #list) + 1]
end

local function hashtag(ad)
	return "#" .. ad.name:gsub("[^%w]", "") .. "Live"
end

local function fill(text, c)
	return (text:gsub("{(%w+)}", function(k)
		local v = c[k]
		return v ~= nil and tostring(v) or ""
	end))
end

-- adds `n` posts of a kind. c = { artistId, venueId?, tour?, song?, price?, item? }
function Social.add(state, kind, c, n, rnd)
	rnd = rnd or math.random
	state.social = state.social or {}
	local list = Data.POSTS[kind]
	if not list then
		return
	end
	local ad = Artists.byId[c.artistId or ""]
	local v = c.venueId and Countries.venueById[c.venueId]
	local ctx = {
		artist = ad and ad.name or "",
		venue = v and v.name or "",
		city = v and v.city or "",
		country = c.country or (v and Countries.byId[v.countryId].name) or "",
		tour = c.tour and c.tour.name or "",
		song = c.song or (ad and pick(ad.setlist, rnd)) or "",
		price = c.price and Util.money(c.price) or "",
		tag = ad and hashtag(ad) or "",
		item = c.item or "",
		label = state.labelName or "",
	}
	local used = {}
	for _ = 1, n or 1 do
		local tpl = pick(list, rnd)
		local tries = 0
		while used[tpl] and tries < 5 do
			tpl = pick(list, rnd)
			tries = tries + 1
		end
		used[tpl] = true
		local first = pick(Data.FIRST, rnd)
		local handle = "@" .. pick(Data.HANDLE_A, rnd) .. "." .. pick(Data.HANDLE_B, rnd)
		local likes = math.floor((20 + rnd() * 400) * (tpl[1] > 0 and 2.5 or 1) * (1 + (c.reach or 0)))
		-- a photo with the post?
		local ph = Data.PHOTOS[kind]
		local pkind = nil
		if ph and rnd() < ph[1] then
			pkind = ph[2][math.floor(rnd() * #ph[2]) + 1]
		end
		table.insert(state.social, 1, {
			day = state.day,
			name = first,
			handle = handle,
			text = fill(tpl[2], ctx),
			mood = tpl[1],
			kind = kind,
			likes = likes,
			reposts = math.floor(likes * (0.05 + rnd() * 0.2)),
			artistId = c.artistId,
			photo = pkind ~= nil,
			pkind = pkind,
			look = v and Countries.VENUE_TYPES[v.type] and Countries.VENUE_TYPES[v.type].look or nil,
			venue = v and v.name or nil,
			seed = math.floor(rnd() * 100000),
			avatar = math.floor(rnd() * 8) + 1,
		})
	end
	while #state.social > Social.MAX do
		table.remove(state.social)
	end
end

-- reach: bigger artists get more likes
local function reach(state, artistId)
	local a = state.artists[artistId]
	return a and math.log10(1 + Util.totalFans(a.fans) / 100000) or 0
end

function Social.onAnnounce(state, tour, fairPrice, rnd)
	rnd = rnd or math.random
	local s1 = tour.shows[1]
	local c = { artistId = tour.artistId, venueId = s1 and s1.venueId, tour = tour, price = tour.price, reach = reach(state, tour.artistId) }
	Social.add(state, "announce", c, 3, rnd)
	if fairPrice and tour.price > fairPrice * 1.3 then
		Social.add(state, "price_high", c, 2, rnd)
	elseif fairPrice and tour.price < fairPrice * 0.85 then
		Social.add(state, "price_low", c, 1, rnd)
	end
end

function Social.onSoldOut(state, tour, idx, rnd)
	local s = tour.shows[idx]
	Social.add(state, "soldout", { artistId = tour.artistId, venueId = s.venueId, tour = tour, reach = reach(state, tour.artistId) }, 2, rnd)
end

function Social.onLowSales(state, tour, idx, rnd)
	local s = tour.shows[idx]
	Social.add(state, "lowsales", { artistId = tour.artistId, venueId = s.venueId, tour = tour }, 2, rnd)
end

-- after a show: reviews, photos and comments about songs, outfits and the stage
function Social.onShow(state, tour, idx, r, design, rnd)
	rnd = rnd or math.random
	local s = tour.shows[idx]
	local c = { artistId = tour.artistId, venueId = s.venueId, tour = tour, price = s.price, reach = reach(state, tour.artistId) }
	local kind = (r.stars >= 4) and "show_great" or ((r.stars == 3) and "show_ok" or "show_bad")
	Social.add(state, kind, c, (r.stars >= 4) and 3 or 2, rnd)
	if r.stars >= 3 then
		Social.add(state, "photo", c, 1 + math.floor(rnd() * 2), rnd)
		Social.add(state, (rnd() < 0.5) and "outfit" or "setlist", c, 1, rnd)
	end
	-- a post about a special stage item
	if design and r.stars >= 3 then
		local found = {}
		for _, it in ipairs(design.items or {}) do
			local nm = Data.ITEM_NAMES[it.t]
			if nm and not found[nm] then
				found[nm] = true
				table.insert(found, nm)
			end
		end
		if #found > 0 then
			c.item = found[math.floor(rnd() * #found) + 1]
			Social.add(state, "stage", c, 1, rnd)
		end
	end
	if r.fill < 0.6 then
		Social.add(state, "lowsales", c, 1, rnd)
	end
end

-- small chance every day: fan projects, merch, countdowns for upcoming shows
function Social.daily(state, rnd)
	rnd = rnd or math.random
	for _, tour in ipairs(state.tours) do
		if tour.status ~= "done" and rnd() < 0.25 then
			for _, s in ipairs(tour.shows) do
				if not s.done then
					local kinds = { "fanproject", "merch", "countdown" }
					Social.add(state, kinds[math.floor(rnd() * #kinds) + 1], { artistId = tour.artistId, venueId = s.venueId, tour = tour }, 1, rnd)
					break
				end
			end
		end
	end
end

-- -100..100: how fans feel about an artist (last 25 posts)
function Social.mood(state, artistId)
	local sum, n = 0, 0
	for _, p in ipairs(state.social or {}) do
		if p.artistId == artistId then
			sum = sum + p.mood
			n = n + 1
			if n >= 25 then
				break
			end
		end
	end
	if n == 0 then
		return 0, 0
	end
	return math.floor(sum / n * 100 + 0.5), n
end

-- trending hashtags: { {tag, count} } sorted
function Social.trending(state)
	local counts = {}
	for _, p in ipairs(state.social or {}) do
		for tag in p.text:gmatch("#%w+") do
			counts[tag] = (counts[tag] or 0) + p.likes
		end
	end
	local out = {}
	for tag, n in pairs(counts) do
		table.insert(out, { tag, n })
	end
	table.sort(out, function(a, b)
		return a[2] > b[2]
	end)
	return out
end

return Social
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX05833E8E8DFC4626B0548D889D8E34A6"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Small helpers (pure Lua, no Roblox APIs)
local Util = {}

function Util.clamp(x, a, b)
	if x < a then
		return a
	end
	if x > b then
		return b
	end
	return x
end

function Util.round(x)
	return math.floor(x + 0.5)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

local function commas(n)
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function Util.number(n)
	local s = commas(n)
	if n < 0 then
		return "-" .. s
	end
	return s
end

function Util.money(n)
	if n < 0 then
		return "-$" .. commas(n)
	end
	return "$" .. commas(n)
end

local function short(n)
	local a = math.abs(n)
	if a >= 1e9 then
		return string.format("%.2fB", a / 1e9)
	elseif a >= 1e6 then
		return string.format("%.1fM", a / 1e6)
	elseif a >= 1e4 then
		return string.format("%.0fK", a / 1e3)
	elseif a >= 1e3 then
		return string.format("%.1fK", a / 1e3)
	end
	return tostring(math.floor(a + 0.5))
end

function Util.short(n)
	if n < 0 then
		return "-" .. short(n)
	end
	return short(n)
end

function Util.moneyShort(n)
	if n < 0 then
		return "-$" .. short(n)
	end
	return "$" .. short(n)
end

function Util.percent(f)
	return tostring(math.floor(f * 100 + 0.5)) .. "%"
end

local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }
local MDAYS = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }

local function isLeap(y)
	return (y % 4 == 0 and y % 100 ~= 0) or (y % 400 == 0)
end

-- day 0 = Jan 1 of startYear
-- year, month (1-12), day of month (1-31) of a game day; weekday 1 = Monday (day 0 = Fri, Jan 1 2027)
function Util.ymd(day, startYear)
	local y = startYear or 2027
	local d = math.floor(day)
	while d >= (isLeap(y) and 366 or 365) do
		d = d - (isLeap(y) and 366 or 365)
		y = y + 1
	end
	local m = 1
	while true do
		local ml = (m == 2 and isLeap(y)) and 29 or MDAYS[m]
		if d < ml then
			break
		end
		d = d - ml
		m = m + 1
	end
	return y, m, d + 1, (math.floor(day) + 4) % 7 + 1
end
function Util.monthLength(y, m)
	return (m == 2 and isLeap(y)) and 29 or MDAYS[m]
end
function Util.monthName(m)
	return MONTHS[m]
end
-- game day of a date
function Util.dayOf(y, m, dd, startYear)
	local day = 0
	for yy = startYear or 2027, y - 1 do
		day = day + (isLeap(yy) and 366 or 365)
	end
	for mm = 1, m - 1 do
		day = day + Util.monthLength(y, mm)
	end
	return day + dd - 1
end

function Util.date(day, startYear)
	local y = startYear or 2027
	local d = math.floor(day)
	while true do
		local len = isLeap(y) and 366 or 365
		if d < len then
			break
		end
		d = d - len
		y = y + 1
	end
	local m = 1
	while true do
		local ml = MDAYS[m]
		if m == 2 and isLeap(y) then
			ml = 29
		end
		if d < ml then
			break
		end
		d = d - ml
		m = m + 1
	end
	return MONTHS[m] .. " " .. tostring(d + 1) .. ", " .. tostring(y), MONTHS[m] .. " " .. tostring(d + 1)
end

function Util.distanceKm(lat1, lon1, lat2, lon2)
	local r = math.pi / 180
	local dLat = (lat2 - lat1) * r
	local dLon = (lon2 - lon1) * r
	local a = math.sin(dLat / 2) ^ 2 + math.cos(lat1 * r) * math.cos(lat2 * r) * math.sin(dLon / 2) ^ 2
	return 6371 * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))
end

function Util.deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = Util.deepCopy(v)
	end
	return c
end

-- Copies `src` into `dst` in place, so tables other code holds on to stay the same tables.
-- Lists of tables with an id (or uid) are matched by that id, other lists by position.
local function syncKey(v)
	return type(v) == "table" and (v.id or v.uid) or nil
end
function Util.syncInto(dst, src)
	if #src > 0 then
		local byKey = {}
		for _, v in ipairs(dst) do
			local k = syncKey(v)
			if k ~= nil then
				byKey[k] = v
			end
		end
		local out = {}
		for i, v in ipairs(src) do
			local k = syncKey(v)
			local old
			if k ~= nil then
				old = byKey[k]
				byKey[k] = nil
			elseif type(dst[i]) == "table" and syncKey(dst[i]) == nil then
				old = dst[i]
			end
			if type(v) == "table" and type(old) == "table" then
				Util.syncInto(old, v)
				out[i] = old
			else
				out[i] = v
			end
		end
		for k in pairs(dst) do
			dst[k] = nil
		end
		for i, v in ipairs(out) do
			dst[i] = v
		end
		return dst
	end
	for k in pairs(dst) do
		if src[k] == nil then
			dst[k] = nil
		end
	end
	for k, v in pairs(src) do
		if type(v) == "table" and type(dst[k]) == "table" then
			Util.syncInto(dst[k], v)
		else
			dst[k] = v
		end
	end
	return dst
end

function Util.stars(n)
	-- plain text (Roblox fonts have no star symbols)
	return tostring(n) .. "/5 stars"
end

function Util.totalFans(fans)
	local t = 0
	for _, v in pairs(fans) do
		t = t + v
	end
	return t
end

function Util.tier(totalFans)
	if totalFans < 300000 then
		return "Rising Act"
	elseif totalFans < 1500000 then
		return "Breakthrough"
	elseif totalFans < 5000000 then
		return "Arena Act"
	elseif totalFans < 15000000 then
		return "Stadium Act"
	end
	return "Global Superstar"
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX3144AB45A4A94945BE6DF5FD17466D15"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX5AE28497275A439FB1D93DAD196396DE"><Properties><string name="Name">Hub</string><ProtectedString name="Source"><![CDATA[-- The label building "Starlight Records" and its little street: the walkable hub.
-- Built once by the server (so seats and prompts work); the client adds name tags, posters, people,
-- the table map and the charts screen (Client/World.lua).
-- Style: bright and friendly (daylight, light wood, white walls, painted colour accents, no neon strips).
-- Rule against z-fighting: parts never share a face plane with another part of a different colour;
-- decorations sit at least 0.04 studs in front of the surface they hang on.
-- 1 stud ~ 0.3 m. Floor top = y 0. The street is on the +Z side.
local Hub = {}

Hub.ORIGIN = Vector3.new(4000, 0, 0)
local O = Hub.ORIGIN

Hub.SPAWN = Vector3.new(0, 0, -16)
-- where Sam (the guide of the tutorial) waits: free floor spots near the stations (checked by scenario_hub)
Hub.GUIDE_SPOTS = {
	start = Vector3.new(-8, 0, -10),
	meeting = Vector3.new(-54, 0, -8),
	laptop = Vector3.new(6, 0, -28),
	stagehall = Vector3.new(32, 0, 10),
}
Hub.STATIONS = {
	laptop = { pos = Vector3.new(14, 3.6, -37), name = "LAPTOP", sub = "Overview & tours", action = "Open laptop" },
	maptable = { pos = Vector3.new(0, 3.4, 6), name = "WORLD MAP", sub = "Plan a tour", action = "Plan a tour" },
	meeting = { pos = Vector3.new(-63, 3.4, -24), name = "MEETING ROOM", sub = "Artists & talent", action = "Start meeting" },
	stagehall = { pos = Vector3.new(58, 3.6, -24), name = "STAGE HALL", sub = "Build stages", action = "Build stages" },
	charts = { pos = Vector3.new(-20, 9, -45.4), name = "CHARTS", sub = "Top grossing tours", action = "View charts" },
}

-- people (the client builds and animates them): staff at their desks, walkers, people at the cafe
Hub.STAFF = {
	{ pos = Vector3.new(24, 0, -14.2), yaw = math.pi, desk = Vector3.new(24, 0, -18), seatY = 2.3 },
	{ pos = Vector3.new(32, 0, -14.2), yaw = math.pi, desk = Vector3.new(32, 0, -18), seatY = 2.3 },
	{ pos = Vector3.new(24, 0, -2.2), yaw = math.pi, desk = Vector3.new(24, 0, -6), seatY = 2.3 },
	{ pos = Vector3.new(32, 0, -2.2), yaw = math.pi, desk = Vector3.new(32, 0, -6), seatY = 2.3 },
	{ pos = Vector3.new(-22, 0, 25.2), yaw = 0, seatY = 2.3 }, -- reception
}
-- office staff leave their desk now and then: the aisle behind the chair, then to the coffee bar
function Hub.staffRoute(st, i)
	local aisle = st.pos.Z + 3.4
	local cx = 25 + (i % 4) * 2.6
	return {
		Vector3.new(st.pos.X, 0, aisle),
		Vector3.new(18.9, 0, aisle),
		Vector3.new(18.9, 0, 22),
		Vector3.new(cx, 0, 22),
		Vector3.new(cx, 0, 26.6),
	}
end
-- stage hall: workers carry boxes from the racks to the rehearsal stage, a forklift drives along the racks
Hub.HALL_WALKS = {
	{ Vector3.new(110, 0, 8), Vector3.new(92, 0, 8), Vector3.new(92, 0, -15) },
	{ Vector3.new(110, 0, 22), Vector3.new(80, 0, 22), Vector3.new(80, 0, -15) },
	{ Vector3.new(52, 0, 30), Vector3.new(52, 0, 6), Vector3.new(66, 0, -8) },
}
-- its own lane in front of the front rack (nobody else walks there)
Hub.FORKLIFT_PATH = { Vector3.new(68, 0, 37.4), Vector3.new(96, 0, 37.4) }
-- the street: straight from XW to XE, bends away around the corners CW / CE (radius 20 inner sidewalk .. 76)
Hub.STREET = { xw = -130, xe = 170, cw = Vector3.new(-130, 0, 124), ce = Vector3.new(170, 0, 124), laneEast = 80, laneWest = 74.5 }
-- walking paths stay in the free lanes of the sidewalks (trees, lamps, benches and tables are elsewhere)
-- indoor walks (with a pause at each end); the street people walk from door to door (Hub.DOORS)
Hub.LANES = { front = { 52.4, 55.2 }, far = { 96, 98.2 } }
Hub.WALKS = {
	{ Vector3.new(-6, 0, 22), Vector3.new(28, 0, 22), Vector3.new(28, 0, 25.4) }, -- office: to the coffee bar
	{ Vector3.new(-70, 0, 12.5), Vector3.new(-62, 0, 18), Vector3.new(-48, 0, 19.5) }, -- lounge
}
-- street people have a goal: they come out of a door, walk to another door (crossing at the zebra
-- crossing if needed), go in, stay a while, come out again
function Hub.streetTrip(from, to)
	local lanes = Hub.LANES
	local dirX = (to.pos.X >= from.pos.X) and 1 or -1
	local function lane(side, d)
		return lanes[side][(d > 0) and 1 or 2]
	end
	local pts = { from.pos }
	if from.side == to.side then
		local z = lane(from.side, dirX)
		table.insert(pts, Vector3.new(from.pos.X, 0, z))
		table.insert(pts, Vector3.new(to.pos.X, 0, z))
	else
		local cx = (from.side == "front") and -2.2 or 2.2
		local z1 = lane(from.side, (cx >= from.pos.X) and 1 or -1)
		local z2 = lane(to.side, (to.pos.X >= cx) and 1 or -1)
		table.insert(pts, Vector3.new(from.pos.X, 0, z1))
		table.insert(pts, Vector3.new(cx, 0, z1))
		table.insert(pts, Vector3.new(cx, 0, z2))
		table.insert(pts, Vector3.new(to.pos.X, 0, z2))
	end
	table.insert(pts, to.pos)
	return pts
end

Hub.CAFE_TABLES = { -84, -72, -60 }
-- doors people walk to: shops across the street (door = right part of each shop) and on the label side
Hub.SHOP_ROW = { { -130, -90 }, { -90, -46 }, { -46, -6 }, { -6, 34 }, { 34, 76 }, { 76, 120 }, { 120, 170 } }
Hub.DOORS = {
	{ pos = Vector3.new(0, 0, 47.5), side = "front", name = "label" },
	{ pos = Vector3.new(-110, 0, 48.6), side = "front", name = "flats west" },
	{ pos = Vector3.new(146, 0, 48.6), side = "front", name = "hotel" },
}
for _, sh in ipairs(Hub.SHOP_ROW) do
	table.insert(Hub.DOORS, { pos = Vector3.new(sh[2] - 4.5, 0, 103.6), side = "far" })
end
Hub.SITTERS = {
	{ pos = Vector3.new(-63, 0, 36.9), yaw = math.pi, seatY = 2.4 }, -- lounge sofa
	{ pos = Vector3.new(-40, 0, 58.4), yaw = 0, seatY = 2.1 }, -- bus stop
}
for i, x in ipairs(Hub.CAFE_TABLES) do
	table.insert(Hub.SITTERS, { pos = Vector3.new(x - 2.9, 0, 101.8), yaw = math.pi / 2, seatY = 2.3, kind = "chair" })
	if i ~= 2 then
		table.insert(Hub.SITTERS, { pos = Vector3.new(x + 2.9, 0, 101.8), yaw = -math.pi / 2, seatY = 2.3, kind = "chair" })
	end
end

local C = {
	wall = Color3.fromRGB(240, 236, 228),
	wallWarm = Color3.fromRGB(236, 226, 210),
	ceiling = Color3.fromRGB(246, 246, 244),
	floorWood = Color3.fromRGB(200, 158, 112),
	wood = Color3.fromRGB(176, 128, 84),
	woodDark = Color3.fromRGB(120, 84, 56),
	purple = Color3.fromRGB(126, 112, 232),
	teal = Color3.fromRGB(64, 186, 170),
	coral = Color3.fromRGB(240, 122, 100),
	yellow = Color3.fromRGB(250, 204, 82),
	white = Color3.fromRGB(250, 250, 248),
	grey = Color3.fromRGB(136, 140, 150),
	dark = Color3.fromRGB(46, 48, 58),
	screen = Color3.fromRGB(28, 30, 40),
	glass = Color3.fromRGB(190, 218, 238),
	carpet = Color3.fromRGB(120, 132, 168),
	plant = Color3.fromRGB(70, 150, 80),
	pot = Color3.fromRGB(214, 196, 170),
	brick = Color3.fromRGB(164, 92, 70),
	concrete = Color3.fromRGB(168, 170, 172),
	sidewalk = Color3.fromRGB(196, 192, 184),
	asphalt = Color3.fromRGB(70, 72, 78),
	lamp = Color3.fromRGB(255, 248, 228),
}
Hub.COLORS = C

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = parent
	return i
end

-- a part from a relative CFrame (or a relative position)
local function part(parent, name, size, cf, color, material, opts)
	opts = opts or {}
	local p = Instance.new(opts.class or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = (typeof(cf) == "Vector3") and CFrame.new(O + cf) or (CFrame.new(O) * cf)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = opts.collide ~= false
	p.CanTouch = opts.touch == true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.transparency then
		p.Transparency = opts.transparency
	end
	if opts.shape then
		p.Shape = opts.shape
	end
	p.Parent = parent
	return p
end
Hub.part = part

-- a box given by its min / max corner (relative), easier to keep parts from overlapping
local function box(parent, name, x0, y0, z0, x1, y1, z1, color, material, opts)
	return part(parent, name, Vector3.new(x1 - x0, y1 - y0, z1 - z0), Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, material, opts)
end

local function light(p, range, brightness, color, kind)
	return new(kind or "PointLight", { Range = range, Brightness = brightness, Color = color or Color3.fromRGB(255, 240, 220), Shadows = false }, p)
end

local function sign(p, face, text, color, font)
	local g = new("SurfaceGui", { Name = "Sign", Face = face, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40, LightInfluence = 0.2 }, p)
	new("TextLabel", { Name = "Text", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, TextColor3 = color or C.white, TextScaled = true, Font = font or Enum.Font.GothamBlack }, g)
	return g
end

local function prompt(p, id, action, objectText, dist)
	local pr = new("ProximityPrompt", {
		Name = "Prompt",
		ActionText = action,
		ObjectText = objectText,
		KeyboardKeyCode = Enum.KeyCode.E,
		HoldDuration = 0,
		MaxActivationDistance = dist or 9,
		RequiresLineOfSight = false,
		Style = Enum.ProximityPromptStyle.Default,
	}, p)
	pr:SetAttribute("Station", id)
	return pr
end

-- a poster frame on a wall; the client paints an artist on it (attribute Poster = index)
-- face: the side the poster shows ("Back" = +Z, "Front" = -Z, "Right" = +X, "Left" = -X)
local posters = 0
local function poster(parent, center, face, w, h)
	posters = posters + 1
	local size
	if face == Enum.NormalId.Right or face == Enum.NormalId.Left then
		size = Vector3.new(0.2, h, w)
	else
		size = Vector3.new(w, h, 0.2)
	end
	local p = part(parent, "Poster", size, center, C.white, Enum.Material.SmoothPlastic, { collide = false })
	p:SetAttribute("Poster", posters)
	p:SetAttribute("Face", face.Name)
	return p
end

------------------------------------------------------------------ furniture
local function plant(parent, pos, big)
	local s = big and 1.5 or 1
	local pot = part(parent, "Pot", Vector3.new(2.4 * s, 2.2 * s, 2.4 * s), CFrame.new(pos + Vector3.new(0, 1.1 * s, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.pot, Enum.Material.SmoothPlastic, { shape = Enum.PartType.Cylinder })
	pot.Size = Vector3.new(2.2 * s, 2.4 * s, 2.4 * s)
	part(parent, "Leaves", Vector3.new(3.4 * s, 3.4 * s, 3.4 * s), pos + Vector3.new(0, 3.6 * s, 0), C.plant, Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
	part(parent, "Leaves", Vector3.new(2.4 * s, 2.4 * s, 2.4 * s), pos + Vector3.new(0.6 * s, 5 * s, 0.3 * s), Color3.fromRGB(86, 168, 92), Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
end

local function chair(parent, pos, yaw, color)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "ChairSeat", Vector3.new(2.6, 0.5, 2.6), cf * CFrame.new(0, 2.05, 0), color)
	part(parent, "ChairBack", Vector3.new(2.6, 2.8, 0.4), cf * CFrame.new(0, 3.65, 1.25), color)
	part(parent, "ChairPole", Vector3.new(0.35, 1.8, 0.35), cf * CFrame.new(0, 0.9, 0), C.grey, Enum.Material.Metal)
	part(parent, "ChairFoot", Vector3.new(2, 0.15, 2), cf * CFrame.new(0, 0.075, 0), C.grey, Enum.Material.Metal)
end

local function sofa(parent, pos, yaw, color, len)
	len = len or 10
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "SofaBase", Vector3.new(len, 1.6, 4), cf * CFrame.new(0, 0.8, 0), C.woodDark)
	part(parent, "SofaCushion", Vector3.new(len - 2, 0.8, 3.2), cf * CFrame.new(0, 2, -0.3), color, Enum.Material.Fabric)
	part(parent, "SofaBack", Vector3.new(len - 2.2, 2.6, 0.9), cf * CFrame.new(0, 2.9, 1.5), color, Enum.Material.Fabric)
	part(parent, "SofaArm", Vector3.new(1, 2.4, 4), cf * CFrame.new(-len / 2 + 0.5, 2.8, 0), color, Enum.Material.Fabric)
	part(parent, "SofaArm", Vector3.new(1, 2.4, 4), cf * CFrame.new(len / 2 - 0.5, 2.8, 0), color, Enum.Material.Fabric)
	for i = 0, 1 do
		part(parent, "Pillow", Vector3.new(1.6, 1.6, 0.5), cf * CFrame.new(-len / 2 + 2 + i * (len - 4), 3.2, 0.9) * CFrame.Angles(math.rad(-15), 0, 0), (i == 0) and C.yellow or C.white, Enum.Material.Fabric, { collide = false })
	end
end

-- framed gold / platinum record; yaw 0 = the front shows +Z
local function record(parent, pos, yaw, gold)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "RecordFrame", Vector3.new(3.6, 4.4, 0.2), cf, C.woodDark, nil, { collide = false })
	part(parent, "RecordMat", Vector3.new(3.2, 4, 0.1), cf * CFrame.new(0, 0, 0.14), C.white, nil, { collide = false })
	part(parent, "Record", Vector3.new(0.1, 2.6, 2.6), cf * CFrame.new(0, 0.3, 0.24) * CFrame.Angles(0, math.pi / 2, 0), gold and C.yellow or Color3.fromRGB(214, 218, 228), Enum.Material.Metal, { shape = Enum.PartType.Cylinder, collide = false })
	part(parent, "Plate", Vector3.new(2, 0.4, 0.1), cf * CFrame.new(0, -1.6, 0.24), C.yellow, Enum.Material.Metal, { collide = false })
end

local function ceilingLight(parent, pos, len)
	local p = part(parent, "CeilingLight", Vector3.new(len, 0.3, 2), pos, C.lamp, Enum.Material.Neon, { collide = false })
	new("SurfaceLight", { Face = Enum.NormalId.Bottom, Range = 24, Brightness = 0.9, Angle = 120, Color = Color3.fromRGB(255, 246, 232), Shadows = false }, p)
	return p
end

local function desk(parent, pos, yaw, withScreen)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "DeskTop", Vector3.new(8, 0.4, 4), cf * CFrame.new(0, 3.1, 0), C.white)
	part(parent, "DeskLeg", Vector3.new(0.4, 2.9, 3.6), cf * CFrame.new(-3.6, 1.45, 0), C.grey, Enum.Material.Metal)
	part(parent, "DeskLeg", Vector3.new(0.4, 2.9, 3.6), cf * CFrame.new(3.6, 1.45, 0), C.grey, Enum.Material.Metal)
	if withScreen then
		part(parent, "MonitorFoot", Vector3.new(1.2, 0.1, 0.8), cf * CFrame.new(0, 3.35, -1.1), C.dark)
		part(parent, "MonitorArm", Vector3.new(0.3, 1, 0.3), cf * CFrame.new(0, 3.9, -1.1), C.dark)
		part(parent, "Monitor", Vector3.new(3.6, 2.2, 0.25), cf * CFrame.new(0, 5.3, -1.2), C.dark)
		part(parent, "MonitorImage", Vector3.new(3.3, 1.9, 0.05), cf * CFrame.new(0, 5.3, -1.05), (pos.X % 2 < 1) and Color3.fromRGB(110, 160, 230) or Color3.fromRGB(150, 130, 230), Enum.Material.SmoothPlastic, { collide = false })
		part(parent, "Keyboard", Vector3.new(2.6, 0.12, 0.9), cf * CFrame.new(0, 3.36, 0.4), C.white, nil, { collide = false })
		part(parent, "Mug", Vector3.new(0.5, 0.6, 0.5), cf * CFrame.new(2.6, 3.6, 0.2), C.coral, nil, { collide = false })
	end
end

local function shelf(parent, x0, z, x1, y0, rows, faceSign)
	-- a bookshelf against a wall at z (front towards faceSign * Z)
	local d = 1.6
	local zc = z + faceSign * d / 2
	part(parent, "ShelfBack", Vector3.new(x1 - x0 - 0.1, rows * 3 + 0.4, 0.2), Vector3.new((x0 + x1) / 2, y0 + (rows * 3 + 0.4) / 2, z + faceSign * 0.12), C.wood, Enum.Material.Wood, { collide = false })
	for r = 0, rows do
		part(parent, "ShelfBoard", Vector3.new(x1 - x0, 0.3, d), Vector3.new((x0 + x1) / 2, y0 + r * 3 + 0.15, zc), C.wood, Enum.Material.Wood)
	end
	local cols = { C.purple, C.teal, C.coral, C.yellow, C.white, Color3.fromRGB(90, 140, 220) }
	local n = 0
	for r = 0, rows - 1 do
		local x = x0 + 0.5
		while x < x1 - 1.2 do
			n = n + 1
			local w = 0.35 + (n % 3) * 0.15
			local h = 2.1 + (n % 4) * 0.15
			part(parent, "Book", Vector3.new(w, h, d - 0.3), Vector3.new(x + w / 2, y0 + r * 3 + 0.3 + h / 2, zc), cols[n % #cols + 1], nil, { collide = false })
			x = x + w + 0.06
			if n % 7 == 0 then
				x = x + 1.4
			end
		end
	end
end

local function tree(parent, pos)
	part(parent, "TreePit", Vector3.new(4, 0.2, 4), pos + Vector3.new(0, 0.1, 0), Color3.fromRGB(110, 90, 70), Enum.Material.Ground, { collide = false })
	part(parent, "Trunk", Vector3.new(9, 1, 1), CFrame.new(pos + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(110, 80, 56), Enum.Material.Wood, { shape = Enum.PartType.Cylinder })
	part(parent, "Crown", Vector3.new(9, 8, 9), pos + Vector3.new(0, 11, 0), Color3.fromRGB(80, 156, 76), Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
	part(parent, "Crown", Vector3.new(6, 6, 6), pos + Vector3.new(1.8, 13.4, 1), Color3.fromRGB(96, 172, 88), Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
end

local function bench(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "BenchSeat", Vector3.new(7, 0.4, 2), cf * CFrame.new(0, 1.9, 0), C.wood, Enum.Material.Wood)
	part(parent, "BenchBack", Vector3.new(7, 1.6, 0.3), cf * CFrame.new(0, 3, 0.9), C.wood, Enum.Material.Wood)
	part(parent, "BenchLeg", Vector3.new(0.3, 1.7, 1.8), cf * CFrame.new(-3, 0.85, 0), C.dark, Enum.Material.Metal)
	part(parent, "BenchLeg", Vector3.new(0.3, 1.7, 1.8), cf * CFrame.new(3, 0.85, 0), C.dark, Enum.Material.Metal)
end

local function streetLamp(parent, pos, armDir)
	part(parent, "LampPost", Vector3.new(0.6, 15, 0.6), pos + Vector3.new(0, 7.5, 0), C.dark, Enum.Material.Metal)
	part(parent, "LampArm", Vector3.new(0.4, 0.4, 3.2), pos + Vector3.new(0, 15.2, armDir * 1.6), C.dark, Enum.Material.Metal)
	local head = part(parent, "LampHead", Vector3.new(1.4, 0.7, 2), pos + Vector3.new(0, 14.9, armDir * 3), C.dark, Enum.Material.Metal, { collide = false })
	part(parent, "LampGlass", Vector3.new(1.2, 0.1, 1.8), pos + Vector3.new(0, 14.5, armDir * 3), C.lamp, Enum.Material.Glass, { collide = false })
	return head
end

local function car(parent, pos, yaw, color)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, "CarBody", Vector3.new(14, 3, 6.4), cf * CFrame.new(0, 2.3, 0), color, Enum.Material.SmoothPlastic)
	part(parent, "CarCabin", Vector3.new(7.6, 2.4, 5.8), cf * CFrame.new(-0.6, 5, 0), color, Enum.Material.SmoothPlastic)
	part(parent, "CarWindows", Vector3.new(7.8, 1.8, 5.9), cf * CFrame.new(-0.6, 5.1, 0), Color3.fromRGB(120, 150, 175), Enum.Material.Glass, { collide = false })
	for _, wx in ipairs({ -4.4, 4.4 }) do
		for _, wz in ipairs({ -3.25, 3.25 }) do
			part(parent, "Wheel", Vector3.new(1, 2.6, 2.6), cf * CFrame.new(wx, 1.3, wz) * CFrame.Angles(0, math.pi / 2, 0), C.dark, nil, { shape = Enum.PartType.Cylinder })
		end
	end
end

-- a shop across the street: own front, shop window with a room behind it (you look into it),
-- door, sign, maybe an awning, upper floors with windows and balconies
local SHOP_Z = 104 -- facade line
local function shop(parent, x0, x1, o)
	local h, col, mat = o.h, o.color, o.mat or Enum.Material.SmoothPlastic
	local z0, depth = SHOP_Z, 12 -- the shop room is 12 deep
	local inner = Color3.fromRGB(236, 230, 220)
	-- the building above and behind the shop room
	box(parent, "ShopUpper", x0, 12, z0, x1, h, 150, col, mat)
	box(parent, "ShopBack", x0, -0.5, z0 + depth, x1, 12, 150, col, mat)
	box(parent, "ShopCornice", x0, h, z0 - 0.6, x1, h + 1, z0 + 8, C.white)
	-- the room: floor, side walls, back wall, ceiling light
	box(parent, "ShopFloor", x0 + 0.6, -0.5, z0 + 0.6, x1 - 0.6, 0.1, z0 + depth, Color3.fromRGB(196, 170, 140), Enum.Material.WoodPlanks)
	box(parent, "ShopSide", x0, -0.5, z0 + 0.6, x0 + 0.6, 12, z0 + depth, inner)
	box(parent, "ShopSide", x1 - 0.6, -0.5, z0 + 0.6, x1, 12, z0 + depth, inner)
	box(parent, "ShopBackWall", x0 + 0.6, 0.1, z0 + depth - 0.06, x1 - 0.6, 12, z0 + depth, inner)
	local lamp = box(parent, "ShopLamp", (x0 + x1) / 2 - 4, 11.6, z0 + 4, (x0 + x1) / 2 + 4, 11.9, z0 + 6, C.lamp, Enum.Material.Neon, { collide = false })
	new("PointLight", { Range = 16, Brightness = 0.8, Color = Color3.fromRGB(255, 236, 210), Shadows = false }, lamp)
	-- ground floor front: piers, sill, lintel, glass, door
	local doorX = x1 - 7
	box(parent, "ShopPier", x0, 0, z0, x0 + 2, 12, z0 + 0.6, col, mat)
	box(parent, "ShopPier", x1 - 2, 0, z0, x1, 12, z0 + 0.6, col, mat)
	box(parent, "ShopPier", doorX - 1, 0, z0, doorX, 9.6, z0 + 0.6, col, mat)
	box(parent, "ShopSill", x0 + 2, 0, z0, doorX - 1, 1.4, z0 + 0.6, col, mat)
	box(parent, "ShopLintel", x0 + 2, 9.6, z0, x1 - 2, 12, z0 + 0.6, col, mat)
	box(parent, "ShopGlass", x0 + 2, 1.4, z0 + 0.2, doorX - 1, 9.6, z0 + 0.4, C.glass, Enum.Material.Glass, { transparency = 0.55 })
	box(parent, "ShopDoorTop", doorX, 8.6, z0, x1 - 2, 9.6, z0 + 0.6, col, mat)
	box(parent, "ShopDoor", doorX, 0, z0 + 0.15, x1 - 2, 8.6, z0 + 0.45, C.woodDark, Enum.Material.Wood)
	box(parent, "ShopDoorGlass", doorX + 1, 3, z0 + 0.1, x1 - 3, 7.6, z0 + 0.15, C.glass, Enum.Material.Glass)
	box(parent, "DoorHandle", doorX + 0.6, 4, z0 - 0.15, doorX + 0.8, 5.4, z0 + 0.1, C.grey, Enum.Material.Metal)
	-- name board over the window
	local s = box(parent, "ShopSign", x0 + 2.5, 12.4, z0 - 0.5, x1 - 2.5, 14.6, z0 - 0.06, C.white)
	sign(s, Enum.NormalId.Front, o.name, o.signColor)
	if o.awning then
		for k = 0, math.floor((doorX - 1 - x0 - 2) / 2) - 1 do
			part(parent, "Awning", Vector3.new(1.96, 0.3, 4.6), CFrame.new(Vector3.new(x0 + 3.1 + k * 2, 10.6, z0 - 2.1)) * CFrame.Angles(math.rad(-20), 0, 0), (k % 2 == 0) and o.awning or C.white, Enum.Material.Fabric, { collide = false })
		end
	end
	-- upper floors: windows with sills, sometimes a balcony
	local floors = math.floor((h - 16) / 9)
	for fl = 0, floors - 1 do
		local y = 17 + fl * 9
		for k = 0, math.floor((x1 - x0 - 6) / 8) - 1 do
			local wx = x0 + 4 + k * 8
			box(parent, "Window", wx, y, z0 - 0.3, wx + 4.5, y + 5, z0 - 0.06, Color3.fromRGB(170, 196, 220), Enum.Material.Glass)
			box(parent, "WindowSill", wx - 0.3, y - 0.5, z0 - 0.7, wx + 4.8, y - 0.1, z0 - 0.06, C.white)
			if o.balcony and fl == 0 and k % 2 == 1 then
				box(parent, "BalconySlab", wx - 1, y - 0.9, z0 - 3, wx + 5.5, y - 0.5, z0 - 0.06, C.white)
				box(parent, "BalconyRail", wx - 1, y + 2.4, z0 - 3, wx + 5.5, y + 2.7, z0 - 2.8, C.dark, Enum.Material.Metal, { collide = false })
				for bx = wx - 0.9, wx + 5.4, 1.3 do
					box(parent, "BalconyBar", bx, y - 0.5, z0 - 2.98, bx + 0.12, y + 2.4, z0 - 2.86, C.dark, Enum.Material.Metal, { collide = false })
				end
				part(parent, "BalconyPlant", Vector3.new(1.6, 1.6, 1.6), Vector3.new(wx + 4.6, y + 0.3, z0 - 1.4), C.plant, Enum.Material.Grass, { shape = Enum.PartType.Ball, collide = false })
			end
		end
	end
	-- inside (seen through the shop window)
	local cx, iz = (x0 + x1) / 2, z0 + depth
	local kind = o.kind
	if kind == "pizza" then
		-- back: brick oven against the wall, the counter in front of it (on the door side)
		local ox = doorX - 9
		box(parent, "Oven", ox - 5, 0.1, iz - 4, ox + 5, 7.5, iz - 0.06, Color3.fromRGB(170, 90, 60), Enum.Material.Brick)
		box(parent, "OvenMouth", ox - 2.5, 3, iz - 4.04, ox + 2.5, 5.5, iz - 4, Color3.fromRGB(30, 20, 16), nil, { collide = false })
		local fire = box(parent, "OvenFire", ox - 1.5, 3.1, iz - 4.08, ox + 1.5, 4.2, iz - 4.04, Color3.fromRGB(255, 140, 40), Enum.Material.Neon, { collide = false })
		new("PointLight", { Range = 10, Brightness = 1, Color = Color3.fromRGB(255, 150, 60), Shadows = false }, fire)
		box(parent, "OvenChimney", ox - 1.2, 7.5, iz - 2.6, ox + 1.2, 11.5, iz - 0.06, Color3.fromRGB(150, 80, 56), Enum.Material.Brick)
		box(parent, "Counter", ox - 6, 0.1, iz - 7.6, x1 - 2.5, 3.6, iz - 6, C.white)
		box(parent, "CounterTop", ox - 6.2, 3.6, iz - 7.8, x1 - 2.3, 3.9, iz - 5.8, C.woodDark, Enum.Material.Wood)
		box(parent, "Register", x1 - 6, 3.9, iz - 7.4, x1 - 4.2, 5, iz - 6.2, C.dark)
		for k = 0, 2 do
			part(parent, "PizzaOnCounter", Vector3.new(0.12, 2, 2), CFrame.new(Vector3.new(ox - 4 + k * 2.4, 3.96, iz - 6.8)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(240, 170, 70), nil, { shape = Enum.PartType.Cylinder, collide = false })
		end
		local menuBoard = box(parent, "MenuBoard", ox + 2, 8.4, iz - 0.12, ox + 11, 11.2, iz - 0.06, C.dark, nil, { collide = false })
		sign(menuBoard, Enum.NormalId.Front, "MARGHERITA  DIAVOLA  FUNGHI", C.yellow, Enum.Font.Antique)
		-- dining: small tables along the shop window, two chairs facing each other (aisle to the door stays free)
		for i, tx in ipairs({ x0 + 5, x0 + 13.5, x0 + 22 }) do
			if tx + 3 < ox - 6 then
				box(parent, "PizzaTable", tx - 1.3, 2.8, z0 + 2.4, tx + 1.3, 3.1, z0 + 5.2, (i % 2 == 1) and Color3.fromRGB(200, 60, 50) or C.white)
				box(parent, "PizzaTableLeg", tx - 0.2, 0.1, z0 + 3.6, tx + 0.2, 2.8, z0 + 4, C.dark)
				chair(parent, Vector3.new(tx - 2.6, 0.1, z0 + 3.8), -math.pi / 2, Color3.fromRGB(46, 140, 70))
				chair(parent, Vector3.new(tx + 2.6, 0.1, z0 + 3.8), math.pi / 2, Color3.fromRGB(46, 140, 70))
				part(parent, "Pizza", Vector3.new(0.12, 2, 2), CFrame.new(Vector3.new(tx, 3.16, z0 + 3.8)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(240, 170, 70), nil, { shape = Enum.PartType.Cylinder, collide = false })
			end
		end
		-- a big round pizza sign sticking out over the sidewalk
		box(parent, "PizzaSignArm", x1 - 4.2, 18.6, z0 - 5, x1 - 3.8, 19, z0 - 0.06, C.dark, Enum.Material.Metal)
		part(parent, "PizzaSign", Vector3.new(0.5, 6, 6), CFrame.new(Vector3.new(x1 - 4, 15, z0 - 3.4)), Color3.fromRGB(240, 170, 70), nil, { shape = Enum.PartType.Cylinder, collide = false })
		part(parent, "PizzaCrust", Vector3.new(0.4, 6.6, 6.6), CFrame.new(Vector3.new(x1 - 4, 15, z0 - 3.4)), Color3.fromRGB(196, 120, 50), nil, { shape = Enum.PartType.Cylinder, collide = false })
		for k = 0, 5 do
			local a = k * 1.05
			part(parent, "Pepperoni", Vector3.new(0.6, 1, 1), CFrame.new(Vector3.new(x1 - 4, 15 + math.sin(a) * 1.7, z0 - 3.4 + math.cos(a) * 1.7)), Color3.fromRGB(200, 40, 40), nil, { shape = Enum.PartType.Cylinder, collide = false })
		end
	elseif kind == "cafe" then
		box(parent, "Counter", x0 + 3, 0.1, iz - 4, x1 - 9, 3.6, iz - 1.5, C.wood, Enum.Material.Wood)
		box(parent, "CoffeeMachine", x0 + 5, 3.6, iz - 3.4, x0 + 8, 6, iz - 1.8, C.dark, Enum.Material.Metal)
		for k = 0, 3 do
			box(parent, "CakeStand", x0 + 12 + k * 3.2, 3.6, iz - 3.2, x0 + 14 + k * 3.2, 4.6, iz - 2.2, (k % 2 == 0) and C.coral or Color3.fromRGB(240, 220, 170), nil, { collide = false })
		end
		local board = box(parent, "Chalkboard", x0 + 4, 6, iz - 0.12, x0 + 16, 10, iz - 0.06, Color3.fromRGB(40, 50, 44), nil, { collide = false })
		sign(board, Enum.NormalId.Front, "LATTE | CAKE | TOUR SPECIAL", C.white, Enum.Font.Antique)
		box(parent, "CafeTableIn", x0 + 8, 2.6, z0 + 3.5, x0 + 11, 2.9, z0 + 6, C.white)
		box(parent, "CafeTableInLeg", x0 + 9.3, 0.1, z0 + 4.5, x0 + 9.7, 2.6, z0 + 5, C.dark)
		plant(parent, Vector3.new(x1 - 4, 0.1, iz - 3), false)
	elseif kind == "records" then
		for r = 0, 2 do
			local rx = x0 + 5 + r * 9
			box(parent, "Crate", rx, 0.1, z0 + 3, rx + 6, 3, z0 + 7, C.woodDark, Enum.Material.Wood)
			for k = 0, 9 do
				local c = ({ C.purple, C.teal, C.coral, C.yellow, C.dark, C.white })[(k + r) % 6 + 1]
				box(parent, "Record", rx + 0.3 + k * 0.55, 3, z0 + 3.4, rx + 0.7 + k * 0.55, 5.6, z0 + 6.6, c, nil, { collide = false })
			end
		end
		for k = 0, 11 do
			local c = ({ C.purple, C.teal, C.coral, C.yellow, Color3.fromRGB(90, 140, 220), C.dark })[k % 6 + 1]
			local col = k % 6
			local row = math.floor(k / 6)
			box(parent, "AlbumCover", x0 + 4 + col * 5, 5 + row * 3.4, iz - 0.12, x0 + 7 + col * 5, 8 + row * 3.4, iz - 0.06, c, nil, { collide = false })
		end
	elseif kind == "music" then
		-- back wall: a row of guitars on hooks; counter by the door; drum kit on a riser in the window
		for k = 0, 4 do
			local gx = x0 + 5 + k * 4.2
			local c = ({ Color3.fromRGB(200, 40, 40), C.white, Color3.fromRGB(30, 30, 34), Color3.fromRGB(230, 150, 40), Color3.fromRGB(60, 110, 200) })[k + 1]
			box(parent, "GuitarHook", gx - 0.15, 9.7, iz - 0.6, gx + 0.15, 10, iz - 0.06, C.grey, Enum.Material.Metal, { collide = false })
			box(parent, "GuitarNeck", gx - 0.18, 6.4, iz - 0.5, gx + 0.18, 9.7, iz - 0.3, C.woodDark, Enum.Material.Wood, { collide = false })
			part(parent, "GuitarBody", Vector3.new(2.2, 2.8, 0.45), Vector3.new(gx, 5.2, iz - 0.4), c, nil, { shape = Enum.PartType.Ball, collide = false })
		end
		box(parent, "Counter", doorX - 9, 0.1, iz - 4.5, x1 - 2.5, 3.6, iz - 2.8, C.dark)
		box(parent, "CounterTop", doorX - 9.2, 3.6, iz - 4.7, x1 - 2.3, 3.9, iz - 2.6, C.woodDark, Enum.Material.Wood)
		box(parent, "Register", x1 - 6, 3.9, iz - 4.3, x1 - 4.2, 5, iz - 3.1, C.grey)
		for k = 0, 2 do
			box(parent, "PedalBox", doorX - 8 + k * 1.6, 3.9, iz - 4.2, doorX - 6.9 + k * 1.6, 4.3, iz - 3.3, ({ C.coral, C.teal, C.yellow })[k + 1], nil, { collide = false })
		end
		-- the window display: a drum kit on a riser
		local dx = x0 + 9
		box(parent, "Riser", x0 + 3, 0.1, z0 + 1.6, x0 + 15, 1.2, z0 + 7.4, C.dark, Enum.Material.Carpet)
		part(parent, "KickDrum", Vector3.new(1.8, 3, 3), CFrame.new(Vector3.new(dx, 2.7, z0 + 5)) * CFrame.Angles(0, math.pi / 2, 0), C.white, nil, { shape = Enum.PartType.Cylinder })
		part(parent, "Snare", Vector3.new(0.8, 1.8, 1.8), CFrame.new(Vector3.new(dx - 2.4, 3.4, z0 + 4)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 200, 210), nil, { shape = Enum.PartType.Cylinder, collide = false })
		part(parent, "Tom", Vector3.new(0.9, 1.6, 1.6), CFrame.new(Vector3.new(dx + 0.2, 4.6, z0 + 4.4)) * CFrame.Angles(0, 0, math.pi / 2), C.white, nil, { shape = Enum.PartType.Cylinder, collide = false })
		box(parent, "CymbalStand", dx + 2.9, 1.2, z0 + 3.9, dx + 3.1, 5.4, z0 + 4.1, C.grey, Enum.Material.Metal, { collide = false })
		part(parent, "Cymbal", Vector3.new(0.1, 2.4, 2.4), CFrame.new(Vector3.new(dx + 3, 5.5, z0 + 4)) * CFrame.Angles(0, 0, math.pi / 2), C.yellow, Enum.Material.Metal, { shape = Enum.PartType.Cylinder, collide = false })
		box(parent, "DrumStool", dx - 0.7, 1.2, z0 + 6.2, dx + 0.7, 2.6, z0 + 7.2, C.dark)
		-- amps against the side wall, facing the room
		box(parent, "Amp", x0 + 0.7, 0.1, z0 + 8, x0 + 3.2, 4.2, z0 + 11, C.dark, Enum.Material.Leather)
		box(parent, "AmpHead", x0 + 0.9, 4.2, z0 + 8.3, x0 + 3, 5.4, z0 + 10.7, Color3.fromRGB(40, 36, 32), Enum.Material.Leather)
		box(parent, "AmpGrille", x0 + 3.2, 0.8, z0 + 8.4, x0 + 3.24, 4.8, z0 + 10.6, Color3.fromRGB(90, 76, 60), Enum.Material.Fabric, { collide = false })
	elseif kind == "bakery" then
		box(parent, "Display", x0 + 3, 0.1, z0 + 3, x1 - 9, 3.2, z0 + 6, C.white)
		box(parent, "DisplayGlass", x0 + 3, 3.2, z0 + 3, x1 - 9, 4.6, z0 + 3.2, C.glass, Enum.Material.Glass, { transparency = 0.4, collide = false })
		for k = 0, 9 do
			part(parent, "Bread", Vector3.new(1.6, 0.9, 0.9), Vector3.new(x0 + 4.5 + k * 2.4, 3.65, z0 + 4.5 + (k % 2) * 0.6), Color3.fromRGB(200, 140, 70), nil, { shape = Enum.PartType.Ball, collide = false })
		end
		for r = 0, 2 do
			box(parent, "BreadShelf", x0 + 3, 4 + r * 2.6, iz - 1.6, x1 - 3, 4.3 + r * 2.6, iz - 0.06, C.wood, Enum.Material.Wood)
			for k = 0, 7 do
				part(parent, "Loaf", Vector3.new(2, 1, 1), Vector3.new(x0 + 5 + k * 4, 4.8 + r * 2.6, iz - 0.9), Color3.fromRGB(180, 120, 60), nil, { shape = Enum.PartType.Ball, collide = false })
			end
		end
	elseif kind == "bar" then
		box(parent, "BarCounter", x0 + 3, 0.1, iz - 5, x1 - 9, 3.8, iz - 3, C.woodDark, Enum.Material.Wood)
		box(parent, "BarTop", x0 + 2.8, 3.8, iz - 5.2, x1 - 8.8, 4.1, iz - 2.8, C.dark)
		for r = 0, 1 do
			box(parent, "BottleShelf", x0 + 3, 5 + r * 2.6, iz - 1.2, x1 - 3, 5.2 + r * 2.6, iz - 0.06, C.wood, Enum.Material.Wood)
			for k = 0, 14 do
				local c = ({ Color3.fromRGB(60, 140, 70), Color3.fromRGB(150, 90, 40), Color3.fromRGB(200, 200, 220), Color3.fromRGB(150, 40, 60) })[k % 4 + 1]
				box(parent, "Bottle", x0 + 3.6 + k * 2.4, 5.2 + r * 2.6, iz - 0.9, x0 + 4.2 + k * 2.4, 6.9 + r * 2.6, iz - 0.3, c, Enum.Material.Glass, { collide = false })
			end
		end
		for k = 0, 3 do
			part(parent, "BarStool", Vector3.new(0.5, 2, 2), CFrame.new(Vector3.new(x0 + 6 + k * 5, 2.9, iz - 6.5)) * CFrame.Angles(0, 0, math.pi / 2), C.purple, nil, { shape = Enum.PartType.Cylinder })
			box(parent, "StoolLeg", x0 + 5.8 + k * 5, 0.1, iz - 6.7, x0 + 6.2 + k * 5, 2.65, iz - 6.3, C.dark, Enum.Material.Metal)
		end
		local ls = box(parent, "LiveSign", x0 + 4, 8.6, z0 + 0.5, x0 + 14, 9.4, z0 + 0.56, C.dark, nil, { collide = false })
		sign(ls, Enum.NormalId.Front, "LIVE MUSIC TONIGHT", C.yellow)
	elseif kind == "fashion" then
		for r = 0, 1 do
			local ry = z0 + 3.5 + r * 4
			box(parent, "Rack", x0 + 4, 7, ry - 0.1, x1 - 12, 7.2, ry + 0.1, C.grey, Enum.Material.Metal, { collide = false })
			box(parent, "RackLeg", x0 + 4, 0.1, ry - 0.1, x0 + 4.2, 7, ry + 0.1, C.grey, Enum.Material.Metal)
			for k = 0, 9 do
				local c = ({ C.purple, C.teal, C.coral, C.yellow, C.white, C.dark })[(k + r) % 6 + 1]
				box(parent, "Shirt", x0 + 5 + k * 2.6, 3.6, ry - 0.9, x0 + 6.8 + k * 2.6, 6.8, ry + 0.9, c, Enum.Material.Fabric, { collide = false })
			end
		end
		for k = 0, 1 do
			local mx = x1 - 10 + k * 4
			box(parent, "Mannequin", mx - 0.9, 3.4, z0 + 4, mx + 0.9, 7, z0 + 5, (k == 0) and C.coral or C.dark, Enum.Material.Fabric)
			box(parent, "MannequinLegs", mx - 0.7, 0.1, z0 + 4.1, mx + 0.7, 3.4, z0 + 4.9, C.white)
			part(parent, "MannequinHead", Vector3.new(1.2, 1.2, 1.2), Vector3.new(mx, 7.7, z0 + 4.5), C.white, nil, { shape = Enum.PartType.Ball })
		end
	end
end

------------------------------------------------------------------ the building
function Hub.build(parentFolder)
	posters = 0
	local old = workspace:FindFirstChild("StarlightRecords")
	if old then
		old:Destroy()
	end
	local root = new("Model", { Name = "StarlightRecords" }, parentFolder or workspace)
	local shell = new("Folder", { Name = "Shell" }, root)
	local deco = new("Folder", { Name = "Decor" }, root)
	local stations = new("Folder", { Name = "Stations" }, root)
	local out = new("Folder", { Name = "Outside" }, root)
	local spots = new("Folder", { Name = "Spots" }, root)

	local H = 18 -- ceiling (office, meeting room, lounge)
	local HH = 34 -- stage hall

	------------------------------------------------------------ floors (walls stand on them)
	box(shell, "Floor", -88, -1, -46, 40, 0, 46, C.floorWood, Enum.Material.WoodPlanks)
	box(shell, "HallFloor", 42, -1, -46, 122, 0, 46, C.concrete, Enum.Material.Concrete)
	box(shell, "HallDoorSill", 40, -1, 2, 42, 0, 18, C.concrete, Enum.Material.Concrete)
	box(shell, "EntranceSill", -6, -1, 46, 6, 0, 48, C.sidewalk, Enum.Material.Concrete)
	box(deco, "MeetingCarpet", -86, 0, -44, -42, 0.06, 3, C.carpet, Enum.Material.Fabric, { collide = false })
	box(deco, "LoungeRug", -76, 0, 16, -50, 0.06, 34, Color3.fromRGB(230, 170, 120), Enum.Material.Fabric, { collide = false })
	box(deco, "OfficeRug", -10, 0, -2, 10, 0.06, 14, Color3.fromRGB(214, 206, 236), Enum.Material.Fabric, { collide = false })
	box(deco, "DoorMat", -5, 0, 40, 5, 0.06, 45.9, C.dark, Enum.Material.Fabric, { collide = false })

	------------------------------------------------------------ outer walls (all one colour, so corners never flicker)
	box(shell, "BackWall", -90, 0, -48, 40, H + 1, -46, C.wall)
	box(shell, "LeftWall", -90, 0, -46, -88, H + 1, 48, C.wall)
	-- lounge front: low wall, window, top wall
	box(shell, "LoungeFrontLow", -88, 0, 46, -40, 3.5, 48, C.wall)
	box(shell, "LoungeFrontTop", -88, 14, 46, -40, H + 1, 48, C.wall)
	box(shell, "LoungeGlass", -88, 3.5, 46.8, -40, 14, 47.2, C.glass, Enum.Material.Glass, { transparency = 0.55 })
	for _, x in ipairs({ -76, -64, -52 }) do
		box(shell, "Mullion", x - 0.3, 3.52, 46.3, x + 0.3, 13.98, 47.7, C.white)
	end
	-- office front: big windows and the entrance (x -6..6, 11 high)
	box(shell, "FrontLowL", -40, 0, 46, -7, 1.2, 48, C.wall)
	box(shell, "FrontLowR", 7, 0, 46, 40, 1.2, 48, C.wall)
	box(shell, "FrontTop", -40, 15, 46, 40, H + 1, 48, C.wall)
	box(shell, "DoorHeader", -6, 11, 46, 6, 15, 48, C.wall)
	box(shell, "FrontGlassL", -40, 1.2, 46.8, -7, 15, 47.2, C.glass, Enum.Material.Glass, { transparency = 0.55 })
	box(shell, "FrontGlassR", 7, 1.2, 46.8, 40, 15, 47.2, C.glass, Enum.Material.Glass, { transparency = 0.55 })
	for _, x in ipairs({ -29, -18, 18, 29 }) do
		box(shell, "Mullion", x - 0.3, 1.22, 46.3, x + 0.3, 14.98, 47.7, C.white)
	end
	box(shell, "DoorPostL", -7, 0, 46, -6, 15, 48, C.white)
	box(shell, "DoorPostR", 6, 0, 46, 7, 15, 48, C.white)
	-- the glass doors stand open (slid to the sides, in front of the glass)
	box(deco, "SlideDoorL", -12, 0.05, 48.1, -6.2, 11, 48.4, C.glass, Enum.Material.Glass, { transparency = 0.45, collide = false })
	box(deco, "SlideDoorR", 6.2, 0.05, 48.1, 12, 11, 48.4, C.glass, Enum.Material.Glass, { transparency = 0.45, collide = false })
	-- roof
	box(shell, "Roof", -90, H + 1, -48, 40, H + 2, 48, C.grey, Enum.Material.Concrete)
	box(shell, "Ceiling", -88, H, -46, 40, H + 1, 46, C.ceiling)

	------------------------------------------------------------ inner walls
	-- meeting room / office: glass with a door (z -16..-8), white frame
	box(shell, "MeetGlassA", -40.2, 0, -46, -39.8, H - 0.02, -16.4, C.glass, Enum.Material.Glass, { transparency = 0.6 })
	box(shell, "MeetGlassB", -40.2, 0, -7.6, -39.8, H - 0.02, 4, C.glass, Enum.Material.Glass, { transparency = 0.6 })
	box(shell, "MeetDoorTop", -40.6, 10, -16, -39.4, H, -8, C.wall)
	for _, z in ipairs({ -36, -26 }) do
		box(shell, "GlassPost", -40.6, 0, z - 0.4, -39.4, H, z + 0.4, C.white)
	end
	box(shell, "DoorFrame", -40.6, 0, -16.8, -39.4, 10, -16, C.white)
	box(shell, "DoorFrame", -40.6, 0, -8, -39.4, 10, -7.2, C.white)
	local ms = box(deco, "MeetingSign", -39.36, 11, -15.4, -39.2, 13, -8.6, C.purple, nil, { collide = false })
	sign(ms, Enum.NormalId.Right, "MEETING ROOM", C.white)
	-- meeting room / lounge
	box(shell, "LoungeWall", -88, 0, 4, -40.6, H, 6, C.wallWarm)
	box(shell, "LoungeWallEnd", -40.6, 0, 4, -39.4, H, 6, C.white)
	-- office / stage hall: wall with the roll-up door (z 2..18, 14 high)
	box(shell, "HallWallA", 40, 0, -46, 42, HH, 2, C.wall)
	box(shell, "HallWallB", 40, 0, 18, 42, HH, 48, C.wall)
	box(shell, "HallWallTop", 40, 14, 2, 42, HH, 18, C.wall)
	box(deco, "HallDoorFrame", 39.6, 14, 1.4, 39.96, 15, 18.6, C.yellow, nil, { collide = false })
	box(deco, "HallDoorPostA", 39.6, 0, 1.4, 39.96, 14, 2, C.yellow, nil, { collide = false })
	box(deco, "HallDoorPostB", 39.6, 0, 18, 39.96, 14, 18.6, C.yellow, nil, { collide = false })
	local hs = box(deco, "HallSign", 39.56, 15.6, 4, 39.96, 17.6, 16, C.dark, nil, { collide = false })
	sign(hs, Enum.NormalId.Left, "STAGE HALL", C.yellow)
	-- stage hall shell (brick warehouse)
	box(shell, "HallBack", 40, 0, -48, 124, HH, -46, C.brick, Enum.Material.Brick)
	box(shell, "HallRight", 122, 0, -46, 124, HH, 48, C.brick, Enum.Material.Brick)
	box(shell, "HallFront", 42, 0, 46, 122, HH, 48, C.brick, Enum.Material.Brick)
	box(shell, "HallRoof", 40, HH, -48, 124, HH + 1, 48, C.grey, Enum.Material.Concrete)
	-- the roll-up door (the client rolls it up once the hall is open)
	local door = new("Model", { Name = "HallDoor" }, stations)
	for i = 0, 13 do
		box(door, "Slat", 40.3, i, 2.05, 41.7, math.min(13.95, i + 1), 17.95, (i % 2 == 0) and Color3.fromRGB(190, 194, 200) or Color3.fromRGB(176, 180, 188), Enum.Material.Metal)
	end
	local doorSign = box(door, "DoorSign", 40.1, 6, 6, 40.26, 8.4, 14, C.yellow, nil, { collide = false })
	sign(doorSign, Enum.NormalId.Left, "STAGE HALL", C.dark)
	door.PrimaryPart = doorSign

	------------------------------------------------------------ light
	for _, x in ipairs({ -26, -10, 10, 26 }) do
		for _, z in ipairs({ -32, -14, 6, 26 }) do
			ceilingLight(deco, Vector3.new(x, H - 0.15, z), 8)
		end
	end
	for _, z in ipairs({ -34, -14, 22 }) do
		ceilingLight(deco, Vector3.new(-64, H - 0.15, z), 12)
	end

	------------------------------------------------------------ spawn
	local spawn = part(root, "Spawn", Vector3.new(6, 0.1, 6), CFrame.lookAt(Hub.SPAWN + Vector3.new(0, 0.1, 0), Hub.SPAWN + Vector3.new(0, 0.1, 10)), C.purple, Enum.Material.SmoothPlastic, { class = "SpawnLocation", collide = false, transparency = 1 })
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.AllowTeamChangeOnTouch = false
	Hub.spawnPart = spawn

	------------------------------------------------------------ OFFICE: boss desk with the laptop
	local dk = new("Model", { Name = "BossDesk" }, stations)
	local dp = Vector3.new(14, 0, -37)
	box(dk, "DeskTop", 6, 3, -40, 22, 3.5, -34, C.wood, Enum.Material.Wood)
	box(dk, "DeskSide", 6.4, 0, -39.6, 7, 3, -34.4, C.white)
	box(dk, "DeskSide", 21, 0, -39.6, 21.6, 3, -34.4, C.white)
	box(dk, "DeskFront", 7, 0.6, -34.7, 21, 3, -34.4, C.purple)
	local laptop = box(dk, "Laptop", 12.5, 3.5, -36.6, 15.5, 3.7, -34.6, C.grey, Enum.Material.Metal)
	part(dk, "LaptopScreen", Vector3.new(3, 2, 0.12), CFrame.new(dp + Vector3.new(0, 4.55, -0.45)) * CFrame.Angles(math.rad(-12), 0, 0), C.grey, Enum.Material.Metal)
	part(dk, "LaptopDisplay", Vector3.new(2.7, 1.7, 0.04), CFrame.new(dp + Vector3.new(0, 4.55, -0.45)) * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.new(0, 0, 0.09), Color3.fromRGB(150, 140, 250), Enum.Material.SmoothPlastic, { collide = false })
	prompt(laptop, "laptop", "Open laptop", "Office", 9)
	for _, mx in ipairs({ -4.5, 4.5 }) do
		box(dk, "MonitorStand", dp.X + mx - 0.2, 3.5, -39.2, dp.X + mx + 0.2, 4.6, -38.8, C.dark)
		box(dk, "Monitor", dp.X + mx - 2, 4.6, -39.3, dp.X + mx + 2, 7, -39.05, C.dark)
		box(dk, "MonitorImage", dp.X + mx - 1.8, 4.75, -39.05, dp.X + mx + 1.8, 6.85, -39.0, (mx > 0) and Color3.fromRGB(110, 200, 190) or Color3.fromRGB(240, 150, 190), nil, { collide = false })
	end
	chair(dk, dp + Vector3.new(0, 0, -6.2), math.pi, C.purple)
	box(dk, "Lamp", 20.85, 3.5, -35.75, 21.15, 5.6, -35.45, C.dark)
	part(dk, "LampShade", Vector3.new(1.2, 0.9, 1.2), Vector3.new(21, 6.05, -35.6), C.yellow, Enum.Material.SmoothPlastic, { collide = false })
	-- painted accent wall behind the desk + shelves + label logo
	box(deco, "AccentWall", 2, 0, -46, 26, H, -45.94, C.purple)
	shelf(deco, 4, -45.94, 13, 6, 2, 1)
	shelf(deco, 15, -45.94, 24, 6, 2, 1)
	local logo = box(deco, "LogoBoard", 5, 13.2, -45.9, 23, 16.8, -45.7, C.white, nil, { collide = false })
	sign(logo, Enum.NormalId.Back, "STARLIGHT RECORDS", C.purple).Name = "LabelSign"
	record(deco, Vector3.new(30, 9, -45.74), 0, true)
	record(deco, Vector3.new(35.5, 9, -45.74), 0, false)
	record(deco, Vector3.new(-3, 9, -45.74), 0, true)

	------------------------------------------------------------ OFFICE: the world map table (centre)
	local mt = new("Model", { Name = "MapTable" }, stations)
	box(mt, "TableLegs", -8, 0, 2, 8, 2.6, 10, C.white)
	box(mt, "TableTop", -12, 2.6, -1, 12, 3.1, 13, C.wood, Enum.Material.Wood)
	local mapTop = box(mt, "MapSurface", -11, 3.1, 0.5, 11, 3.2, 11.5, Color3.fromRGB(70, 130, 190), Enum.Material.SmoothPlastic)
	prompt(mapTop, "maptable", "Plan a tour", "World Map", 11)
	local mapSign = box(mt, "MapSign", -5, 0.6, 1.92, 5, 2.2, 1.96, C.purple, nil, { collide = false })
	sign(mapSign, Enum.NormalId.Front, "PLAN A TOUR", C.white)
	for i, p in ipairs({ { -14.5, 3 }, { 14.5, 3 }, { -14.5, 9 }, { 14.5, 9 } }) do
		local yaw = (p[1] < 0) and -math.pi / 2 or math.pi / 2
		local _ = i
		chair(mt, Vector3.new(p[1], 0, p[2]), yaw, C.teal)
	end

	------------------------------------------------------------ OFFICE: charts TV (back wall, left)
	local cw = new("Model", { Name = "ChartsWall" }, stations)
	box(cw, "ChartsFrame", -33, 2.5, -45.9, -7, 15.5, -45.5, C.dark)
	local chartsScreen = box(cw, "ChartsScreen", -32.3, 3.2, -45.5, -7.7, 14.8, -45.3, C.screen)
	prompt(chartsScreen, "charts", "View charts", "Charts", 16)
	box(cw, "ChartsShelf", -30, 0, -45.9, -10, 2.2, -43, C.white)
	for i = 0, 3 do
		box(cw, "Trophy", -27 + i * 4.5, 2.2, -44.8, -26 + i * 4.5, 4 + (i % 2) * 0.8, -43.8, C.yellow, Enum.Material.Metal, { collide = false })
	end

	------------------------------------------------------------ OFFICE: staff desks (people work here)
	local staff = new("Folder", { Name = "StaffDesks" }, deco)
	for _, st in ipairs(Hub.STAFF) do
		if st.desk then
			desk(staff, st.desk, 0, true)
			chair(staff, st.pos, 0, C.dark)
		end
	end
	for _, z in ipairs({ -20.2, -8.2 }) do
		box(staff, "Divider", 20, 0, z - 0.2, 36, 5.2, z, C.teal)
	end
	chair(deco, Vector3.new(-22, 0, 25.2), math.pi, C.coral)
	plant(deco, Vector3.new(36, 0, -24), true)
	plant(deco, Vector3.new(37, 0, 22), false)

	------------------------------------------------------------ OFFICE: coffee bar (front right)
	local cb = new("Folder", { Name = "CoffeeBar" }, deco)
	box(cb, "Counter", 24, 0, 30, 38, 3.6, 34, C.white)
	box(cb, "CounterTop", 23.8, 3.6, 29.8, 38.2, 3.9, 34.2, C.woodDark, Enum.Material.Wood)
	box(cb, "CounterFront", 24, 0.6, 29.76, 38, 3.2, 29.8, C.coral, nil, { collide = false })
	box(cb, "CoffeeMachine", 33, 3.9, 31, 36, 6.4, 33.4, C.dark, Enum.Material.Metal)
	box(cb, "Fridge", 36, 0, 38, 39.9, 9, 44, C.white, Enum.Material.Metal)
	for k = 0, 2 do
		part(cb, "Cup", Vector3.new(0.5, 0.6, 0.5), Vector3.new(26 + k * 2, 4.2, 32), (k % 2 == 0) and C.teal or C.yellow, nil, { collide = false })
		local sx = 26 + k * 4.4
		part(cb, "StoolSeat", Vector3.new(0.6, 2, 2), CFrame.new(Vector3.new(sx, 3, 27.4)) * CFrame.Angles(0, 0, math.pi / 2), C.yellow, nil, { shape = Enum.PartType.Cylinder })
		box(cb, "StoolLeg", sx - 0.2, 0, 27.2, sx + 0.2, 2.7, 27.6, C.dark, Enum.Material.Metal)
	end

	------------------------------------------------------------ OFFICE: reception (front left)
	box(deco, "Reception", -30, 0, 28, -14, 3.6, 31, C.white)
	box(deco, "ReceptionTop", -30.3, 3.6, 27.7, -13.7, 3.9, 31.3, C.wood, Enum.Material.Wood)
	local rl = box(deco, "ReceptionLogo", -28, 1.2, 31.04, -16, 3, 31.08, C.purple, nil, { collide = false })
	sign(rl, Enum.NormalId.Back, "STARLIGHT RECORDS", C.white).Name = "LabelSign"
	plant(deco, Vector3.new(-36, 0, 42), true)
	plant(deco, Vector3.new(-10, 0, 42), false)
	plant(deco, Vector3.new(10, 0, 42), false)
	plant(deco, Vector3.new(-36, 0, -42), true)
	-- waiting sofa
	sofa(deco, Vector3.new(-31, 0, 14), -math.pi / 2, C.teal, 12)

	------------------------------------------------------------ posters of the label's artists (filled by the client)
	poster(deco, Vector3.new(39.86, 9, -40), Enum.NormalId.Left, 7, 10)
	poster(deco, Vector3.new(39.86, 9, -30), Enum.NormalId.Left, 7, 10)
	poster(deco, Vector3.new(39.86, 9, 26), Enum.NormalId.Left, 7, 10)

	------------------------------------------------------------ MEETING ROOM: table, seats, board
	local mr = new("Model", { Name = "Meeting" }, stations)
	local mc = Vector3.new(-63, 0, -24)
	box(mr, "MeetTable", mc.X - 4.5, 3, mc.Z - 10, mc.X + 4.5, 3.5, mc.Z + 10, C.wood, Enum.Material.Wood)
	part(mr, "MeetTableEnd", Vector3.new(0.5, 9, 9), CFrame.new(mc + Vector3.new(0, 3.25, -10)) * CFrame.Angles(0, 0, math.pi / 2), C.wood, Enum.Material.Wood, { shape = Enum.PartType.Cylinder })
	part(mr, "MeetTableEnd", Vector3.new(0.5, 9, 9), CFrame.new(mc + Vector3.new(0, 3.25, 10)) * CFrame.Angles(0, 0, math.pi / 2), C.wood, Enum.Material.Wood, { shape = Enum.PartType.Cylinder })
	box(mr, "MeetTableLeg", mc.X - 1.5, 0, mc.Z - 7, mc.X + 1.5, 3, mc.Z + 7, C.white)
	local seats = new("Folder", { Name = "Seats" }, mr)
	local seatSpots = {}
	for _, z in ipairs({ -6, 0, 6 }) do
		table.insert(seatSpots, { mc + Vector3.new(-6.6, 0, z), mc + Vector3.new(0, 0, z) })
		table.insert(seatSpots, { mc + Vector3.new(6.6, 0, z), mc + Vector3.new(0, 0, z) })
	end
	table.insert(seatSpots, { mc + Vector3.new(0, 0, 17), mc + Vector3.new(0, 0, -10) })
	for i, sp in ipairs(seatSpots) do
		local pos, at = sp[1], sp[2]
		local look = CFrame.lookAt(pos + Vector3.new(0, 1.8, 0), Vector3.new(at.X, 1.8, at.Z))
		local seat = part(seats, "MeetingSeat" .. i, Vector3.new(2.8, 0.6, 2.8), look, (i % 2 == 0) and C.purple or C.teal, Enum.Material.Fabric, { class = "Seat", touch = true })
		seat:SetAttribute("Meeting", true)
		part(mr, "SeatBack", Vector3.new(2.8, 3.2, 0.5), look * CFrame.new(0, 1.9, 1.35), C.white)
		part(mr, "SeatPole", Vector3.new(0.4, 1.5, 0.4), look * CFrame.new(0, -1.05, 0), C.grey, Enum.Material.Metal)
		part(mr, "SeatFoot", Vector3.new(2.2, 0.15, 2.2), look * CFrame.new(0, -1.725, 0), C.grey, Enum.Material.Metal)
	end
	-- the big screen on the back wall (the client draws roster + talent on it)
	box(mr, "BoardFrame", -79, 2, -45.9, -47, 17, -45.5, C.dark)
	box(mr, "Board", -78.3, 2.7, -45.5, -47.7, 16.3, -45.3, C.screen)
	prompt(part(mr, "MeetPromptSpot", Vector3.new(1, 1, 1), mc + Vector3.new(0, 4, 0), C.white, nil, { collide = false, transparency = 1 }), "meeting", "Start meeting", "Meeting Room", 18)
	-- whiteboard, plants
	local wb = box(deco, "Whiteboard", -87.94, 5, -36, -87.8, 12, -20, C.white, nil, { collide = false })
	sign(wb, Enum.NormalId.Right, "TOUR IDEAS:  bigger venues  |  new stage  |  sign a star", Color3.fromRGB(60, 80, 160), Enum.Font.GothamBold)
	plant(deco, Vector3.new(-85, 0, -42), true)
	plant(deco, Vector3.new(-44, 0, -42), false)
	plant(deco, Vector3.new(-85, 0, 0), false)

	------------------------------------------------------------ LOUNGE: sofas, ping pong, arcade, records
	sofa(deco, Vector3.new(-63, 0, 38), 0, C.coral, 14)
	sofa(deco, Vector3.new(-80, 0, 25), -math.pi / 2, C.purple, 10)
	box(deco, "LoungeTable", -68, 0, 22, -58, 1.6, 28, C.wood, Enum.Material.Wood)
	-- ping pong table
	box(deco, "PingPong", -56, 2.6, 8.5, -44, 3, 15.5, Color3.fromRGB(40, 110, 90))
	box(deco, "PingPongLine", -56, 3, 11.95, -44, 3.04, 12.05, C.white, nil, { collide = false })
	box(deco, "PingPongNet", -50.1, 3, 8.5, -49.9, 3.8, 15.5, C.white, nil, { collide = false })
	box(deco, "PingPongLegs", -54, 0, 10, -46, 2.6, 14, C.dark, Enum.Material.Metal)
	-- arcade + vending machine
	box(deco, "Arcade", -87.9, 0, 8, -84, 7, 12, C.purple)
	box(deco, "ArcadeScreen", -84, 4, 8.6, -83.96, 6.4, 11.4, C.teal, nil, { collide = false })
	box(deco, "Vending", -47, 0, 40.5, -41.5, 9, 45.9, C.coral)
	box(deco, "VendingGlass", -46.6, 2, 40.46, -42.4, 8, 40.5, C.glass, Enum.Material.Glass, { collide = false })
	for i, z in ipairs({ 14, 22, 30, 38 }) do
		record(deco, Vector3.new(-87.74, 9, z), math.pi / 2, i % 2 == 0)
	end
	-- beanbags
	for i, p in ipairs({ { -72, 30 }, { -54, 30 } }) do
		part(deco, "Beanbag", Vector3.new(4, 3, 4), Vector3.new(p[1], 1.5, p[2]), (i == 1) and C.teal or C.yellow, Enum.Material.Fabric, { shape = Enum.PartType.Ball })
	end
	poster(deco, Vector3.new(-78, 9, 6.14), Enum.NormalId.Back, 7, 10)
	poster(deco, Vector3.new(-63, 9, 6.14), Enum.NormalId.Back, 7, 10)
	poster(deco, Vector3.new(-48, 9, 6.14), Enum.NormalId.Back, 7, 10)
	plant(deco, Vector3.new(-85, 0, 44), true)

	------------------------------------------------------------ STAGE HALL: rehearsal stage + build console
	local hall = new("Model", { Name = "Hall" }, stations)
	box(hall, "RehearsalDeck", 72, 0, -42, 112, 4, -22, Color3.fromRGB(40, 40, 46))
	box(hall, "DeckEdge", 72, 3.6, -21.98, 112, 4, -21.94, C.yellow, nil, { collide = false })
	box(hall, "LedWall", 76, 4, -42, 108, 19, -41, C.screen)
	local ledText = box(hall, "LedText", 77, 9, -41, 107, 15, -40.96, C.screen, nil, { collide = false })
	sign(ledText, Enum.NormalId.Back, "STARLIGHT RECORDS", C.purple).Name = "LabelSign"
	for _, x in ipairs({ 70, 114 }) do
		box(hall, "TrussTower", x - 1, 0, -37, x + 1, 26, -35, C.grey, Enum.Material.DiamondPlate)
	end
	box(hall, "Speaker", 74.5, 4, -32, 78.5, 12, -28, C.dark)
	box(hall, "Speaker", 105.5, 4, -32, 109.5, 12, -28, C.dark)
	box(hall, "TrussTop", 69, 26, -37, 115, 28, -35, C.grey, Enum.Material.DiamondPlate)
	for i = 0, 5 do
		local lx = 74 + i * 7
		local lamp = box(hall, "MovingHead", lx - 0.8, 24, -36.8, lx + 0.8, 26, -35.2, C.dark)
		box(hall, "Lens", lx - 0.5, 23.9, -36.5, lx + 0.5, 24, -35.5, (i % 2 == 0) and C.purple or C.teal, Enum.Material.Neon, { collide = false })
		if i % 2 == 0 then
			new("SpotLight", { Face = Enum.NormalId.Bottom, Range = 40, Angle = 40, Brightness = 1.5, Color = (i % 4 == 0) and C.purple or C.teal, Shadows = false }, lamp)
		end
	end
	for i = 0, 4 do
		local x = 112 - (i % 3) * 6
		local y = math.floor(i / 3) * 4
		box(hall, "RoadCase", x - 2.5, y, 28, x + 2.5, y + 4, 32, (i % 2 == 0) and Color3.fromRGB(40, 40, 46) or Color3.fromRGB(60, 60, 68), Enum.Material.DiamondPlate)
	end
	-- the stage design workstation (opens My Stages / the stage builder): desk, three monitors, PC, chair
	local cp = Vector3.new(58, 0, -24)
	box(hall, "WorkDesk", cp.X - 6, 3, cp.Z - 2.4, cp.X + 6, 3.4, cp.Z + 2.4, C.woodDark, Enum.Material.Wood)
	for _, dx in ipairs({ -5.6, 5.6 }) do
		box(hall, "WorkDeskLeg", cp.X + dx - 0.2, 0, cp.Z - 2.2, cp.X + dx + 0.2, 3, cp.Z + 2.2, C.grey, Enum.Material.Metal)
	end
	box(hall, "WorkDeskPanel", cp.X - 5.4, 0.8, cp.Z - 2.2, cp.X + 5.4, 3, cp.Z - 2, C.dark)
	local monitorCol = { Color3.fromRGB(110, 200, 190), Color3.fromRGB(160, 150, 240), Color3.fromRGB(250, 200, 110) }
	for i = -1, 1 do
		local mcf = CFrame.new(cp + Vector3.new(i * 3.8, 0, -1.2)) * CFrame.Angles(0, i * -0.3, 0)
		part(hall, "MonitorFoot", Vector3.new(1.4, 0.12, 1), mcf * CFrame.new(0, 3.46, 0), C.dark)
		part(hall, "MonitorStand", Vector3.new(0.35, 1.3, 0.35), mcf * CFrame.new(0, 4.1, -0.1), C.dark)
		part(hall, "Monitor", Vector3.new(3.6, 2.3, 0.3), mcf * CFrame.new(0, 5.8, -0.1), C.dark)
		part(hall, "MonitorScreen", Vector3.new(3.3, 2, 0.05), mcf * CFrame.new(0, 5.8, 0.075), monitorCol[i + 2], Enum.Material.SmoothPlastic, { collide = false })
	end
	local consoleTop = box(hall, "Keyboard", cp.X - 1.4, 3.4, cp.Z + 0.6, cp.X + 1.4, 3.55, cp.Z + 1.5, C.white)
	box(hall, "Mouse", cp.X + 2.2, 3.4, cp.Z + 0.8, cp.X + 2.7, 3.6, cp.Z + 1.4, C.white)
	box(hall, "Tablet", cp.X - 4.6, 3.4, cp.Z + 0.4, cp.X - 2.6, 3.5, cp.Z + 1.8, C.dark)
	box(hall, "PCTower", cp.X + 6.4, 0, cp.Z - 1.5, cp.X + 8, 4, cp.Z + 1.5, C.dark)
	box(hall, "PCLight", cp.X + 6.6, 3.2, cp.Z + 1.5, cp.X + 7.8, 3.4, cp.Z + 1.54, C.teal, nil, { collide = false })
	chair(hall, cp + Vector3.new(0, 0, 4.2), 0, C.purple)
	local ws = box(hall, "WorkSign", cp.X - 5, 9, cp.Z - 2.6, cp.X + 5, 10.6, cp.Z - 2.44, C.dark, nil, { collide = false })
	sign(ws, Enum.NormalId.Back, "STAGE DESIGN", C.yellow)
	box(hall, "WorkSignPole", cp.X - 0.15, 3.4, cp.Z - 2.4, cp.X + 0.15, 9, cp.Z - 2.1, C.grey, Enum.Material.Metal)
	prompt(consoleTop, "stagehall", "Build stages", "Stage Hall", 10)
	box(hall, "FloorTape", 48, 0, -12, 116, 0.04, -11.6, C.yellow, nil, { collide = false })
	for _, z in ipairs({ -20, 10, 36 }) do
		for _, x in ipairs({ 60, 100 }) do
			local l = box(hall, "HallLamp", x - 4, HH - 1.4, z - 1, x + 4, HH - 1, z + 1, C.lamp, Enum.Material.Neon, { collide = false })
			new("SurfaceLight", { Face = Enum.NormalId.Bottom, Range = 36, Brightness = 1, Angle = 110, Shadows = false }, l)
		end
	end
	Hub.buildWarehouse(hall)

	------------------------------------------------------------ OUTSIDE: the street. Straight in front of the label,
	-- at both ends it bends away around the corner (you see the city go on; an invisible wall stops you there)
	local XW, XE = Hub.STREET.xw, Hub.STREET.xe
	local CW, CE = Hub.STREET.cw, Hub.STREET.ce
	local AS = C.asphalt
	box(out, "Ground", -340, -2.2, -90, 380, -1.5, 330, Color3.fromRGB(86, 88, 92), Enum.Material.Concrete)
	-- straight part
	box(out, "Sidewalk", XW, -1, 48, XE, 0, 62, C.sidewalk, Enum.Material.Concrete)
	box(out, "Curb", XW, -1, 62, XE, 0.02, 63, Color3.fromRGB(150, 150, 150), Enum.Material.Concrete)
	box(out, "Road", XW, -1.5, 63, XE, -0.5, 89, AS, Enum.Material.Asphalt)
	box(out, "CurbFar", XW, -1, 89, XE, 0.02, 90, Color3.fromRGB(150, 150, 150), Enum.Material.Concrete)
	box(out, "SidewalkFar", XW, -1, 90, XE, 0, 104, C.sidewalk, Enum.Material.Concrete)
	for x = XW + 6, XE - 10, 16 do
		if x + 8 < -9 or x > 9 then
			box(out, "LaneMark", x, -0.5, 77, x + 8, -0.46, 77.5, C.white, nil, { collide = false })
		end
	end
	-- zebra crossing: stripes parallel to the road, one after another across it
	for z = 64.2, 87, 3.2 do
		box(out, "Crosswalk", -6, -0.5, z, 6, -0.46, z + 1.6, C.white, nil, { collide = false })
	end
	-- the two bends (ring pieces around a corner point) and the street going on behind them
	local function ringPiece(name, ctr, dir, r0, r1, a0, a1, y0, y1, color, material)
		local am = (a0 + a1) / 2
		local rm = (r0 + r1) / 2
		local chord = 2 * r1 * math.sin((a1 - a0) / 2) + 0.1
		local pos = ctr + Vector3.new(dir * math.sin(am) * rm, (y0 + y1) / 2, -math.cos(am) * rm)
		local yaw = math.atan2(math.cos(am), dir * math.sin(am))
		return part(out, name, Vector3.new(r1 - r0, y1 - y0, chord), CFrame.new(pos) * CFrame.Angles(0, yaw, 0), color, material)
	end
	local LAYERS = {
		{ "ArcSidewalkIn", 20, 34, -1, 0, C.sidewalk, Enum.Material.Concrete },
		{ "ArcCurbIn", 34, 35, -1, 0.02, Color3.fromRGB(150, 150, 150), Enum.Material.Concrete },
		{ "ArcRoad", 35, 61, -1.5, -0.5, AS, Enum.Material.Asphalt },
		{ "ArcCurbOut", 61, 62, -1, 0.02, Color3.fromRGB(150, 150, 150), Enum.Material.Concrete },
		{ "ArcSidewalkOut", 62, 76, -1, 0, C.sidewalk, Enum.Material.Concrete },
	}
	local rng = Random.new(21)
	for _, side in ipairs({ { CW, -1 }, { CE, 1 } }) do
		local ctr, dir = side[1], side[2]
		local steps = 9
		for k = 0, steps - 1 do
			local a0, a1 = k * (math.pi / 2) / steps, (k + 1) * (math.pi / 2) / steps
			for _, L in ipairs(LAYERS) do
				ringPiece(L[1], ctr, dir, L[2], L[3], a0, a1, L[4], L[5], L[6], L[7])
			end
		end
		-- outer buildings along the bend
		for k = 0, 5 do
			local a0, a1 = k * (math.pi / 12), (k + 1) * (math.pi / 12)
			local h = 36 + ((k % 2 == 0) and 0 or 14) + k * 3 + rng:NextInteger(0, 2)
			local col = Color3.fromRGB(rng:NextInteger(170, 230), rng:NextInteger(150, 210), rng:NextInteger(130, 200))
			local b = ringPiece("ArcBuilding", ctr, dir, 77, 108, a0, a1, -1, h, col, (k % 2 == 0) and Enum.Material.Brick or Enum.Material.SmoothPlastic)
			for fl = 0, math.floor((h - 10) / 10) do
				local wnd = ringPiece("ArcWindows", ctr, dir, 76.9, 77, a0 + 0.03, a1 - 0.03, 5 + fl * 10, 10 + fl * 10, Color3.fromRGB(170, 196, 220), Enum.Material.Glass)
				local _w = wnd
			end
			local _b = b
		end
		-- the street goes on after the bend
		local xr = function(r)
			return ctr.X + dir * r
		end
		local function strip(name, r0, r1, y0, y1, color, material)
			local xa, xb = xr(r0), xr(r1)
			box(out, name, math.min(xa, xb), y0, ctr.Z, math.max(xa, xb), y1, ctr.Z + 190, color, material)
		end
		for _, L in ipairs(LAYERS) do
			strip(L[1]:gsub("Arc", "Cont"), L[2], L[3], L[4], L[5], L[6], L[7])
		end
		for i = 0, 4 do
			local z0 = ctr.Z + i * 38
			local h = rng:NextInteger(30, 64)
			local xa, xb = xr(77), xr(108)
			box(out, "ContBuilding", math.min(xa, xb), -1, z0, math.max(xa, xb), h, z0 + 36, Color3.fromRGB(rng:NextInteger(160, 220), rng:NextInteger(150, 200), rng:NextInteger(140, 200)), Enum.Material.Brick)
		end
		-- life in the side street: shop fronts and windows, trees, lamps, parked cars
		local out0 = -dir -- the house fronts look towards the road
		local NAMES = { "DINER", "BOOKS", "FLOWERS", "SNEAKERS", "GYM", "BARBER", "NOODLES", "PHONE REPAIR", "ICE CREAM", "COMICS" }
		for i = 0, 4 do
			local z0 = ctr.Z + i * 38
			local fx = xr(77)
			local c = ({ C.coral, C.teal, C.purple, C.yellow, Color3.fromRGB(90, 140, 220) })[i % 5 + 1]
			box(out, "ContShopGlass", math.min(fx, fx + out0 * 0.3), 1.2, z0 + 4, math.max(fx, fx + out0 * 0.3), 8.6, z0 + 28, C.glass, Enum.Material.Glass)
			local sg = box(out, "ContShopSign", math.min(fx, fx + out0 * 0.5), 9.4, z0 + 6, math.max(fx, fx + out0 * 0.5), 12, z0 + 30, c)
			sign(sg, (out0 > 0) and Enum.NormalId.Right or Enum.NormalId.Left, NAMES[(i + (dir > 0 and 5 or 0)) % #NAMES + 1], C.white)
			for fl = 0, 3 do
				for k = 0, 3 do
					box(out, "ContWindow", math.min(fx, fx + out0 * 0.25), 15 + fl * 9, z0 + 3 + k * 8.5, math.max(fx, fx + out0 * 0.25), 20 + fl * 9, z0 + 8 + k * 8.5, Color3.fromRGB(170, 196, 220), Enum.Material.Glass)
				end
			end
			local ix = xr(20)
			for fl = 0, 3 do
				for k = 0, 3 do
					box(out, "ContWindow", math.min(ix, ix + dir * 0.25), 6 + fl * 9, z0 + 3 + k * 8.5, math.max(ix, ix + dir * 0.25), 11 + fl * 9, z0 + 8 + k * 8.5, Color3.fromRGB(170, 196, 220), Enum.Material.Glass)
				end
			end
			tree(out, Vector3.new(xr(70), 0, z0 + 18))
			tree(out, Vector3.new(xr(28), 0, z0 + 30))
			streetLamp(out, Vector3.new(xr(64), 0, z0 + 6), 0)
			if i % 2 == 0 then
				car(out, Vector3.new(xr(57.8), -0.5, z0 + 22), math.pi / 2, ({ Color3.fromRGB(60, 120, 200), Color3.fromRGB(200, 200, 205), Color3.fromRGB(150, 40, 40) })[i / 2 + 1])
			end
		end
		box(out, "ContEnd", math.min(xr(0), xr(110)), -1, ctr.Z + 190, math.max(xr(0), xr(110)), 70, ctr.Z + 220, Color3.fromRGB(190, 180, 170), Enum.Material.Concrete)
		-- the inner corner: a round corner house and the block along the side street
		part(out, "CornerTower", Vector3.new(52, 40, 40), CFrame.new(ctr + Vector3.new(0, 25, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(214, 196, 172), Enum.Material.SmoothPlastic, { shape = Enum.PartType.Cylinder })
		local xi0, xi1 = xr(0), xr(20)
		box(out, "CornerBlock", math.min(xi0, xi1), -1, ctr.Z, math.max(xi0, xi1), 42, ctr.Z + 190, Color3.fromRGB(200, 186, 168), Enum.Material.Brick)
		-- invisible wall where the bend starts: you can look around the corner, not walk there
		local xw = (dir < 0) and XW or XE
		box(out, "Boundary", xw - 0.5, -1, 48, xw + 0.5, 60, 104, C.white, nil, { transparency = 1 })
	end

	-- the label's neighbours (left and right) and the billboard
	box(out, "NeighbourWest", XW, -1, -60, -90, 54, 48, Color3.fromRGB(212, 186, 150), Enum.Material.Brick)
	box(out, "NeighbourEast", 124, -1, -60, XE, 64, 48, Color3.fromRGB(190, 200, 214), Enum.Material.Concrete)
	for _, nb in ipairs({ { XW, -90, 54 }, { 124, XE, 64 } }) do
		for fl = 0, math.floor((nb[3] - 8) / 10) do
			for k = 0, math.floor((nb[2] - nb[1] - 8) / 9) do
				local wx, wy = nb[1] + 5 + k * 9, 6 + fl * 10
				local underBillboard = nb[1] > 0 and wx + 5 > 128 and wx < 168 and wy + 6 > 24 and wy < 54
				local entrance = wy < 11 and ((wx + 5.3 > -114 and wx - 0.3 < -106) or (wx + 5.3 > 142 and wx - 0.3 < 150))
				if not underBillboard and not entrance then
					box(out, "Window", wx, wy, 48.06, wx + 5, wy + 6, 48.3, Color3.fromRGB(170, 196, 220), Enum.Material.Glass)
					box(out, "WindowSill", wx - 0.3, wy - 0.4, 48.04, wx + 5.3, wy, 48.5, C.white)
				end
			end
		end
	end
	-- entrances of the flats (west) and the hotel (east)
	for _, dx in ipairs({ -110, 146 }) do
		box(out, "EntranceFrame", dx - 3.5, 0, 48.04, dx + 3.5, 10, 48.5, C.white)
		box(out, "EntranceDoor", dx - 2.5, 0, 48.5, dx + 2.5, 8.6, 48.7, C.woodDark, Enum.Material.Wood)
		box(out, "EntranceLamp", dx - 0.6, 9.2, 48.5, dx + 0.6, 9.8, 49.1, C.lamp, Enum.Material.Neon, { collide = false })
		box(out, "EntranceStep", dx - 4, 0, 48.56, dx + 4, 0.4, 50, C.concrete, Enum.Material.Concrete)
	end
	box(out, "BillboardFrame", 130, 26, 48.06, 166, 52, 48.6, C.dark)
	poster(out, Vector3.new(148, 39, 48.72), Enum.NormalId.Back, 34, 24)
	-- the label's facade: canopy over the door and the big name sign on the roof
	box(out, "Canopy", -12, 15.2, 48, 12, 15.8, 54, C.white)
	local facade = box(out, "FacadeSign", -30, H + 2.4, 48.04, 30, H + 7.6, 48.6, C.purple)
	sign(facade, Enum.NormalId.Back, "STARLIGHT RECORDS", C.white).Name = "LabelSign"
	box(out, "FacadeSignBack", -30, H + 2, 46, 30, H + 8, 48.04, C.wall)

	-- shops across the street (each with its own front, a shop window and something to see inside)
	shop(out, -130, -90, { h = 38, color = Color3.fromRGB(226, 200, 170), name = "BAKERY", signColor = C.coral, awning = C.coral, kind = "bakery", mat = Enum.Material.Brick })
	shop(out, -90, -46, { h = 30, color = Color3.fromRGB(240, 214, 200), name = "MOONBEAM CAFE", signColor = C.purple, awning = C.purple, kind = "cafe", balcony = true })
	shop(out, -46, -6, { h = 52, color = Color3.fromRGB(200, 214, 230), name = "VINYL VAULT", signColor = Color3.fromRGB(40, 90, 160), kind = "records" })
	shop(out, -6, 34, { h = 44, color = Color3.fromRGB(150, 70, 56), name = "AMP CITY", signColor = C.yellow, awning = C.dark, kind = "music", mat = Enum.Material.Brick })
	shop(out, 34, 76, { h = 36, color = Color3.fromRGB(214, 226, 206), name = "SLICE PIZZA", signColor = Color3.fromRGB(200, 60, 50), awning = Color3.fromRGB(46, 140, 70), kind = "pizza", balcony = true })
	shop(out, 76, 120, { h = 58, color = Color3.fromRGB(110, 84, 120), name = "BACKSTAGE BAR", signColor = C.yellow, kind = "bar" })
	shop(out, 120, XE, { h = 46, color = Color3.fromRGB(236, 230, 214), name = "STAGE WEAR", signColor = C.dark, awning = Color3.fromRGB(30, 30, 36), kind = "fashion", balcony = true })

	-- far sidewalk: trees and lamps at the curb, cafe tables at the cafe front (people walk in between)
	for _, x in ipairs({ -112, -40, 46, 100, 150 }) do
		tree(out, Vector3.new(x, 0, 92.5))
	end
	for _, x in ipairs({ -70, 14, 76, 128 }) do
		streetLamp(out, Vector3.new(x, 0, 90.9), -1)
	end
	for i, x in ipairs(Hub.CAFE_TABLES) do
		box(out, "CafeTable", x - 1.4, 2.6, 100.4, x + 1.4, 2.9, 103.2, C.white)
		box(out, "CafeTableLeg", x - 0.2, 0, 101.6, x + 0.2, 2.6, 102, C.dark, Enum.Material.Metal)
		box(out, "UmbrellaPole", x - 0.15, 2.9, 101.65, x + 0.15, 9, 101.95, C.white)
		part(out, "Umbrella", Vector3.new(0.6, 8, 8), CFrame.new(Vector3.new(x, 9.2, 101.8)) * CFrame.Angles(0, 0, math.pi / 2), (i % 2 == 0) and C.purple or C.coral, Enum.Material.Fabric, { shape = Enum.PartType.Cylinder, collide = false })
	end
	for _, st in ipairs(Hub.SITTERS) do
		if st.kind == "chair" then
			chair(out, st.pos, st.yaw + math.pi, C.white)
		end
	end
	-- front sidewalk: trees, lamps, the bus stop and benches in the strip at the curb
	for _, x in ipairs({ -115, -75, 26, 118, 158 }) do
		tree(out, Vector3.new(x, 0, 59.5))
	end
	for _, x in ipairs({ -95, -20, 50, 100, 140 }) do
		streetLamp(out, Vector3.new(x, 0, 60.8), 1)
	end
	box(out, "BusStopRoof", -48, 10, 56.8, -32, 10.4, 62, C.white)
	box(out, "BusStopPost", -47.7, 0, 61.2, -47.3, 10, 61.6, C.grey, Enum.Material.Metal)
	box(out, "BusStopPost", -32.7, 0, 61.2, -32.3, 10, 61.6, C.grey, Enum.Material.Metal)
	box(out, "BusStopBack", -47.3, 1, 56.9, -32.7, 9, 57.2, C.glass, Enum.Material.Glass, { transparency = 0.5 })
	box(out, "BusStopSign", -47.8, 10.4, 61.2, -45.8, 12.4, 61.6, Color3.fromRGB(40, 110, 200))
	bench(out, Vector3.new(-40, 0, 58.6), math.pi)
	poster(out, Vector3.new(-40, 5, 56.8), Enum.NormalId.Front, 6, 7.6)
	bench(out, Vector3.new(-58, 0, 59), math.pi)
	bench(out, Vector3.new(130, 0, 59), math.pi)
	-- parked cars in the parking strips, the label's tour bus in front of the stage hall
	car(out, Vector3.new(-110, -0.5, 66.4), 0, Color3.fromRGB(210, 70, 70))
	car(out, Vector3.new(-82, -0.5, 66.4), 0, Color3.fromRGB(70, 120, 210))
	car(out, Vector3.new(20, -0.5, 86.6), math.pi, Color3.fromRGB(240, 210, 90))
	car(out, Vector3.new(110, -0.5, 86.6), math.pi, Color3.fromRGB(240, 240, 240))
	car(out, Vector3.new(150, -0.5, 86.6), math.pi, Color3.fromRGB(60, 160, 120))
	local bp = Vector3.new(80, -0.5, 67.25)
	box(out, "BusBody", bp.X - 20, bp.Y + 1.2, bp.Z - 3.75, bp.X + 20, bp.Y + 12, bp.Z + 3.75, C.white)
	box(out, "BusStripe", bp.X - 20.04, bp.Y + 3.4, bp.Z - 3.79, bp.X + 20.04, bp.Y + 5, bp.Z + 3.79, C.purple, nil, { collide = false })
	box(out, "BusWindows", bp.X - 18, bp.Y + 6.6, bp.Z - 3.81, bp.X + 18, bp.Y + 9.6, bp.Z + 3.81, Color3.fromRGB(70, 90, 120), Enum.Material.Glass, { collide = false })
	local busName = box(out, "BusName", bp.X - 14, bp.Y + 9.8, bp.Z - 3.85, bp.X + 14, bp.Y + 11.6, bp.Z - 3.81, C.white, nil, { collide = false })
	sign(busName, Enum.NormalId.Front, "STARLIGHT RECORDS ON TOUR", C.purple).Name = "LabelSign"
	for _, wx in ipairs({ -14, 12, 16 }) do
		for _, wz in ipairs({ -3.8, 3.8 }) do
			part(out, "Wheel", Vector3.new(1.2, 3.6, 3.6), CFrame.new(bp + Vector3.new(wx, 1.6, wz)) * CFrame.Angles(0, math.pi / 2, 0), C.dark, nil, { shape = Enum.PartType.Cylinder })
		end
	end
	box(out, "Boundary", XW, 40, 48, XE, 41, 104, C.white, nil, { transparency = 1 })
	Hub.buildGuide(root)
	return root
end

------------------------------------------------------------------ the stage hall as a warehouse
-- a black flight case on wheels: aluminium edges, corner caps, latches
local function flightCase(parent, pos, size, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	local w, h, d = size.X, size.Y, size.Z
	local body = part(parent, "FlightCase", Vector3.new(w, h - 0.5, d), cf * CFrame.new(0, 0.5 + (h - 0.5) / 2, 0), Color3.fromRGB(26, 26, 30), Enum.Material.SmoothPlastic)
	local al = Color3.fromRGB(178, 182, 190)
	for _, y in ipairs({ 0.5, h }) do
		part(parent, "CaseRim", Vector3.new(w + 0.08, 0.16, d + 0.08), cf * CFrame.new(0, y, 0), al, Enum.Material.Metal, { collide = false })
	end
	part(parent, "CaseMid", Vector3.new(w + 0.06, 0.12, d + 0.06), cf * CFrame.new(0, 0.5 + (h - 0.5) * 0.62, 0), al, Enum.Material.Metal, { collide = false })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part(parent, "CaseCorner", Vector3.new(0.36, 0.36, 0.36), cf * CFrame.new(sx * (w / 2 - 0.1), h - 0.06, sz * (d / 2 - 0.1)), al, Enum.Material.Metal, { collide = false })
			part(parent, "CaseWheel", Vector3.new(0.4, 0.5, 0.5), cf * CFrame.new(sx * (w / 2 - 0.5), 0.25, sz * (d / 2 - 0.5)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 40, 44), nil, { shape = Enum.PartType.Cylinder, collide = false })
		end
		part(parent, "CaseLatch", Vector3.new(0.5, 0.36, 0.08), cf * CFrame.new(sx * w * 0.25, 0.5 + (h - 0.5) * 0.62, -d / 2 - 0.05), al, Enum.Material.Metal, { collide = false })
	end
	part(parent, "CaseLabel", Vector3.new(math.min(2, w * 0.4), 0.5, 0.04), cf * CFrame.new(0, 0.5 + (h - 0.5) * 0.3, -d / 2 - 0.02), Color3.fromRGB(250, 200, 40), nil, { collide = false })
	return body
end
Hub.flightCase = flightCase

-- a pallet rack: orange uprights, blue beams, pallets with cases and boxes on three levels
local function rack(parent, x0, z0, x1, z1, levels)
	local up, beam = Color3.fromRGB(235, 120, 30), Color3.fromRGB(40, 90, 170)
	local alongX = (x1 - x0) > (z1 - z0)
	local len = alongX and (x1 - x0) or (z1 - z0)
	local bays = math.max(1, math.floor(len / 9))
	local bay = len / bays
	local rng = Random.new(math.floor(x0 * 7 + z0 * 3))
	for b = 0, bays do
		local u = b * bay
		for _, side in ipairs({ 0, 1 }) do
			local px = alongX and (x0 + u) or (side == 0 and x0 or x1)
			local pz = alongX and (side == 0 and z0 or z1) or (z0 + u)
			part(parent, "RackUpright", Vector3.new(0.4, levels * 5.6 + 0.6, 0.4), Vector3.new(px, (levels * 5.6 + 0.6) / 2, pz), up, Enum.Material.Metal)
		end
	end
	for l = 1, levels do
		local y = (l - 1) * 5.6 + 0.4
		for _, side in ipairs({ 0, 1 }) do
			if alongX then
				part(parent, "RackBeam", Vector3.new(len, 0.4, 0.3), Vector3.new((x0 + x1) / 2, y + 0.2, side == 0 and z0 or z1), beam, Enum.Material.Metal)
			else
				part(parent, "RackBeam", Vector3.new(0.3, 0.4, len), Vector3.new(side == 0 and x0 or x1, y + 0.2, (z0 + z1) / 2), beam, Enum.Material.Metal)
			end
		end
		for b = 0, bays - 1 do
			local u = (b + 0.5) * bay
			local cx = alongX and (x0 + u) or ((x0 + x1) / 2)
			local cz = alongX and ((z0 + z1) / 2) or (z0 + u)
			local depth = alongX and (z1 - z0 - 0.6) or (x1 - x0 - 0.6)
			local pw = math.min(bay - 1.2, 7)
			part(parent, "Pallet", alongX and Vector3.new(pw, 0.4, depth) or Vector3.new(depth, 0.4, pw), Vector3.new(cx, y + 0.6, cz), Color3.fromRGB(170, 130, 80), Enum.Material.WoodPlanks, { collide = false })
			local kind = rng:NextInteger(1, 3)
			if kind == 1 then
				flightCase(parent, Vector3.new(cx, y + 0.8, cz), Vector3.new(math.min(pw - 0.4, 4.6), 3.4, depth - 0.6), alongX and 0 or math.pi / 2)
			elseif kind == 2 then
				for k = 0, 2 do
					local bh = 1.5 + k * 0.1
					part(parent, "Box", alongX and Vector3.new(1.9, bh, depth - 0.8) or Vector3.new(depth - 0.8, bh, 1.9), Vector3.new(cx + (alongX and (k - 1) * 2.1 or 0), y + 0.8 + bh / 2, cz + (alongX and 0 or (k - 1) * 2.1)), Color3.fromRGB(196, 160, 110), Enum.Material.Cardboard, { collide = false })
				end
			else
				part(parent, "CableReel", Vector3.new(depth - 1, 2.8, 2.8), Vector3.new(cx, y + 2.2, cz) - Vector3.new(0, 0, 0), Color3.fromRGB(30, 30, 34), nil, { shape = Enum.PartType.Cylinder, collide = false }).CFrame = CFrame.new(O + Vector3.new(cx, y + 2.2, cz)) * CFrame.Angles(0, alongX and math.pi / 2 or 0, 0)
			end
		end
	end
end

-- a yellow forklift (the client drives it along Hub.FORKLIFT_PATH)
function Hub.buildForklift(parent)
	local m = new("Model", { Name = "Forklift" }, parent)
	local yellow, dark = Color3.fromRGB(245, 190, 30), Color3.fromRGB(30, 30, 34)
	-- built facing -Z (the forks at the front), turned to drive along the lane (+X)
	local cf = CFrame.new(Hub.FORKLIFT_PATH[1]) * CFrame.Angles(0, -math.pi / 2, 0)
	local function p(name, size, off, color, mat, opts)
		return part(m, name, size, cf * off, color, mat, opts)
	end
	local body = p("ForkliftBody", Vector3.new(4.4, 2.4, 6), CFrame.new(0, 1.9, 0.6), yellow)
	p("Counterweight", Vector3.new(4.56, 2.6, 1.4), CFrame.new(0, 2, 3.8), dark)
	p("Seat", Vector3.new(2, 0.6, 1.8), CFrame.new(0, 3.4, 1.4), dark)
	p("SeatBack", Vector3.new(1.86, 1.8, 0.4), CFrame.new(0, 4.3, 2.3), dark)
	p("Wheel", Vector3.new(0.9, 1.8, 1.8), CFrame.new(0, 1, -1.6) * CFrame.Angles(0, 0, 0), dark)
	for _, sx in ipairs({ -1, 1 }) do
		p("WheelL", Vector3.new(0.9, 1.9, 1.9), CFrame.new(sx * 2.35, 0.95, -1.6) * CFrame.Angles(0, 0, math.pi / 2), dark, nil, { shape = Enum.PartType.Cylinder, collide = false })
		p("WheelR", Vector3.new(0.9, 1.6, 1.6), CFrame.new(sx * 2.35, 0.8, 2.8) * CFrame.Angles(0, 0, math.pi / 2), dark, nil, { shape = Enum.PartType.Cylinder, collide = false })
		p("CabPost", Vector3.new(0.25, 4.4, 0.25), CFrame.new(sx * 2, 5.3, -0.6), dark, Enum.Material.Metal, { collide = false })
		p("CabPost", Vector3.new(0.25, 4.4, 0.25), CFrame.new(sx * 2, 5.3, 3), dark, Enum.Material.Metal, { collide = false })
		p("Mast", Vector3.new(0.4, 8, 0.5), CFrame.new(sx * 1.4, 4.6, -2.7), Color3.fromRGB(60, 60, 66), Enum.Material.Metal)
		p("Fork", Vector3.new(0.4, 0.2, 4), CFrame.new(sx * 1.1, 0.5, -4.9), Color3.fromRGB(60, 60, 66), Enum.Material.Metal)
		p("ForkBack", Vector3.new(0.5, 2.4, 0.2), CFrame.new(sx * 1.1, 1.6, -2.95), Color3.fromRGB(60, 60, 66), Enum.Material.Metal)
	end
	p("CabRoof", Vector3.new(4.4, 0.2, 4), CFrame.new(0, 7.6, 1.2), dark, Enum.Material.Metal, { collide = false })
	p("Beacon", Vector3.new(0.5, 0.4, 0.5), CFrame.new(0, 7.9, 1.2), Color3.fromRGB(255, 140, 20), Enum.Material.Neon, { collide = false })
	p("PalletOnForks", Vector3.new(3.6, 0.4, 3.6), CFrame.new(0, 0.85, -5), Color3.fromRGB(170, 130, 80), Enum.Material.WoodPlanks, { collide = false })
	flightCase(m, (cf * CFrame.new(0, 1.05, -5)).Position, Vector3.new(3.2, 2.6, 3.2), 0)
	m.PrimaryPart = body
	return m
end

function Hub.buildWarehouse(hall)
	local wh = new("Folder", { Name = "Warehouse" }, hall)
	-- racks along the right wall and the front wall
	rack(wh, 116, -6, 120, 42, 3)
	rack(wh, 60, 40, 100, 44, 3)
	-- flight cases by the door, some stacked
	local cases = { { 46.5, 34, 4.5, 3.6, 3.4 }, { 51.5, 34, 4.5, 3.6, 3.4 }, { 46.5, 39, 4.5, 3.6, 3.4 }, { 51.5, 39.2, 4.5, 4.2, 3.4 } }
	for _, c in ipairs(cases) do
		flightCase(wh, Vector3.new(c[1], 0, c[2]), Vector3.new(c[3], c[4], c[5]), 0)
	end
	flightCase(wh, Vector3.new(46.5, 3.6, 34), Vector3.new(4.2, 3, 3.2), 0)
	flightCase(wh, Vector3.new(46.5, 3.6, 39), Vector3.new(4.2, 2.6, 3.2), 0)
	-- truss pieces lying on the floor, cable reels
	for k = 0, 2 do
		part(wh, "TrussPiece", Vector3.new(18, 1.6, 1.6), Vector3.new(74, 0.8 + k * 1.62, 31), C.grey, Enum.Material.DiamondPlate, { collide = true })
	end
	for _, x in ipairs({ 90, 94.5 }) do
		part(wh, "CableReel", Vector3.new(2.4, 3.6, 3.6), CFrame.new(Vector3.new(x, 1.8, 33)) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(120, 76, 40), Enum.Material.Wood, { shape = Enum.PartType.Cylinder })
	end
	Hub.buildForklift(wh)
end

------------------------------------------------------------------ Sam, the guide of the tutorial
-- A real Roblox character (R15, made from a HumanoidDescription) in office clothes with hair, glasses,
-- a lanyard and a clipboard. The client moves and animates it (Client/Tutorial.lua).
local GUIDE = {
	skin = Color3.fromRGB(205, 150, 110),
	shirt = Color3.fromRGB(245, 245, 248),
	jacket = Color3.fromRGB(40, 58, 102),
	pants = Color3.fromRGB(46, 48, 58),
	shoes = Color3.fromRGB(70, 44, 30),
	hair = Color3.fromRGB(56, 36, 24),
}
local function weld(model, name, size, cf, color, base, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = base.CFrame * cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	return p
end
function Hub.buildGuide(root)
	local model
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = GUIDE.skin
		desc.TorsoColor = GUIDE.shirt
		desc.LeftArmColor = GUIDE.jacket
		desc.RightArmColor = GUIDE.jacket
		desc.LeftLegColor = GUIDE.pants
		desc.RightLegColor = GUIDE.pants
		model = game:GetService("Players"):CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		model.Name = "Guide"
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
		local function bp(n)
			return model:FindFirstChild(n)
		end
		-- hands in skin colour, shoes, a jacket over the white shirt
		for _, n in ipairs({ "LeftHand", "RightHand" }) do
			if bp(n) then
				bp(n).Color = GUIDE.skin
			end
		end
		for _, n in ipairs({ "LeftFoot", "RightFoot" }) do
			if bp(n) then
				bp(n).Color = GUIDE.shoes
			end
		end
		for _, n in ipairs({ "LowerTorso" }) do
			if bp(n) then
				bp(n).Color = GUIDE.pants
			end
		end
		local head, torso = bp("Head"), bp("UpperTorso")
		if head and not head:FindFirstChildOfClass("Decal") then
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = head
		end
		if head then
			-- hair: a short cut with a side part, glasses
			weld(model, "Hair", Vector3.new(1.32, 0.42, 1.3), CFrame.new(0, 0.56, 0.02), GUIDE.hair, head)
			weld(model, "HairBack", Vector3.new(1.3, 0.8, 0.3), CFrame.new(0, 0.18, 0.56), GUIDE.hair, head)
			weld(model, "HairSide", Vector3.new(0.18, 0.55, 1.1), CFrame.new(-0.62, 0.3, 0.08), GUIDE.hair, head)
			weld(model, "HairSide", Vector3.new(0.18, 0.55, 1.1), CFrame.new(0.62, 0.3, 0.08), GUIDE.hair, head)
			weld(model, "HairFringe", Vector3.new(0.9, 0.22, 0.25), CFrame.new(-0.18, 0.42, -0.56) * CFrame.Angles(0, 0, math.rad(-8)), GUIDE.hair, head)
			for _, sx in ipairs({ -0.24, 0.24 }) do
				weld(model, "GlassRim", Vector3.new(0.36, 0.26, 0.04), CFrame.new(sx, 0.12, -0.62), Color3.fromRGB(20, 20, 24), head)
			end
			weld(model, "GlassBridge", Vector3.new(0.14, 0.05, 0.04), CFrame.new(0, 0.18, -0.63), Color3.fromRGB(20, 20, 24), head)
		end
		if torso then
			-- jacket fronts (the white shirt shows in the middle), collar, lanyard and badge
			local tw = torso.Size
			for _, sx in ipairs({ -1, 1 }) do
				weld(model, "Jacket", Vector3.new(tw.X * 0.36, tw.Y * 1.02, 0.12), CFrame.new(sx * tw.X * 0.33, 0, -tw.Z / 2 - 0.02), GUIDE.jacket, torso)
				weld(model, "JacketSide", Vector3.new(0.12, tw.Y * 1.02, tw.Z * 1.02), CFrame.new(sx * (tw.X / 2 + 0.03), 0, 0), GUIDE.jacket, torso)
			end
			weld(model, "JacketBack", Vector3.new(tw.X * 1.02, tw.Y * 1.02, 0.12), CFrame.new(0, 0, tw.Z / 2 + 0.03), GUIDE.jacket, torso)
			weld(model, "Collar", Vector3.new(tw.X * 0.5, 0.16, 0.5), CFrame.new(0, tw.Y / 2 + 0.02, -0.12), GUIDE.shirt, torso)
			weld(model, "Lanyard", Vector3.new(0.08, tw.Y * 0.5, 0.04), CFrame.new(0, tw.Y * 0.18, -tw.Z / 2 - 0.1), Color3.fromRGB(37, 99, 235), torso)
			weld(model, "Badge", Vector3.new(0.4, 0.5, 0.04), CFrame.new(0, -tw.Y * 0.12, -tw.Z / 2 - 0.11), Color3.fromRGB(250, 250, 252), torso)
		end
		local lh = bp("LeftHand")
		if lh then
			-- a clipboard with a sheet of paper
			weld(model, "Clipboard", Vector3.new(0.9, 1.2, 0.08), CFrame.new(0, -0.1, -0.35) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(150, 110, 70), lh, Enum.Material.Wood)
			weld(model, "Paper", Vector3.new(0.75, 0.95, 0.02), CFrame.new(0, -0.15, -0.41) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(250, 250, 252), lh)
		end
		local rh = bp("RightHand")
		if rh then
			weld(model, "Watch", Vector3.new(0.36, 0.14, 0.36), CFrame.new(0, 0.32, 0), Color3.fromRGB(30, 30, 34), rh)
		end
		local hrp = model:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.Anchored = true
			model.PrimaryPart = hrp
			local hh = (hum and hum.HipHeight or 2) + hrp.Size.Y / 2
			model:SetAttribute("RootHeight", hh)
			model:PivotTo(CFrame.new(O + Hub.GUIDE_SPOTS.start + Vector3.new(0, hh, 0)) * CFrame.Angles(0, math.rad(-120), 0))
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
			end
		end
		model.Parent = root
		return model
	end
	-- no character service (tests): a simple figure from parts
	model = Instance.new("Model")
	model.Name = "Guide"
	local base = CFrame.new(O + Hub.GUIDE_SPOTS.start)
	local function p(name, size, y, color)
		local q = part(model, name, size, base * CFrame.new(0, y, 0) - O, color, nil, { collide = false })
		return q
	end
	local hrp = p("HumanoidRootPart", Vector3.new(2, 2, 1), 3, GUIDE.shirt)
	hrp.Transparency = 1
	p("Torso", Vector3.new(2, 2, 1), 3, GUIDE.jacket)
	p("Head", Vector3.new(1.2, 1.2, 1.2), 4.6, GUIDE.skin)
	p("Legs", Vector3.new(2, 2, 1), 1, GUIDE.pants)
	model.PrimaryPart = hrp
	model:SetAttribute("RootHeight", 3)
	model.Parent = root
	return model
end

return Hub
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX1B61470AD6304C86B3F88A165896A796"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteFunction" referent="RBXA56F9EFCD63149FC888903A3748970B7"><Properties><string name="Name">Action</string></Properties></Item>
