}

Countries.byId = {}
Countries.venueById = {}
for _, c in ipairs(Countries.list) do
	table.sort(c.venues, function(a, b)
		return a.cap < b.cap
	end)
	Countries.byId[c.id] = c
	for _, v in ipairs(c.venues) do
		v.countryId = c.id
		Countries.venueById[v.id] = v
	end
end

return Countries
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2DADD2DA4A5347588CE79897268D626F"><Properties><string name="Name">Regions</string><ProtectedString name="Source"><![CDATA[-- World regions. Artists have a fan count per region.
local Regions = {
	list = {
		{ id = "EU", name = "Europe" },
		{ id = "NA", name = "North America" },
		{ id = "LATAM", name = "Latin America" },
		{ id = "ASIA", name = "Asia" },
		{ id = "OCE", name = "Oceania" },
		{ id = "MEA", name = "Middle East & Africa" },
	},
	byId = {},
}

for _, r in ipairs(Regions.list) do
	Regions.byId[r.id] = r
end

return Regions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXC710B9A593A4431A93F7B08D229E75DA"><Properties><string name="Name">Reviews</string><ProtectedString name="Source"><![CDATA[-- Review quotes by star rating. {artist} {venue} {city} are replaced.
return {
	[1] = {
		"\"A night to forget. {artist} looked lost at {venue}.\"",
		"\"Half-hearted, half-empty, fully disappointing.\"",
	},
	[2] = {
		"\"{artist} had moments, but the show never took off.\"",
		"\"Flat production and a sleepy crowd in {city}.\"",
	},
	[3] = {
		"\"Solid set from {artist}. Fans went home happy.\"",
		"\"A decent night out at {venue}. Nothing more, nothing less.\"",
	},
	[4] = {
		"\"{artist} owned {venue} tonight. Big energy!\"",
		"\"Slick production, huge singalongs. {city} loved it.\"",
	},
	[5] = {
		"\"A masterpiece. {artist} just played the show of the year!\"",
		"\"Jaw-dropping. {venue} will be talking about this for years.\"",
		"\"Pure magic in {city}. Book your tickets for the next one NOW.\"",
	},
}
]]></ProtectedString></Properties></Item>
