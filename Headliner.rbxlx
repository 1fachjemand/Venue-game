<Item class="ModuleScript" referent="RBX4FB0F53AA2414FD4B0C4E962373F5EAB"><Properties><string name="Name">Regions</string><ProtectedString name="Source"><![CDATA[-- World regions. Artists have a fan count per region.
local Regions = {
	list = {
		{ id = "EU", name = "Europe" },
		{ id = "NA", name = "North America" },
		{ id = "LATAM", name = "Latin America" },
		{ id = "ASIA", name = "Asia" },
		{ id = "OCE", name = "Oceania" },
		{ id = "MEA", name = "Middle East & Africa" },
	},
	byId = {},
}

for _, r in ipairs(Regions.list) do
	Regions.byId[r.id] = r
end

return Regions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX1D0EAC73293E4100A082097463ABD630"><Properties><string name="Name">Reviews</string><ProtectedString name="Source"><![CDATA[-- Review quotes by star rating. {artist} {venue} {city} are replaced.
return {
	[1] = {
		"\"A night to forget. {artist} looked lost at {venue}.\"",
		"\"Half-hearted, half-empty, fully disappointing.\"",
	},
	[2] = {
		"\"{artist} had moments, but the show never took off.\"",
		"\"Flat production and a sleepy crowd in {city}.\"",
	},
	[3] = {
		"\"Solid set from {artist}. Fans went home happy.\"",
		"\"A decent night out at {venue}. Nothing more, nothing less.\"",
	},
	[4] = {
		"\"{artist} owned {venue} tonight. Big energy!\"",
		"\"Slick production, huge singalongs. {city} loved it.\"",
	},
	[5] = {
		"\"A masterpiece. {artist} just played the show of the year!\"",
		"\"Jaw-dropping. {venue} will be talking about this for years.\"",
		"\"Pure magic in {city}. Book your tickets for the next one NOW.\"",
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXB1C9111935AB4D80B1226ED31BA7473D"><Properties><string name="Name">Rivals</string><ProtectedString name="Source"><![CDATA[-- Fictional rival tours for the "Top Grossing Tours" chart. Beat them all!
return {
	{ artist = "Aurora Vale", tour = "The Celestial Tour", gross = 520000000, shows = 120, attendance = 6100000 },
	{ artist = "The Midnight Kings", tour = "Crown & Glory Tour", gross = 410000000, shows = 88, attendance = 4200000 },
	{ artist = "Bella Ricci", tour = "Dolce Vita World Tour", gross = 330000000, shows = 95, attendance = 3600000 },
	{ artist = "SKYLINE", tour = "Beyond the Skyline", gross = 255000000, shows = 60, attendance = 2400000 },
	{ artist = "Marcus Gold", tour = "Gold Standard Tour", gross = 198000000, shows = 70, attendance = 2000000 },
	{ artist = "Echo Theory", tour = "Resonance Tour", gross = 142000000, shows = 64, attendance = 1500000 },
	{ artist = "Rosa Delgado", tour = "Corazon Tour", gross = 96000000, shows = 55, attendance = 1200000 },
	{ artist = "Thunder Ridge", tour = "Back Roads Tour", gross = 71000000, shows = 48, attendance = 950000 },
	{ artist = "Pixel Hearts", tour = "8-Bit Love Tour", gross = 44000000, shows = 40, attendance = 600000 },
	{ artist = "Static Bloom", tour = "Overgrown Tour", gross = 23000000, shows = 52, attendance = 400000 },
	{ artist = "Neon Saints", tour = "Saints Alive", gross = 9500000, shows = 38, attendance = 210000 },
	{ artist = "Paper Lanterns", tour = "Glow Tour", gross = 2800000, shows = 30, attendance = 90000 },
	{ artist = "The Weekend Plans", tour = "Small Rooms Tour", gross = 600000, shows = 24, attendance = 30000 },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7E22E7EA90EA4348B6090BF425FEA6A4"><Properties><string name="Name">Social</string><ProtectedString name="Source"><![CDATA[-- Fan posts for the SOCIAL feed. Placeholders: {artist} {venue} {city} {country} {tour} {song} {price} {tag} {item} {label}
-- mood: 1 = positive, 0 = neutral, -1 = negative. photo = the post shows a concert photo.
local Social = {}

Social.FIRST = {
	"Mia", "Leo", "Emma", "Noah", "Zoe", "Liam", "Ava", "Kai", "Lena", "Max", "Sofia", "Jonas", "Aria", "Finn", "Chloe", "Mateo",
	"Yuna", "Ben", "Lucia", "Tom", "Nora", "Elias", "Hana", "Sam", "Ines", "Ravi", "Maya", "Oscar", "Lea", "Diego", "Ivy", "Jae",
}
Social.HANDLE_A = { "lunar", "neon", "starry", "velvet", "indie", "popcorn", "midnight", "glitter", "sunset", "moshpit", "frontrow", "golden", "electric", "sugar", "echo", "cosmic", "vinyl", "encore", "barricade", "confetti" }
Social.HANDLE_B = { "girl", "kid", "fan", "lover", "vibes", "era", "daily", "stan", "club", "x", "99", "2027", "heart", "soul", "times", "updates" }

Social.POSTS = {
	announce = {
		{ 1, "{artist} JUST ANNOUNCED {tour}!!! I'm not okay" },
		{ 1, "Tickets for {artist} in {city}?? Setting 12 alarms for the presale" },
		{ 1, "{artist} coming to {city} is the best news of the year {tag}" },
		{ 1, "Already planning my outfit for {artist} in {city}" },
		{ 0, "{tour} dates are out. Who's going to {venue}?" },
		{ -1, "{artist} skipping my country AGAIN. Please come to {country}" },
		{ 0, "Me refreshing the ticket page every 3 seconds for {artist}" },
		{ 1, "Screenshot or it didn't happen: {artist} {tour} poster is HERE" },
		{ 1, "Booking the hotel in {city} before I even have tickets. Priorities" },
		{ 0, "Presale code for {artist}? Asking for me" },
		{ 1, "The {tour} poster is so pretty I want it framed" },
		{ 1, "{city} we are SO back. {artist} is coming {tag}" },
		{ 0, "Who wants to road trip to {city} for {artist}? I have snacks" },
		{ -1, "Why is {artist} only doing one night in {city}??" },
		{ 1, "Told my boss I'm sick on the day of {artist} in {city}. Already." },
	},
	price_high = {
		{ -1, "{price} for {artist}?? My wallet is crying" },
		{ -1, "Love {artist} but {price} a ticket is a lot. Hope it's worth it" },
		{ -1, "Ticket prices for {tour} are wild. Students can't afford this" },
		{ -1, "VIP for {artist} costs more than my rent. No thanks" },
		{ -1, "{price} plus fees... the fees are the real villain here" },
		{ 0, "Saving every coin for {tour}. Instant noodles for a month" },
		{ -1, "Remember when concerts were affordable? {label} please" },
	},
	price_low = {
		{ 1, "Only {price} for {artist}? That's actually fair. Buying two!" },
		{ 1, "Respect to {label} for keeping tickets affordable" },
		{ 1, "Fair prices for {tour}! Bringing my little sister" },
		{ 1, "{price} for {artist}?? Fans first, love that" },
		{ 1, "Cheap enough to go twice. Two nights in {city} it is" },
	},
	soldout = {
		{ 1, "{venue} SOLD OUT for {artist}! We did that {tag}" },
		{ 1, "Got my tickets for {city} before it sold out. Still shaking" },
		{ -1, "Sold out in minutes and I got nothing. Please add a second night in {city}!" },
		{ -1, "Resale prices for {artist} in {city} are criminal" },
		{ 0, "{artist} sold out {venue}. Next stop: stadiums?" },
		{ 1, "Ticket secured. Section 112, row 4. See you {city}!" },
		{ 1, "Waiting room: 48,000 people ahead of me... and I GOT THEM" },
		{ -1, "Website crashed right when I clicked buy. Pain." },
		{ 1, "{artist} at {venue} SOLD OUT. Proud of this fandom" },
		{ 0, "Anyone selling a ticket for {city} at face value? Please" },
	},
	lowsales = {
		{ -1, "Lots of tickets still left for {artist} at {venue}... come on {city}!" },
		{ 0, "Is anyone else going to {artist} in {city}? Want to meet up!" },
		{ -1, "Maybe {venue} was a bit too big for {artist} right now" },
		{ 0, "Tickets for {artist} in {city} still available. Last chance!" },
		{ -1, "Upper tier at {venue} is still empty for {artist}. Weird" },
		{ 0, "Good seats still left for {artist} in {city}, just saying" },
		{ -1, "{artist} needs a smaller venue in {city} honestly" },
	},
	show_great = {
