<Item class="Folder" referent="RBX33A8F3F7C92A434EBB626F259C931BAD"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBX35912A736F744D4090EA87B49301C0D9"><Properties><string name="Name">GameState</string><ProtectedString name="Source"><![CDATA[-- Game state: everything that gets saved. Pure Lua (no Roblox APIs).
local Root = script:FindFirstAncestor("Headliner")
local Config = require(Root.Config)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local StageItems = require(Root.Data.StageItems)
local Achievements = require(Root.Data.Achievements)
local Rivals = require(Root.Data.Rivals)
local Util = require(Root.Logic.Util)
local Sim = require(Root.Logic.Sim)
local Social = require(Root.Logic.Social)

local GS = {}

------------------------------------------------------------------ creation
function GS.freshArtist(ad)
	return {
		id = ad.id,
		signed = false,
		fans = Util.deepCopy(ad.fans),
		hype = ad.hype,
		lastPlayed = {},
		shows = 0,
		gross = 0,
	}
end

function GS.newId(state, prefix)
	local id = prefix .. tostring(state.nextId)
	state.nextId = state.nextId + 1
	return id
end

function GS.log(state, text)
	table.insert(state.log, 1, { day = state.day, text = text })
	while #state.log > 40 do
		table.remove(state.log)
	end
end

function GS.new(labelName, starterId)
	local state = {
		version = Config.SAVE_VERSION,
		labelName = labelName or Config.DEFAULT_LABEL_NAME,
		money = Config.START_MONEY,
		day = 0,
		artists = {},
		designs = {},
		tours = {},
		nextId = 1,
		achievements = {},
		log = {},
		social = {},
		levelSeen = 1,
		stats = {
			shows = 0,
			sellouts = 0,
			tickets = 0,
			totalGross = 0,
			bestShowGross = 0,
			bestShowText = "",
			biggestSellout = 0,
			fiveStars = 0,
			bestTourGross = 0,
			maxRegions = 0,
		},
	}
	for _, ad in ipairs(Artists.list) do
		state.artists[ad.id] = GS.freshArtist(ad)
	end
	local starter = Artists.byId[starterId or ""] or Artists.byId.lila
	state.artists[starter.id].signed = true
	for _, p in ipairs(StageItems.PRESETS) do
		if not p.shop then
			GS.addDesign(state, p.name, Util.deepCopy(p.items), p.class, p.layout).template = p.name
		end
	end
	GS.log(state, state.labelName .. " opens its doors with " .. starter.name .. " on the roster.")
	return state
end

-- Repairs / upgrades a loaded save so missing fields never crash the game
function GS.sanitize(data)
	if type(data) ~= "table" or data.version ~= Config.SAVE_VERSION then
		return GS.new()
	end
	local fresh = GS.new()
	for k, v in pairs(fresh) do
		if type(data[k]) ~= type(v) then
			data[k] = v
		end
	end
	for k, v in pairs(fresh.stats) do
		if type(data.stats[k]) ~= type(v) then
			data.stats[k] = v
		end
	end
	for _, ad in ipairs(Artists.list) do
		local a = data.artists[ad.id]
		if type(a) ~= "table" then
			data.artists[ad.id] = GS.freshArtist(ad)
		else
			a.fans = type(a.fans) == "table" and a.fans or Util.deepCopy(ad.fans)
			for rid, n in pairs(ad.fans) do
				if type(a.fans[rid]) ~= "number" then
					a.fans[rid] = n
				end
			end
			a.lastPlayed = type(a.lastPlayed) == "table" and a.lastPlayed or {}
			a.hype = type(a.hype) == "number" and a.hype or ad.hype
			a.shows = a.shows or 0
			a.gross = a.gross or 0
		end
	end
	for _, d in ipairs(data.designs) do
		if type(d.items) ~= "table" then
			d.items = {}
		end
	end
	if #data.designs == 0 then
		GS.addDesign(data, "My Design", {}, "Club", "end")
	end
	return data
end

------------------------------------------------------------------ artists
function GS.signedArtists(state)
	local out = {}
	for _, ad in ipairs(Artists.list) do
		if state.artists[ad.id].signed then
			table.insert(out, ad)
		end
	end
	return out
end

function GS.unsignedArtists(state)
	local out = {}
	for _, ad in ipairs(Artists.list) do
		if not state.artists[ad.id].signed then
			table.insert(out, ad)
		end
	end
	return out
end

function GS.activeTour(state, artistId)
	for _, t in ipairs(state.tours) do
		if t.artistId == artistId and t.status ~= "done" then
			return t
		end
	end
	return nil
end

function GS.level(state)
	local lvl = 1
	for i, l in ipairs(Config.LEVELS) do
		if state.stats.tickets >= l.tickets then
			lvl = i
		end
	end
	return lvl, Config.LEVELS[lvl], Config.LEVELS[lvl + 1]
end

function GS.sign(state, artistId)
	local ad = Artists.byId[artistId]
	local a = state.artists[artistId]
	if not ad or a.signed then
		return false, "Already signed."
	end
	if ad.level > GS.level(state) then
		return false, ad.name .. " only talks to a " .. Config.LEVELS[ad.level].name .. " (level " .. ad.level .. ")."
	end
	if state.money < ad.signCost then
		return false, "Not enough money to sign " .. ad.name .. "."
	end
	state.money = state.money - ad.signCost
	a.signed = true
	GS.log(state, "Signed " .. ad.name .. " for " .. Util.money(ad.signCost) .. "!")
	Social.add(state, "sign", { artistId = ad.id }, 2)
	return true, ad.name .. " joined your label!"
end

------------------------------------------------------------------ designs
function GS.addDesign(state, name, items, class, layout)
	local d = { id = GS.newId(state, "d"), name = name, items = items or {}, class = class or "Arena", layout = layout or "end" }
	table.insert(state.designs, d)
	return d
end

-- A new design built from a template (pays for the equipment). Returns design or nil, message
function GS.addDesignFromTemplate(state, preset, name)
	local cost = GS.designValue({ items = preset.items })
	if state.money < cost then
		return nil, "This template needs equipment worth " .. Util.money(cost) .. "."
	end
	if #state.designs >= Config.MAX_DESIGNS then
		return nil, "You can have up to " .. Config.MAX_DESIGNS .. " stages. Delete one first."
	end
	state.money = state.money - cost
	return GS.addDesign(state, name or preset.name, Util.deepCopy(preset.items), preset.class, preset.layout)
end

-- number of songs a design plays (= artist spots, at least 3, no spots = 4)
function GS.songCount(design)
	local n = 0
	for _, it in ipairs((design and design.items) or {}) do
		if it.t == "spot" then
			n = n + 1
		end
	end
	if n == 0 then
		return 4
	end
	return Util.clamp(n, 3, StageItems.MAX_SPOTS)
end

-- Show days of a route: another night in the same venue is the next day, a new venue `gap` days later
function GS.scheduleDays(startDay, shows, gap)
	local days = {}
	for i, s in ipairs(shows) do
		if i == 1 then
			days[i] = startDay
		elseif shows[i - 1].venueId == s.venueId then
			days[i] = days[i - 1] + 1
		else
			days[i] = days[i - 1] + gap
		end
	end
	return days
end

-- Buying / selling stage equipment
function GS.buyItem(state, design, rec)
	local def = StageItems.byId[rec.t]
	local price = Sim.itemPrice(def, rec)
	if state.money < price then
		return false, "Not enough money for " .. def.name .. " (" .. Util.money(price) .. ")."
	end
	state.money = state.money - price
	table.insert(design.items, rec)
	return true
end

function GS.sellItem(state, design, rec)
	for i, r in ipairs(design.items) do
		if r == rec then
			table.remove(design.items, i)
			state.money = state.money + Util.round(Sim.itemPrice(StageItems.byId[rec.t], rec) * Config.RESALE)
			return true
		end
	end
	return false
end

-- Changes size/height of a placed item and pays (or refunds) the price difference
function GS.changeItem(state, rec, changes)
	local def = StageItems.byId[rec.t]
	local old = Sim.itemPrice(def, rec)
	local test = Util.deepCopy(rec)
	for k, v in pairs(changes) do
		test[k] = v
	end
	local diff = Sim.itemPrice(def, test) - old
	if diff > 0 and state.money < diff then
		return false, "Not enough money (" .. Util.money(diff) .. " needed)."
	end
	state.money = state.money - (diff > 0 and diff or Util.round(diff * Config.RESALE))
	for k, v in pairs(changes) do
		rec[k] = v
	end
	return true
end

function GS.designValue(design)
	return Sim.designStats(design, nil).value
end

-- stage size class of a venue: "Club" | "Theatre" | "Arena" | "Stadium"
function GS.venueClass(venue)
	return Countries.VENUE_TYPES[venue.type].stage
end

-- the production used for one show of a tour
function GS.showDesign(state, tour, idx)
	local v = Countries.venueById[tour.shows[idx].venueId]
	local id = tour.designs and tour.designs[GS.venueClass(v)] or tour.designId
	return GS.getDesign(state, id) or GS.getDesign(state, tour.designId)
end

function GS.getDesign(state, id)
	for _, d in ipairs(state.designs) do
		if d.id == id then
			return d
		end
	end
	return nil
end

function GS.designInUse(state, id)
	for _, t in ipairs(state.tours) do
		local used = t.designId == id
		for _, did in pairs(t.designs or {}) do
			if did == id then
				used = true
			end
		end
		if used and t.status ~= "done" then
			return true
		end
	end
	return false
end

function GS.deleteDesign(state, id)
	if GS.designInUse(state, id) then
		return false, "This design is used by an active tour."
	end
	if #state.designs <= 1 then
		return false, "You need at least one design."
	end
	local target = GS.getDesign(state, id)
	if target and target.template then
		return false, "Templates can't be deleted. Use CLEAR to remove what you built."
	end
	for i, d in ipairs(state.designs) do
		if d.id == id then
			table.remove(state.designs, i)
			state.money = state.money + Util.round(GS.designValue(d) * Config.RESALE)
			return true
		end
	end
	return false, "Design not found."
end

------------------------------------------------------------------ tours
function GS.getTour(state, id)
	for _, t in ipairs(state.tours) do
		if t.id == id then
			return t
		end
	end
	return nil
end

function GS.tourCapacity(tour)
	local c = 0
	for _, s in ipairs(tour.shows) do
		c = c + s.cap
	end
	return c
end

function GS.marketingCost(tour, mk)
	return Util.round(mk.base + mk.perSeat * GS.tourCapacity(tour))
end

-- draft = { artistId, name, designId, firstIn, gap, watchFirst, shows = { {venueId, price} } }
function GS.createTour(state, draft)
	local ad = Artists.byId[draft.artistId or ""]
	if not ad or not state.artists[ad.id].signed then
		return false, "Pick an artist first."
	end
	if GS.activeTour(state, ad.id) then
		return false, ad.name .. " is already on tour."
	end
	if #draft.shows == 0 then
		return false, "Add at least one show (click a country, then + Add)."
	end
	if #draft.shows > Config.MAX_SHOWS_PER_TOUR then
		return false, "Too many shows (max " .. Config.MAX_SHOWS_PER_TOUR .. ")."
	end
	if state.money <= 0 then
		return false, "You are in debt! Earn money before announcing a new tour."
	end
	-- one stage production per venue size (club / theatre / arena / stadium)
	local designs = {}
	for _, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		local vc = GS.venueClass(v)
		local d = GS.getDesign(state, (draft.designs and draft.designs[vc]) or draft.designId or "")
		if not d then
			return false, "Pick a stage design for your " .. vc .. " venues."
		end
		if not Sim.designFits(d, v) then
			return false, "\"" .. d.name .. "\" (" .. d.class .. " stage) is too big for " .. v.name .. "."
		end
		designs[vc] = d.id
	end
	local design = GS.getDesign(state, designs[GS.venueClass(Countries.venueById[draft.shows[1].venueId])])
	local firstIn = Util.clamp(math.floor(draft.firstIn or Config.MIN_LEAD_DAYS), Config.MIN_LEAD_DAYS, Config.MAX_LEAD_DAYS)
	local gap = Util.clamp(math.floor(draft.gap or 2), 1, Config.MAX_GAP_DAYS)
	local name = draft.name
	if type(name) ~= "string" or name:gsub("%s", "") == "" then
		name = ad.name .. " World Tour"
	end

	local tour = {
		id = GS.newId(state, "t"),
		artistId = ad.id,
		name = name:sub(1, 40),
		price = math.max(5, math.floor(draft.price or 30)),
		designId = design.id,
		designs = designs,
		status = "announced",
		announcedDay = state.day,
		marketing = {},
		shows = {},
		gross = 0,
		net = 0,
		attendance = 0,
		sellouts = 0,
		played = 0,
		ratingSum = 0,
	}
	local prev = nil
	local days = GS.scheduleDays(state.day + firstIn, draft.shows, gap)
	for i, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		table.insert(tour.shows, {
			venueId = v.id,
			countryId = v.countryId,
			cap = v.cap,
			price = math.max(5, math.floor(draft.price or s.price or 30)),
			day = days[i],
			sold = 0,
			noise = 1 - Config.DEMAND_NOISE + math.random() * 2 * Config.DEMAND_NOISE,
			travel = Sim.travelCost(prev, v, #(GS.getDesign(state, designs[GS.venueClass(v)]) or design).items),
			done = false,
			watch = (i == 1) and (draft.watchFirst == true),
		})
		prev = v
	end
	table.insert(state.tours, 1, tour)
	Sim.updateTourSales(state, tour)
	GS.log(state, ad.name .. " announced \"" .. tour.name .. "\" (" .. #tour.shows .. " shows).")
	Social.onAnnounce(state, tour, Sim.ticketBase(state, ad.id))
	return true, tour
end

function GS.buyMarketing(state, tourId, mid)
	local tour = GS.getTour(state, tourId)
	if not tour or tour.status == "done" then
		return false, "Tour not active."
	end
	for _, mk in ipairs(Config.MARKETING) do
		if mk.id == mid then
			if tour.marketing[mid] then
				return false, "Already running."
			end
			local cost = GS.marketingCost(tour, mk)
			if state.money < cost then
				return false, "Not enough money."
			end
			state.money = state.money - cost
			tour.marketing[mid] = true
			Sim.updateTourSales(state, tour)
			return true, mk.name .. " campaign started (" .. Util.money(cost) .. ")."
		end
	end
	return false, "Unknown campaign."
end

function GS.setPrice(state, tourId, idx, price)
	local tour = GS.getTour(state, tourId)
	local s = tour and tour.shows[idx]
	if not s or s.done then
		return
	end
	s.price = Util.clamp(math.floor(price), 5, 2000)
	Sim.updateTourSales(state, tour)
end

-- One ticket price for the whole tour (only unplayed shows change)
function GS.setTourPrice(state, tourId, price)
	local tour = GS.getTour(state, tourId)
	if not tour or tour.status == "done" then
		return
	end
	tour.price = Util.clamp(math.floor(price), 5, 2000)
	for _, s in ipairs(tour.shows) do
		if not s.done then
			s.price = tour.price
		end
	end
	Sim.updateTourSales(state, tour)
end

function GS.cancelTour(state, tourId)
	local tour = GS.getTour(state, tourId)
	if not tour then
		return false, "Tour not found."
	end
	if tour.played > 0 then
		return false, "Shows were already played. You can't cancel anymore."
	end
	for i, t in ipairs(state.tours) do
		if t == tour then
			table.remove(state.tours, i)
			break
		end
	end
	local a = state.artists[tour.artistId]
	a.hype = Util.clamp(a.hype - 8, 0, 100)
	GS.log(state, "Cancelled \"" .. tour.name .. "\". Fans are disappointed (hype -8).")
	Social.add(state, "cancel", { artistId = tour.artistId, tour = tour }, 3)
	return true, "Tour cancelled. Tickets refunded."
end

------------------------------------------------------------------ shows
function GS.prepareShow(state, tour, idx, rnd)
	return Sim.showResult(state, tour, idx, GS.showDesign(state, tour, idx), rnd)
end

-- Applies a show result. Returns { completed = bool, achievements = {ids} }
function GS.applyShow(state, tour, idx, r)
	local s = tour.shows[idx]
	if s.done then
		return { completed = false, achievements = {} }
	end
	local v = Countries.venueById[s.venueId]
	local ad = Artists.byId[tour.artistId]
	local a = state.artists[tour.artistId]
	s.done = true
	s.sold = r.sold
	s.result = { sold = r.sold, gross = r.gross, net = r.net, stars = r.stars, rating = Util.round(r.rating), review = r.review }

	state.money = state.money + r.net
	tour.gross = tour.gross + r.gross
	tour.net = tour.net + r.net
	tour.attendance = tour.attendance + r.sold
	tour.played = tour.played + 1
	tour.ratingSum = tour.ratingSum + r.rating
	tour.status = "touring"
	if r.soldOut then
		tour.sellouts = tour.sellouts + 1
	end

	-- fans: most of the new fans are local, some spread worldwide
	local gained = r.fansGained
	a.fans[r.region] = (a.fans[r.region] or 0) + math.floor(gained * 0.85)
	for rid, _ in pairs(a.fans) do
		if rid ~= r.region then
			a.fans[rid] = a.fans[rid] + math.floor(gained * 0.03)
		end
	end
	a.hype = Util.clamp(a.hype + r.hypeDelta, 0, 100)
	a.shows = a.shows + 1
	a.gross = a.gross + r.gross

	local st = state.stats
	st.shows = st.shows + 1
	st.tickets = st.tickets + r.sold
	st.totalGross = st.totalGross + r.gross
	if r.soldOut then
		st.sellouts = st.sellouts + 1
		if v.cap > st.biggestSellout then
			st.biggestSellout = v.cap
		end
	end
	if r.stars >= 5 then
		st.fiveStars = st.fiveStars + 1
	end
	if r.gross > st.bestShowGross then
		st.bestShowGross = r.gross
		st.bestShowText = ad.name .. " @ " .. v.name
	end

	Social.onShow(state, tour, idx, r, GS.showDesign(state, tour, idx))
	local completed = tour.played >= #tour.shows
	if completed then
		tour.status = "done"
		tour.endDay = state.day
		local regions, nreg = {}, 0
		for _, sh in ipairs(tour.shows) do
			a.lastPlayed[sh.countryId] = state.day
			local reg = Countries.byId[sh.countryId].region
			if not regions[reg] then
				regions[reg] = true
				nreg = nreg + 1
			end
		end
		if nreg > st.maxRegions then
			st.maxRegions = nreg
		end
		if tour.gross > st.bestTourGross then
			st.bestTourGross = tour.gross
		end
		GS.log(state, "\"" .. tour.name .. "\" finished: " .. Util.money(tour.gross) .. " gross, " .. Util.number(tour.attendance) .. " fans.")
	end
	return { completed = completed, achievements = GS.checkAchievements(state) }
end

-- Advances one day. Returns events for the UI.
function GS.advanceDay(state, rnd)
	state.day = state.day + 1
	local ev = { soldOut = {}, played = {}, live = {}, completed = {}, achievements = {} }

	for _, a in pairs(state.artists) do
		a.hype = a.hype + (40 - a.hype) * 0.004
	end

	-- iterate over a copy because tours can finish during the loop
	local active = {}
	for _, t in ipairs(state.tours) do
		if t.status ~= "done" then
			table.insert(active, t)
		end
	end
	for _, tour in ipairs(active) do
		for _, idx in ipairs(Sim.updateTourSales(state, tour)) do
			table.insert(ev.soldOut, { tour = tour, idx = idx })
			Social.onSoldOut(state, tour, idx)
		end
		-- a week before a show with weak sales the fans start to talk about it
		for idx, s in ipairs(tour.shows) do
			if not s.done and not s.lowPosted and s.day - state.day <= 7 and s.sold < s.cap * 0.5 then
				s.lowPosted = true
				Social.onLowSales(state, tour, idx)
			end
		end
		for idx, s in ipairs(tour.shows) do
			if not s.done and s.day <= state.day then
				if s.watch and s.day == state.day then
					table.insert(ev.live, { tourId = tour.id, idx = idx })
				else
					local r = GS.prepareShow(state, tour, idx, rnd)
					local res = GS.applyShow(state, tour, idx, r)
					table.insert(ev.played, { tour = tour, idx = idx, result = r })
					if res.completed then
						table.insert(ev.completed, tour)
					end
					for _, id in ipairs(res.achievements) do
						table.insert(ev.achievements, id)
					end
				end
			end
		end
	end
	for _, id in ipairs(GS.checkAchievements(state)) do
		table.insert(ev.achievements, id)
	end
	Social.daily(state)
	ev.levelUp = GS.checkLevelUp(state)
	return ev
end

------------------------------------------------------------------ charts & goals
function GS.chart(state)
	local rows = {}
	for _, r in ipairs(Rivals) do
		table.insert(rows, { artist = r.artist, tour = r.tour, gross = r.gross, shows = r.shows, attendance = r.attendance, player = false })
	end
	for _, t in ipairs(state.tours) do
		if t.gross > 0 then
			table.insert(rows, {
				artist = Artists.byId[t.artistId].name,
				tour = t.name,
				gross = t.gross,
				shows = t.played,
				attendance = t.attendance,
				player = true,
				tourId = t.id,
				live = t.status ~= "done",
			})
		end
	end
	table.sort(rows, function(x, y)
		return x.gross > y.gross
	end)
	local best = nil
	for i, r in ipairs(rows) do
		r.rank = i
		if r.player and not best then
			best = i
		end
	end
	return rows, best
end

-- Returns the new level name if the label just levelled up
function GS.checkLevelUp(state)
	local lvl, def = GS.level(state)
	if lvl > (state.levelSeen or 1) then
		state.levelSeen = lvl
		GS.log(state, "Your label is now a " .. def.name .. "! New artists can be signed.")
		return def.name
	end
	return nil
end

function GS.checkAchievements(state)
	local st = state.stats
	local _, bestRank = GS.chart(state)
	local cond = {
		first_show = st.shows >= 1,
		first_sellout = st.sellouts >= 1,
		theatre_sellout = st.biggestSellout >= 2500,
		arena_sellout = st.biggestSellout >= 10000,
		stadium_sellout = st.biggestSellout >= 40000,
		mega_sellout = st.biggestSellout >= 80000,
		five_stars = st.fiveStars >= 1,
		sellouts_10 = st.sellouts >= 10,
		sellouts_50 = st.sellouts >= 50,
		tour_1m = st.bestTourGross >= 1000000,
		tour_10m = st.bestTourGross >= 10000000,
		tour_100m = st.bestTourGross >= 100000000,
		world_tour = st.maxRegions >= 4,
		chart_top10 = bestRank ~= nil and bestRank <= 10,
		chart_1 = bestRank == 1,
		rich = state.money >= 10000000,
		superstar = state.artists.nova ~= nil and state.artists.nova.signed,
	}
	local new = {}
	for _, ach in ipairs(Achievements.list) do
		if cond[ach.id] and not state.achievements[ach.id] then
			state.achievements[ach.id] = state.day
			table.insert(new, ach.id)
			GS.log(state, "Achievement unlocked: " .. ach.name)
		end
	end
	return new
end

return GS
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2C4DC1732A0C4351909249476FB8D0BA"><Properties><string name="Name">Sim</string><ProtectedString name="Source"><![CDATA[-- Simulation formulas: demand, ticket sales, production value, show results.
-- Pure Lua (no Roblox APIs) so it can be unit tested outside of Roblox.
local Root = script:FindFirstAncestor("Headliner")
local Config = require(Root.Config)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local StageItems = require(Root.Data.StageItems)
local Reviews = require(Root.Data.Reviews)
local Util = require(Root.Logic.Util)

local Sim = {}

------------------------------------------------------------------ production
-- How many production points a venue of this size "expects"
function Sim.expectedProduction(cap)
	return 6 * math.sqrt(cap / 100)
end

-- Resizable items cost (and impress) more when they are bigger
function Sim.itemScale(def, rec)
	if not def.size or not rec then
		return 1
	end
	local sw = (rec.w or def.size.w) / def.size.w
	if def.shape == "round" then
		return sw * sw
	end
	local sd = def.size.d and ((rec.d or def.size.d) / def.size.d) or 1
	return sw * sd
end

local function ledMult(rec, m)
	return (rec and rec.skin == "led") and m or 1
end

function Sim.itemPrice(def, rec)
	return Util.round(def.cost * Config.ITEM_PRICE_MULT * Sim.itemScale(def, rec) * ledMult(rec, 1.8))
end

function Sim.itemPts(def, rec)
	return def.pts * Sim.itemScale(def, rec) ^ 0.75 * ledMult(rec, 2)
end

-- Can this design be used in that venue? (stage class must not be bigger than the venue's)
function Sim.designFits(design, venue)
	local dc = Config.STAGE_CLASS_BY_ID[(design and design.class) or "Club"]
	local vc = Config.STAGE_CLASS_BY_ID[Countries.VENUE_TYPES[venue.type].stage]
	return dc.order <= vc.order
end

function Sim.designStats(design, genre)
	local st = { cost = 0, value = 0, raw = 0, eff = 0, count = 0, categories = 0 }
	if not design then
		return st
	end
	local tagMap = (genre and StageItems.GENRE_TAGS[genre]) or {}
	local cats = {}
	for _, it in ipairs(design.items) do
		local def = StageItems.byId[it.t]
		if def then
			st.count = st.count + 1
			local pts = Sim.itemPts(def, it)
			st.value = st.value + Sim.itemPrice(def, it)
			st.raw = st.raw + pts
			local mult = 1
			for _, tag in ipairs(def.tags) do
				local m = tagMap[tag]
				if m then
					mult = mult * m
				end
			end
			mult = Util.clamp(mult, 0.6, 1.7)
			st.eff = st.eff + pts * mult
			if not cats[def.cat] then
				cats[def.cat] = true
				st.categories = st.categories + 1
			end
		end
	end
	st.cost = Util.round(st.value * Config.PRODUCTION_RATE) -- running cost per show
	if st.categories >= 5 then
		st.eff = st.eff * 1.15
	elseif st.categories >= 4 then
		st.eff = st.eff * 1.1
	end
	return st
end

-- 0..100. Extra production beyond 1.7x of what the venue expects adds nothing (size limits: see Sim.designFits).
function Sim.productionScore(design, genre, cap)
	local st = Sim.designStats(design, genre)
	local expected = Sim.expectedProduction(cap)
	local maxFit = expected * 1.7
	local used = math.min(st.eff, maxFit)
	local ratio = used / expected
	local score = 100 * (1 - math.exp(-1.6 * ratio)) / (1 - math.exp(-1.6 * 1.7))
	return Util.clamp(score, 0, 100), st, expected, maxFit
end

------------------------------------------------------------------ prices & demand
function Sim.ticketBase(state, artistId)
	local a = state.artists[artistId]
	local ad = Artists.byId[artistId]
	local total = Util.totalFans(a.fans)
	return (15 + 22 * math.log10(1 + total / 40000)) * ad.pricePower
end

function Sim.fairPrice(state, artistId, countryId)
	local c = Countries.byId[countryId]
	return math.max(5, Util.round(Sim.ticketBase(state, artistId) * c.priceLevel))
end

-- Number of people in a country who want to see this artist on one tour (at a fair price)
function Sim.countryPool(state, artistId, countryId)
	local a = state.artists[artistId]
	local ad = Artists.byId[artistId]
	local c = Countries.byId[countryId]
	local fans = a.fans[c.region] or 0
	local hypeMult = 0.6 + (a.hype / 100) * 0.8
	local genreMult = c.genres[ad.genre] or 1
	local fatigue = 1
	local last = a.lastPlayed[countryId]
	if last then
		fatigue = 0.45 + 0.55 * Util.clamp((state.day - last) / 180, 0, 1)
	end
	return fans * c.share * Config.ATTEND_RATE * hypeMult * genreMult * fatigue
end

function Sim.priceMult(fair, price)
	return Util.clamp((fair / math.max(1, price)) ^ 1.6, 0.05, 3)
end

-- shows: array of { venueId=, price=, noise=? }. Returns an array of demand (tickets wanted) per show.
-- Fans of a country are spread evenly over that country's shows ("water filling"): if a small venue
-- sells out, the fans who could not get a ticket move on to the other shows in the same country.
function Sim.demands(state, artistId, shows, mult)
	local byCountry, order = {}, {}
	for i, s in ipairs(shows) do
		local cid = Countries.venueById[s.venueId].countryId
		if not byCountry[cid] then
			byCountry[cid] = {}
			table.insert(order, cid)
		end
		table.insert(byCountry[cid], i)
	end
	local out = {}
	for _, cid in ipairs(order) do
		local idxs = byCountry[cid]
		local pool = Sim.countryPool(state, artistId, cid) * (mult or 1)
		local fair = Sim.fairPrice(state, artistId, cid)
		local pm, need, alloc, full = {}, {}, {}, {}
		for _, i in ipairs(idxs) do
			local s = shows[i]
			pm[i] = Sim.priceMult(fair, s.price) * (s.noise or 1)
			need[i] = Countries.venueById[s.venueId].cap / pm[i] -- fans needed to sell out
			alloc[i] = 0
		end
		local remaining, open = pool, idxs
		for _ = 1, #idxs do
			if remaining <= 0 or #open == 0 then
				break
			end
			local per = remaining / #open
			remaining = 0
			local nextOpen = {}
			for _, i in ipairs(open) do
				local left = need[i] - alloc[i]
				if per >= left then
					alloc[i] = need[i]
					full[i] = true
					remaining = remaining + (per - left)
				else
					alloc[i] = alloc[i] + per
					table.insert(nextOpen, i)
				end
			end
			open = nextOpen
		end
		local even = pool / #idxs
		for _, i in ipairs(idxs) do
			local d = alloc[i] * pm[i]
			if full[i] then
				d = math.max(d, even * pm[i]) -- keeps "how hot" a sold-out show is (sells out earlier)
			end
			out[i] = d
		end
	end
	return out
end

function Sim.marketingMult(tour)
	local m = 1
	for _, mk in ipairs(Config.MARKETING) do
		if tour.marketing and tour.marketing[mk.id] then
			m = m * (1 + mk.boost)
		end
	end
	return m
end

-- Share of the final demand that has bought a ticket after `elapsed` of `total` pre-sale days
function Sim.salesFraction(elapsed, total)
	if total <= 0 then
		return 1
	end
	local tau = Util.clamp(elapsed / total, 0, 1)
	return 0.4 + 0.6 * tau ^ 0.8
end

-- Updates sold tickets of all unplayed shows. Returns list of show indexes that just sold out.
function Sim.updateTourSales(state, tour)
	local newlySoldOut = {}
	local d = Sim.demands(state, tour.artistId, tour.shows, Sim.marketingMult(tour))
	for i, s in ipairs(tour.shows) do
		if not s.done then
			s.demand = d[i]
			local total = s.day - tour.announcedDay
			local elapsed = state.day - tour.announcedDay
			local target = math.floor(math.min(s.cap, d[i] * Sim.salesFraction(elapsed, total)))
			if target > s.sold then
				s.sold = target
			end
			if s.sold >= s.cap and not s.soldOutDay then
				s.soldOutDay = state.day
				table.insert(newlySoldOut, i)
			end
		end
	end
	return newlySoldOut
end

-- Promoter advice: what venue size fits this artist in a country (ticket buyers at a fair price)
function Sim.recommendation(state, artistId, countryId)
	local pool = Sim.countryPool(state, artistId, countryId)
	local label
	if pool < 600 then
		label = "small clubs (under 600)"
	elseif pool < 2500 then
		label = "clubs or a small theatre (up to ~2,500)"
	elseif pool < 8000 then
		label = "theatres and halls (2,500 - 8,000)"
	elseif pool < 30000 then
		label = "an arena (10,000 - 25,000)"
	elseif pool < 90000 then
		label = "arenas, maybe several nights"
	else
		label = "stadiums"
	end
	return label, pool
end

------------------------------------------------------------------ costs
function Sim.venueRent(venue)
	local vt = Countries.VENUE_TYPES[venue.type]
	local c = Countries.byId[venue.countryId]
	return Util.round(500 + venue.cap * vt.rentPerSeat * c.priceLevel)
end

function Sim.travelCost(prevVenue, venue, itemCount)
	if prevVenue and prevVenue.id == venue.id then
		return 0 -- another night in the same venue: the stage stays up
	end
	local km = 0
	if prevVenue then
		if prevVenue.countryId == venue.countryId then
			km = 300
		else
			local a = Countries.byId[prevVenue.countryId]
			local b = Countries.byId[venue.countryId]
			km = Util.distanceKm(a.lat, a.lon, b.lat, b.lon)
		end
	end
	return Util.round((1000 + km * 1.2) * (1 + (itemCount or 0) / 40))
end

------------------------------------------------------------------ planner estimate
-- draft = { artistId=, designId=, shows = { {venueId=, price=}, ... } }
function Sim.estimate(state, draft, design)
	local res = { rows = {}, tickets = 0, capacity = 0, gross = 0, costs = 0, net = 0 }
	if not draft.artistId or #draft.shows == 0 then
		return res
	end
	-- design can be one design or a function(venue) -> design (one production per venue size)
	local function stFor(v)
		local dd = design
		if type(design) == "function" then
			dd = design(v)
		end
		return Sim.designStats(dd, nil)
	end
	local d = Sim.demands(state, draft.artistId, draft.shows, 1)
	local prev = nil
	for i, s in ipairs(draft.shows) do
		local v = Countries.venueById[s.venueId]
		local sold = math.floor(math.min(v.cap, d[i]))
		local gross = sold * s.price
		local rent = Sim.venueRent(v)
		local st = stFor(v)
		local travel = Sim.travelCost(prev, v, st.count)
		local cut = Util.round(gross * Config.ARTIST_SHARE)
		local costs = rent + st.cost + travel + cut
		local n = Config.DEMAND_NOISE
		local low = math.min(1, d[i] * (1 - n) / v.cap)
		local high = math.min(1, d[i] * (1 + n) / v.cap)
		res.rows[i] = { demand = d[i], sold = sold, fill = sold / v.cap, fillLow = low, fillHigh = high, gross = gross, costs = costs, net = gross - costs }
		res.grossLow = (res.grossLow or 0) + math.floor(low * v.cap) * s.price
		res.grossHigh = (res.grossHigh or 0) + math.floor(high * v.cap) * s.price
		res.tickets = res.tickets + sold
		res.capacity = res.capacity + v.cap
		res.gross = res.gross + gross
		res.costs = res.costs + costs
		prev = v
	end
	res.net = res.gross - res.costs
	res.netLow = (res.grossLow or 0) - res.costs + Util.round((res.gross - (res.grossLow or 0)) * Config.ARTIST_SHARE)
	res.netHigh = (res.grossHigh or 0) - res.costs - Util.round(((res.grossHigh or 0) - res.gross) * Config.ARTIST_SHARE)
	return res
end

------------------------------------------------------------------ show result
function Sim.showResult(state, tour, idx, design, rnd)
	rnd = rnd or math.random
	local s = tour.shows[idx]
	local v = Countries.venueById[s.venueId]
	local c = Countries.byId[v.countryId]
	local ad = Artists.byId[tour.artistId]

	local sold = math.min(s.sold, v.cap)
	local gross = sold * s.price
	local rent = Sim.venueRent(v)
	local prodScore, st = Sim.productionScore(design, ad.genre, v.cap)
	local travel = s.travel or 0
	local cut = Util.round(gross * Config.ARTIST_SHARE)
	local net = gross - rent - st.cost - travel - cut
	local fill = sold / v.cap

	local rating = 0.45 * ad.skill + 0.45 * prodScore + 10 * fill - 5 + (rnd() * 8 - 4)
	rating = Util.clamp(rating, 1, 100)
	local stars = 1
	if rating >= 88 then
		stars = 5
	elseif rating >= 75 then
		stars = 4
	elseif rating >= 60 then
		stars = 3
	elseif rating >= 45 then
		stars = 2
	end

	local list = Reviews[stars]
	local review = list[math.floor(rnd() * #list) + 1] or list[1]
	review = review:gsub("{artist}", ad.name):gsub("{venue}", v.name):gsub("{city}", v.city)

	local soldOut = sold >= v.cap
	-- word of mouth: good reviews spread to fans who were not there (diminishing for huge artists)
	local regionFans = state.artists[tour.artistId].fans[c.region] or 0
	local buzz = regionFans * 0.012 * math.max(0, stars - 2) / (1 + regionFans / 2000000)
	return {
		sold = sold,
		cap = v.cap,
		fill = fill,
		price = s.price,
		gross = gross,
		rent = rent,
		production = st.cost,
		travel = travel,
		artistCut = cut,
		net = net,
		rating = rating,
		stars = stars,
		prodScore = prodScore,
		fansGained = math.floor(sold * (0.5 + 3 * (rating / 100) ^ 2) + buzz),
		hypeDelta = (rating - 60) / 12 + (soldOut and 1 or -0.5),
		review = review,
		soldOut = soldOut,
		region = c.region,
	}
end

return Sim
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8B54AB1EF5E8428A89D0B6561BA936B6"><Properties><string name="Name">Social</string><ProtectedString name="Source"><![CDATA[-- Generates fan posts for the SOCIAL feed. Pure Lua (no Roblox APIs).
local Root = script:FindFirstAncestor("Headliner")
local Data = require(Root.Data.Social)
local Countries = require(Root.Data.Countries)
local Artists = require(Root.Data.Artists)
local Util = require(Root.Logic.Util)

local Social = {}
Social.MAX = 200

local function pick(list, rnd)
	return list[math.floor(rnd() * #list) + 1]
end

local function hashtag(ad)
	return "#" .. ad.name:gsub("[^%w]", "") .. "Live"
end

local function fill(text, c)
	return (text:gsub("{(%w+)}", function(k)
		local v = c[k]
		return v ~= nil and tostring(v) or ""
	end))
end

-- adds `n` posts of a kind. c = { artistId, venueId?, tour?, song?, price?, item? }
function Social.add(state, kind, c, n, rnd)
	rnd = rnd or math.random
	state.social = state.social or {}
	local list = Data.POSTS[kind]
	if not list then
		return
	end
	local ad = Artists.byId[c.artistId or ""]
	local v = c.venueId and Countries.venueById[c.venueId]
	local ctx = {
		artist = ad and ad.name or "",
		venue = v and v.name or "",
		city = v and v.city or "",
		country = c.country or (v and Countries.byId[v.countryId].name) or "",
		tour = c.tour and c.tour.name or "",
		song = c.song or (ad and pick(ad.setlist, rnd)) or "",
		price = c.price and Util.money(c.price) or "",
		tag = ad and hashtag(ad) or "",
		item = c.item or "",
		label = state.labelName or "",
	}
	local used = {}
	for _ = 1, n or 1 do
		local tpl = pick(list, rnd)
		local tries = 0
		while used[tpl] and tries < 5 do
			tpl = pick(list, rnd)
			tries = tries + 1
		end
		used[tpl] = true
		local first = pick(Data.FIRST, rnd)
		local handle = "@" .. pick(Data.HANDLE_A, rnd) .. "." .. pick(Data.HANDLE_B, rnd)
		local likes = math.floor((20 + rnd() * 400) * (tpl[1] > 0 and 2.5 or 1) * (1 + (c.reach or 0)))
		table.insert(state.social, 1, {
			day = state.day,
			name = first,
			handle = handle,
			text = fill(tpl[2], ctx),
			mood = tpl[1],
			kind = kind,
			likes = likes,
			reposts = math.floor(likes * (0.05 + rnd() * 0.2)),
			artistId = c.artistId,
			photo = kind == "photo",
			avatar = math.floor(rnd() * 8) + 1,
		})
	end
	while #state.social > Social.MAX do
		table.remove(state.social)
	end
end

-- reach: bigger artists get more likes
local function reach(state, artistId)
	local a = state.artists[artistId]
	return a and math.log10(1 + Util.totalFans(a.fans) / 100000) or 0
end

function Social.onAnnounce(state, tour, fairPrice, rnd)
	rnd = rnd or math.random
	local s1 = tour.shows[1]
	local c = { artistId = tour.artistId, venueId = s1 and s1.venueId, tour = tour, price = tour.price, reach = reach(state, tour.artistId) }
	Social.add(state, "announce", c, 3, rnd)
	if fairPrice and tour.price > fairPrice * 1.3 then
		Social.add(state, "price_high", c, 2, rnd)
	elseif fairPrice and tour.price < fairPrice * 0.85 then
		Social.add(state, "price_low", c, 1, rnd)
	end
end

function Social.onSoldOut(state, tour, idx, rnd)
	local s = tour.shows[idx]
	Social.add(state, "soldout", { artistId = tour.artistId, venueId = s.venueId, tour = tour, reach = reach(state, tour.artistId) }, 2, rnd)
end

function Social.onLowSales(state, tour, idx, rnd)
	local s = tour.shows[idx]
	Social.add(state, "lowsales", { artistId = tour.artistId, venueId = s.venueId, tour = tour }, 2, rnd)
end

-- after a show: reviews, photos and comments about songs, outfits and the stage
function Social.onShow(state, tour, idx, r, design, rnd)
	rnd = rnd or math.random
	local s = tour.shows[idx]
	local c = { artistId = tour.artistId, venueId = s.venueId, tour = tour, price = s.price, reach = reach(state, tour.artistId) }
	local kind = (r.stars >= 4) and "show_great" or ((r.stars == 3) and "show_ok" or "show_bad")
	Social.add(state, kind, c, (r.stars >= 4) and 3 or 2, rnd)
	if r.stars >= 3 then
		Social.add(state, "photo", c, 1 + math.floor(rnd() * 2), rnd)
		Social.add(state, (rnd() < 0.5) and "outfit" or "setlist", c, 1, rnd)
	end
	-- a post about a special stage item
	if design and r.stars >= 3 then
		local found = {}
		for _, it in ipairs(design.items or {}) do
			local nm = Data.ITEM_NAMES[it.t]
			if nm and not found[nm] then
				found[nm] = true
				table.insert(found, nm)
			end
		end
		if #found > 0 then
			c.item = found[math.floor(rnd() * #found) + 1]
			Social.add(state, "stage", c, 1, rnd)
		end
	end
	if r.fill < 0.6 then
		Social.add(state, "lowsales", c, 1, rnd)
	end
end

-- small chance every day: fan projects, merch, countdowns for upcoming shows
function Social.daily(state, rnd)
	rnd = rnd or math.random
	for _, tour in ipairs(state.tours) do
		if tour.status ~= "done" and rnd() < 0.25 then
			for _, s in ipairs(tour.shows) do
				if not s.done then
					local kinds = { "fanproject", "merch", "countdown" }
					Social.add(state, kinds[math.floor(rnd() * #kinds) + 1], { artistId = tour.artistId, venueId = s.venueId, tour = tour }, 1, rnd)
					break
				end
			end
		end
	end
end

-- -100..100: how fans feel about an artist (last 25 posts)
function Social.mood(state, artistId)
	local sum, n = 0, 0
	for _, p in ipairs(state.social or {}) do
		if p.artistId == artistId then
			sum = sum + p.mood
			n = n + 1
			if n >= 25 then
				break
			end
		end
	end
	if n == 0 then
		return 0, 0
	end
	return math.floor(sum / n * 100 + 0.5), n
end

-- trending hashtags: { {tag, count} } sorted
function Social.trending(state)
	local counts = {}
	for _, p in ipairs(state.social or {}) do
		for tag in p.text:gmatch("#%w+") do
			counts[tag] = (counts[tag] or 0) + p.likes
		end
	end
	local out = {}
	for tag, n in pairs(counts) do
		table.insert(out, { tag, n })
	end
	table.sort(out, function(a, b)
		return a[2] > b[2]
	end)
	return out
end

return Social
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBXDA7FE7AD5D4D41C99657C171342A81D0"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Small helpers (pure Lua, no Roblox APIs)
local Util = {}

function Util.clamp(x, a, b)
	if x < a then
		return a
	end
	if x > b then
		return b
	end
	return x
end

function Util.round(x)
	return math.floor(x + 0.5)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

local function commas(n)
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function Util.number(n)
	local s = commas(n)
	if n < 0 then
		return "-" .. s
	end
	return s
end

function Util.money(n)
	if n < 0 then
		return "-$" .. commas(n)
	end
	return "$" .. commas(n)
end

local function short(n)
	local a = math.abs(n)
	if a >= 1e9 then
		return string.format("%.2fB", a / 1e9)
	elseif a >= 1e6 then
		return string.format("%.1fM", a / 1e6)
	elseif a >= 1e4 then
		return string.format("%.0fK", a / 1e3)
	elseif a >= 1e3 then
		return string.format("%.1fK", a / 1e3)
	end
	return tostring(math.floor(a + 0.5))
end

function Util.short(n)
	if n < 0 then
		return "-" .. short(n)
	end
	return short(n)
end

function Util.moneyShort(n)
	if n < 0 then
		return "-$" .. short(n)
	end
	return "$" .. short(n)
end

function Util.percent(f)
	return tostring(math.floor(f * 100 + 0.5)) .. "%"
end

local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }
local MDAYS = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }

local function isLeap(y)
	return (y % 4 == 0 and y % 100 ~= 0) or (y % 400 == 0)
end

-- day 0 = Jan 1 of startYear
function Util.date(day, startYear)
	local y = startYear or 2027
	local d = math.floor(day)
	while true do
		local len = isLeap(y) and 366 or 365
		if d < len then
			break
		end
		d = d - len
		y = y + 1
	end
	local m = 1
	while true do
		local ml = MDAYS[m]
		if m == 2 and isLeap(y) then
			ml = 29
		end
		if d < ml then
			break
		end
		d = d - ml
		m = m + 1
	end
	return MONTHS[m] .. " " .. tostring(d + 1) .. ", " .. tostring(y), MONTHS[m] .. " " .. tostring(d + 1)
end

function Util.distanceKm(lat1, lon1, lat2, lon2)
	local r = math.pi / 180
	local dLat = (lat2 - lat1) * r
	local dLon = (lon2 - lon1) * r
	local a = math.sin(dLat / 2) ^ 2 + math.cos(lat1 * r) * math.cos(lat2 * r) * math.sin(dLon / 2) ^ 2
	return 6371 * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))
end

function Util.deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = Util.deepCopy(v)
	end
	return c
end

function Util.stars(n)
	local s = ""
	for i = 1, 5 do
		if i <= n then
			s = s .. "\226\152\133" -- U+2605 black star
		else
			s = s .. "\226\152\134" -- U+2606 white star
		end
	end
	return s
end

function Util.totalFans(fans)
	local t = 0
	for _, v in pairs(fans) do
		t = t + v
	end
	return t
end

function Util.tier(totalFans)
	if totalFans < 300000 then
		return "Rising Act"
	elseif totalFans < 1500000 then
		return "Breakthrough"
	elseif totalFans < 5000000 then
		return "Arena Act"
	elseif totalFans < 15000000 then
		return "Stadium Act"
	end
	return "Global Superstar"
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX8E2F63577CF248EEB57A470F0AFCFF03"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteFunction" referent="RBX71F30C1E867242D0AD548F7F7339F88C"><Properties><string name="Name">LoadGame</string></Properties></Item>
