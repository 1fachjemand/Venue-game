		{ -1, "Merch line at {venue} took 2 hours. Worth it? Maybe" },
		{ 0, "Which {tour} shirt should I get? Help" },
		{ 1, "Tour shirt, tote bag, poster. My bank account says no, my heart says yes" },
		{ 1, "Merch haul from {venue}!" },
		{ -1, "Sold out of my size again. Restock the hoodies please" },
		{ 1, "Wearing my {tour} hoodie to school every day now" },
		{ 0, "Is the vinyl at the merch stand signed or just pretty?" },
	},
	sign = {
		{ 1, "{artist} signed with {label}! Big things coming" },
		{ 0, "{label} just signed {artist}. Curious what they'll do" },
		{ 1, "{artist} x {label} is the collab we needed" },
		{ 1, "Welcome to the label {artist}! Can't wait for the first tour" },
		{ 0, "New label, new era for {artist}? Let's see" },
	},
	cancel = {
		{ -1, "{tour} CANCELLED?? I already booked my train" },
		{ -1, "Refunds are fine but I wanted to see {artist}. So sad" },
		{ -1, "What is {label} doing?? First announce, then cancel" },
		{ -1, "Cancelled shows in {city}. Not the news I wanted today" },
		{ -1, "Got my refund. Still sad. {artist} come back soon" },
	},
	cancelshow = {
		{ -1, "{artist} cancelled the {city} show?? I had tickets for {venue}" },
		{ -1, "No {artist} in {city} anymore. Low sales they say. I was going!" },
		{ -1, "Refund for {venue} came in. I'd rather have the show, {label}" },
		{ 0, "Heard the {city} date of {tour} is gone. Guess I'm travelling to the next one" },
		{ -1, "Cancelled in {city} but they still play everywhere else? Hmm" },
		{ 0, "Sad about {city}, but please come back with a smaller venue {artist}" },
	},
	countdown = {
		{ 1, "{artist} in {city} is in a few days. Not sleeping until then" },
		{ 0, "Packing list for {artist}: tickets, charger, earplugs, snacks" },
		{ 1, "Learning every lyric of {song} before {city}" },
		{ 1, "Ticket printed, outfit ready, playlist on repeat. {city} here I come" },
		{ 1, "One week until {artist}! Counting the sleeps" },
		{ 0, "Should I queue at {venue} from the morning? Asking veterans" },
		{ 1, "Glitter: bought. Tissues for {song}: bought" },
		{ 1, "My ticket for {artist} is the most valuable thing I own" },
	},
}

-- photos fans attach: chance per post kind and the kinds of photo (see SocialScreen.photo)
Social.PHOTOS = {
	photo = { 1, { "stage", "selfie", "wide", "closeup", "confetti", "pyro", "phones", "barricade", "queue", "sign" } },
	show_great = { 0.35, { "stage", "wide", "phones", "confetti", "closeup" } },
	show_ok = { 0.15, { "stage", "wide" } },
	stage = { 0.7, { "pyro", "stage", "confetti", "wide" } },
	outfit = { 0.8, { "closeup" } },
	merch = { 0.75, { "merch" } },
	countdown = { 0.5, { "ticket", "queue" } },
	soldout = { 0.45, { "ticket" } },
	fanproject = { 0.6, { "sign", "phones" } },
	announce = { 0.25, { "poster" } },
}

-- what fans call the special stage items in their posts
Social.ITEM_NAMES = {
	lift = "rising lift", pyro = "pyro", fireworks = "fireworks", ledcube = "LED cube", moon = "giant moon", portal = "portal ring",
	balls = "giant balloons", wristbands = "glowing wristbands", confetti = "confetti", kinetic = "flying light bars", statue = "giant statue",
	robotarm = "robot arm", skyline = "city skyline", curtain = "curtain drop", laser = "laser show", scissor = "lift in the finale",
	ferris = "Ferris wheel", rocket = "rocket launch", hand = "giant hand", swing = "swing moment", fountain = "fountain", lighthouse = "lighthouse beam",
	vintagecar = "vintage car", throne = "throne", rainbow = "rainbow", strings = "string section", harp = "harp solo", choir = "choir", acoustic = "acoustic set",
	poplift = "pop-up lift", towerlift = "tower lift", stadiumroof = "giant stage", sparks = "spark fountains", co2 = "CO2 blasts",
	piano = "piano part", lowfog = "cloud floor", streamers = "streamer rain", house = "little house set",
	bubbles = "bubbles", snow = "snow", candles = "candle-light part", sofa = "living-room set", stringlights = "fairy lights", tvstack = "TV wall",
}

-- more posts from Data/SocialMore.lua
do
	local more = require(script:FindFirstAncestor("Headliner").Data.SocialMore)
	for kind, list in pairs(more) do
		Social.POSTS[kind] = Social.POSTS[kind] or {}
		for _, p in ipairs(list) do
			table.insert(Social.POSTS[kind], p)
		end
	end
end

return Social
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8F4074C962A1402E90D2B6547C0D3F54"><Properties><string name="Name">SocialMore</string><ProtectedString name="Source"><![CDATA[-- More fan posts (merged into Social.POSTS by Data/Social.lua). Same format: { mood, text }.
-- Placeholders: {artist} {venue} {city} {country} {tour} {song} {price} {tag} {item} {label}
return {
	announce = {
		{ 1, "Wait. {artist}. {city}. {venue}. Is this real life?" },
		{ 1, "Crying, screaming, buying tickets for {tour}" },
		{ 1, "My mom said I can go to {artist} if I clean my room for a year. Deal." },
		{ 0, "Does anyone know if {venue} has seats or is it standing?" },
		{ 1, "{tour} announcement made my whole week" },
		{ 0, "Ok but what time do {tour} tickets go on sale in {country}?" },
		{ 1, "The group chat exploded the second {artist} posted {tour}" },
		{ -1, "Of course {artist} plays {city} on the day of my exam" },
		{ 1, "Taking the whole friend group to {artist}. No one is staying home" },
		{ 0, "Is {venue} big enough for {artist}? Feels small" },
		{ 1, "Already learning every word of {song} for {city}" },
		{ 1, "{label} really said: here is a tour, enjoy {tag}" },
		{ 1, "First concert of my life will be {artist}. I'm so nervous" },
		{ 0, "Guess I'm spending my birthday money on {tour}" },
		{ -1, "Only {city}? The rest of {country} exists too..." },
		{ 1, "Booked the train to {city}. Now I just need a ticket" },
		{ 1, "{artist} live in {city} was on my bucket list. Checking it off soon" },
	},
	price_high = {
		{ -1, "{price} for nosebleed seats. For {artist}. Really?" },
		{ -1, "I'll watch {artist} on someone's phone stream at this point" },
		{ -1, "Concert tickets cost like a plane ticket now. {price}??" },
		{ 0, "{price} is steep but it's {artist}, I'll find a way" },
		{ -1, "Dear {label}, not everyone is a millionaire" },
		{ -1, "Sold my old guitar to afford {tour}. Worth it? We'll see" },
		{ 0, "Splitting the {price} ticket with my sister. She gets the first half" },
		{ -1, "At {price} the show better have fireworks AND a hug from {artist}" },
	},
	price_low = {
		{ 1, "{label} keeping prices fair for {tour}. Respect" },
		{ 1, "{price}? I'm going twice" },
		{ 1, "Cheap tickets, big artist. {artist} gets it" },
		{ 1, "Finally a concert my student budget can handle {tag}" },
		{ 1, "Bought tickets for my whole family at {price}. Best deal ever" },
	},
	soldout = {
		{ 1, "{venue} SOLD OUT for {artist}. Called it" },
		{ -1, "Sold out in 4 minutes and I was number 18,000 in the queue" },
		{ 1, "Got the last ticket for {artist} in {city}. Universe loves me" },
		{ -1, "Resellers asking triple for {artist}. Shameful" },
		{ 0, "Anyone selling a {city} ticket at face value? Please" },
		{ 1, "{artist} sells out {venue}. We knew they were special {tag}" },
		{ -1, "Add a second night in {city}, we're begging you" },
		{ 1, "My hands are still shaking. I'M GOING TO {artist}" },
		{ 0, "Waiting list for {venue} has 9,000 people on it lol" },
		{ 1, "From small clubs to sold out {venue}. Proud of {artist}" },
	},
	lowsales = {
		{ -1, "Why are there still so many tickets for {artist} in {city}?" },
		{ 0, "{venue} might be a bit too big for {artist} right now" },
		{ -1, "Nobody I know is going to {artist} in {city}. Weird" },
		{ 0, "Tickets for {tour} are still available, go support {artist}!" },
		{ -1, "Maybe the prices are scaring people away from {venue}" },
		{ 0, "Hidden gem: {artist} in {city} and you can still get in" },
		{ 0, "Promo for {tour} in {country}? I only found out by accident" },
	},
	show_great = {
		{ 1, "Best night of my life. {artist} in {city}, thank you" },
		{ 1, "When {artist} played {song} the whole {venue} was singing" },
		{ 1, "My voice is gone. My heart is full. {tag}" },
		{ 1, "{artist} just gave the show of the year at {venue}" },
		{ 1, "Still hearing {song} in my head. Post-concert depression is real" },
		{ 1, "The stage, the lights, the crowd... {artist} did THAT" },
		{ 1, "I cried during {song} and I'm not even sorry" },
		{ 1, "Concert review: 10/10, would sell my kidney again {tag}" },
		{ 1, "{artist} looked right at me during {song}. I'm moving to {city}" },
		{ 1, "Nobody in {venue} sat down for two hours" },
		{ 1, "The encore. THE ENCORE. {artist} you legend" },
		{ 1, "Met people from four countries in the front row. Music unites" },
		{ 1, "{city}, you were LOUD tonight. {artist} said it too" },
		{ 1, "Walked out of {venue} smiling like an idiot" },
		{ 1, "The production on {tour} is next level. Who designed that stage?" },
	},
	show_ok = {
		{ 0, "Good show from {artist}. The sound at {venue} could be better" },
		{ 0, "Nice night, but I wanted {song} in the setlist" },
		{ 0, "{artist} was solid. The crowd was a bit sleepy though" },
		{ 1, "Not perfect, but I had fun at {venue}" },
		{ 0, "Show ended early? Felt short but sweet" },
		{ 0, "{artist} sounded tired, still sang {song} beautifully" },
		{ 0, "Lights were cool, wish there were more screens" },
	},
	show_bad = {
		{ -1, "That was it? {artist} in {city} was a letdown" },
		{ -1, "Couldn't see anything from the back of {venue}" },
		{ -1, "Paid {price} for a show with almost no stage. Disappointed" },
		{ -1, "The sound at {venue} was a mess tonight" },
		{ -1, "{artist} barely talked to us. Felt like a rehearsal" },
		{ -1, "Half the songs I wanted were missing. Next time {artist}" },
		{ 0, "Not their best night. Still love {artist} though" },
	},
	photo = {
		{ 1, "Front row view at {venue}. No filter needed" },
		{ 1, "Blurry but it's MY blurry photo of {artist}" },
		{ 1, "The lights during {song}. I have 400 photos like this" },
		{ 1, "This is my new lock screen {tag}" },
		{ 1, "Me and 20,000 friends in {city}" },
		{ 1, "Proof I was there. {artist} in {city}" },
		{ 1, "Golden hour at {venue} before the doors opened" },
		{ 1, "Someone tell {artist} this photo is art" },
	},
	fanproject = {
		{ 1, "Fan project for {city}: everyone hold up a light during {song}!" },
		{ 1, "We're printing 2,000 signs for {artist} at {venue}. Who's helping?" },
		{ 1, "Section 112 is doing a heart with phone lights during {song}" },
		{ 1, "Made friendship bracelets with the whole setlist on them" },
		{ 0, "Planning the fan project for {tour}, ideas welcome" },
		{ 1, "The fan banner for {artist} is 12 meters long. We did it" },
	},
	setlist = {
		{ 1, "Setlist for {tour} leaked and {song} is in it!!" },
		{ 0, "Will {artist} play {song} in {city}? Taking bets" },
		{ 1, "Opening with {song} was a genius move" },
		{ -1, "They cut {song} from the setlist. Why would you do that" },
		{ 1, "The acoustic part of the show is everything" },
		{ 0, "Setlist is the same every night, a surprise song would be nice" },
	},
	outfit = {
		{ 1, "{artist}'s outfit tonight: fashion week could never" },
		{ 1, "The jacket {artist} wore in {city}. I need it" },
		{ 1, "Three outfit changes in one show. Icon behaviour" },
		{ 0, "Matching outfits with my friends for {artist}. Pictures soon" },
		{ 1, "Glitter everywhere. On me. On the floor. On {artist}. Perfect" },
	},
	stage = {
		{ 1, "The {item} at {venue} was unreal" },
		{ 1, "When the {item} turned on the whole crowd screamed" },
		{ 1, "Did you see the {item}? I felt the heat in row 30" },
		{ 1, "{tour} has the coolest stage I've ever seen" },
		{ 1, "Who at {label} designed this stage? Give them a raise" },
		{ 0, "I want a {item} in my living room now" },
		{ 1, "The {item} during {song} gave me chills" },
	},
	merch = {
		{ 1, "Merch line was 2 hours. The hoodie is worth it" },
		{ 1, "Got the {tour} shirt in every color. No regrets" },
		{ -1, "Merch sold out before I got there. Sad" },
		{ 0, "{tour} merch is cute but the prices..." },
		{ 1, "The tour poster is going on my wall tonight" },
	},
	sign = {
		{ 1, "Welcome to {label}, {artist}! Big things coming" },
		{ 1, "{artist} signed with {label}?! Tour when?" },
		{ 0, "New label for {artist}. Hope they let them stay themselves" },
		{ 1, "{label} is building a real roster now {tag}" },
	},
	cancel = {
		{ -1, "{artist} cancelled {tour}. I had my outfit ready" },
		{ -1, "Refund is nice but I wanted the show, not the money" },
		{ -1, "What happened with {tour}? We deserve an explanation" },
		{ 0, "Hope {artist} is ok. Health first" },
	},
	countdown = {
		{ 1, "7 days until {artist} in {city}. Counting every hour" },
		{ 1, "Tomorrow!!! {artist} at {venue}!!!" },
		{ 1, "Camping outside {venue} since this morning. Worth it" },
		{ 0, "What's the bag policy at {venue}? Need to know" },
		{ 1, "Outfit: done. Ticket: printed. Voice: warmed up. {tag}" },
		{ 1, "Train to {city} booked, hotel booked, sleep cancelled" },
		{ 0, "Doors at 6? Or 7? Somebody help" },
		{ 1, "Can't sleep, too excited for {artist} tomorrow" },
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34F3AB9ABE944D85A1A05C6479E7F5CB"><Properties><string name="Name">StageItems</string><ProtectedString name="Source"><![CDATA[-- Stage design catalog.
-- cost  = production cost per show (crew, transport, power)
-- pts   = production value points (more points = more impressive show)
-- tags  = used for genre bonuses
-- mount = "floor" (stands on the stage deck / ground) or "rig" (hangs from the lighting rig)
-- deck  = true if performers can walk on it (other items can be placed on top)

local StageItems = {}

StageItems.CATEGORIES = {
	{ id = "Stage", name = "Stage" },
	{ id = "Artist", name = "Artist" },
	{ id = "Band", name = "Band" },
	{ id = "Lights", name = "Lights" },
	{ id = "Screens", name = "Screens" },
	{ id = "FX", name = "Effects" },
	{ id = "Set", name = "Set Pieces" },
	{ id = "Decor", name = "Decor" },
}

-- Up to this many artist spots (= songs in the setlist)
StageItems.MAX_SPOTS = 12

local H = { 1, 2, 4, 6, 8, 10, 14 }
StageItems.list = {
	-- Stage structure. "size" = resizable (w = width along x, d = depth along z); decks have selectable heights.
	{ id = "deck", name = "Stage Deck", cat = "Stage", cost = 600, pts = 3, tags = {}, mount = "floor", deck = true, shape = "rect", size = { w = 16, d = 12, minW = 4, maxW = 160, minD = 4, maxD = 120 }, h = 6, heights = H, desc = "Rectangular platform. Resize, rotate and stack it to build any stage, runway or B-stage." },
	{ id = "deck_tri", name = "Triangle Deck", cat = "Stage", cost = 500, pts = 3, tags = { "intimate" }, mount = "floor", deck = true, shape = "tri", size = { w = 16, d = 16, minW = 4, maxW = 80, minD = 4, maxD = 80 }, h = 6, heights = H, desc = "Triangle platform (tip points forward). Great for triangle catwalks." },
	{ id = "deck_corner", name = "Corner Deck", cat = "Stage", cost = 400, pts = 2, tags = {}, mount = "floor", deck = true, shape = "corner", size = { w = 12, d = 12, minW = 4, maxW = 60, minD = 4, maxD = 60 }, h = 6, heights = H, desc = "Right-angled triangle for diagonal corners and angled runways." },
	{ id = "deck_round", name = "Round Deck", cat = "Stage", cost = 700, pts = 4, tags = { "spectacle" }, mount = "floor", deck = true, shape = "round", size = { w = 16, minW = 6, maxW = 100 }, h = 6, heights = H, desc = "Round platform: a B-stage or the heart of a center stage." },
	{ id = "stairs", name = "Stairs", cat = "Stage", cost = 300, pts = 0, tags = {}, mount = "floor", deck = true, shape = "stairs", size = { w = 6, d = 8, minW = 3, maxW = 30, minD = 3, maxD = 30 }, h = 6, heights = { 2, 4, 6, 8, 10, 14 }, desc = "Steps up to a higher deck. The low end points to the front." },
	-- old item, kept for saved stages only (crowd barriers are now part of every venue)
	{ id = "pit", name = "Pit Barrier", cat = "Stage", hidden = true, cost = 800, pts = 2, tags = { "intimate" }, mount = "floor", deck = false, size = { w = 20, d = 12, minW = 6, maxW = 80, minD = 6, maxD = 80 }, desc = "Fenced VIP pit on the floor. Fans fill the pit first." },
	{ id = "truss_beam", name = "Truss Beam", cat = "Stage", cost = 300, pts = 1, tags = {}, mount = "rig", deck = false, size = { w = 24, minW = 8, maxW = 240 }, desc = "Horizontal truss in the rig. Lights snap onto it." },
	{ id = "stadiumroof", name = "Stadium Structure", cat = "Stage", cost = 25000, pts = 22, tags = { "spectacle" }, mount = "floor", deck = false, size = { w = 140, d = 64, minW = 60, maxW = 240, minD = 40, maxD = 95, dLabel = "Height" }, desc = "The giant scaffold of a stadium tour: two towers with PA hangs, a roof and covered wings. Place it over the stage." },
	{ id = "delaytower", name = "Delay Tower", cat = "Stage", cost = 3000, pts = 4, tags = {}, mount = "floor", deck = false, desc = "Speaker and follow-spot tower in the crowd, so the back rows of a stadium hear the show too." },
	{ id = "truss", name = "Truss Tower", cat = "Stage", cost = 400, pts = 1, tags = {}, mount = "floor", deck = false, desc = "Vertical truss tower." },
	{ id = "sidespeaker", name = "Hanging Speakers", cat = "Stage", cost = 900, pts = 3, tags = {}, mount = "side", deck = false, desc = "Line array hanging on the side of a Truss Tower, like at big shows. Put it on a tower and lift it up." },
	{ id = "speakers", name = "Speaker Stack", cat = "Stage", cost = 400, pts = 2, tags = {}, mount = "floor", deck = false, desc = "Subwoofers with a line array on top." },
	-- Artist: where the artist performs and what they play
	{ id = "spot", name = "Artist Spot", cat = "Artist", cost = 0, pts = 0, tags = {}, mount = "floor", deck = false, desc = "One spot = one song. The artist walks to spot 1 for the first song, spot 2 for the second, and so on. More spots = longer setlist (up to 12)." },
	{ id = "lift", name = "Artist Lift", cat = "Artist", cost = 6000, pts = 12, tags = { "spectacle" }, mount = "floor", deck = false, desc = "The artist rises out of the stage. Choose the song it is used for." },
	{ id = "poplift", name = "Pop-Up Lift", cat = "Artist", cost = 8500, pts = 14, tags = { "spectacle", "energy" }, mount = "floor", deck = false, desc = "Toaster lift: a trapdoor opens and the artist is shot up onto the stage in a burst of sparks and CO2. Choose the song." },
	{ id = "towerlift", name = "Tower Lift", cat = "Artist", cost = 12000, pts = 16, tags = { "spectacle", "intimate" }, mount = "floor", deck = false, desc = "Round B-stage platform on a telescopic column. During its song it lifts the artist high above the crowd. Put it at the end of a runway or in the crowd." },
	{ id = "scissor", name = "Scissor Lift", cat = "Artist", cost = 7500, pts = 12, tags = { "spectacle" }, mount = "floor", deck = false, desc = "Platform that rises high during the finale." },
	{ id = "piano", name = "Grand Piano", cat = "Artist", cost = 1500, pts = 4, tags = { "intimate" }, mount = "floor", deck = false, desc = "Black grand piano. The artist can play it during one song." },
	{ id = "keys", name = "Keyboard Rig", cat = "Artist", cost = 1100, pts = 3, tags = { "intimate", "band" }, mount = "floor", deck = false, desc = "Two keyboards on a stand, like a B-stage acoustic moment." },
	{ id = "drums", name = "Drum Kit", cat = "Artist", cost = 900, pts = 3, tags = { "band" }, mount = "floor", deck = false, desc = "Drum riser with kit. Bands use it, solo artists can play it in one song." },
	{ id = "djbooth", name = "DJ Booth", cat = "Artist", cost = 1500, pts = 4, tags = { "dj" }, mount = "floor", deck = false, desc = "DJ table with LED front." },
	{ id = "acoustic", name = "Acoustic Set", cat = "Artist", cost = 900, pts = 4, tags = { "intimate" }, mount = "floor", deck = false, desc = "Stool, mic and an acoustic guitar for the quiet part of the show. Choose the song the artist plays it in." },
	{ id = "harp", name = "Concert Harp", cat = "Artist", cost = 2400, pts = 5, tags = { "intimate" }, mount = "floor", deck = false, desc = "Golden concert harp. The artist can play it in one song." },
	{ id = "upright_bass", name = "Double Bass", cat = "Artist", cost = 900, pts = 2, tags = { "band", "retro" }, mount = "floor", deck = false, desc = "Upright bass on its stand for jazzy and acoustic sets." },
	{ id = "strings", name = "String Section", cat = "Artist", cost = 2600, pts = 6, tags = { "intimate", "spectacle" }, mount = "floor", deck = false, desc = "Four chairs with music stands, violins and cellos." },
	{ id = "horns", name = "Horn Section", cat = "Artist", cost = 2200, pts = 5, tags = { "band", "party" }, mount = "floor", deck = false, desc = "Trumpet, saxophone and trombone on stands with lit music desks." },
	{ id = "choir", name = "Choir Risers", cat = "Artist", cost = 1800, pts = 4, tags = { "spectacle", "intimate" }, mount = "floor", deck = false, desc = "Curved three-step risers for a choir or dancers, with glowing edges." },
	-- Band: live musicians who play the whole show next to the artist (the artist keeps their own instruments)
	{ id = "band_drums", name = "Band Drummer", cat = "Band", cost = 1400, pts = 4, tags = { "band" }, mount = "floor", deck = false, desc = "A drummer on a riser who plays the whole show. The artist's own drum kit (Artist tab) stays free for the artist." },
	{ id = "band_guitar", name = "Band Guitarist", cat = "Band", cost = 1000, pts = 3, tags = { "band" }, mount = "floor", deck = false, desc = "A guitarist with an amp and pedals, playing every song." },
	{ id = "band_bass", name = "Band Bassist", cat = "Band", cost = 1000, pts = 3, tags = { "band" }, mount = "floor", deck = false, desc = "A bass player with a big bass cabinet." },
	{ id = "band_keys", name = "Band Keyboarder", cat = "Band", cost = 1100, pts = 3, tags = { "band", "intimate" }, mount = "floor", deck = false, desc = "Keys player behind two keyboards." },
	{ id = "band_backing", name = "Backing Singer", cat = "Band", cost = 700, pts = 2, tags = { "intimate" }, mount = "floor", deck = false, desc = "Backing vocals: sings and dances along to every song." },
	{ id = "micstand", name = "Mic Stand", cat = "Artist", cost = 150, pts = 1, tags = { "intimate" }, mount = "floor", deck = false, desc = "Classic microphone stand." },
	{ id = "amps", name = "Amp Stack", cat = "Artist", cost = 500, pts = 2, tags = { "band", "retro" }, mount = "floor", deck = false, desc = "Wall of guitar amps." },
	{ id = "guitarstand", name = "Guitar Stand", cat = "Artist", cost = 200, pts = 1, tags = { "band" }, mount = "floor", deck = false, desc = "Spare guitar on a stand." },
	{ id = "wedge", name = "Monitor Wedge", cat = "Artist", cost = 150, pts = 1, tags = {}, mount = "floor", deck = false, desc = "Floor speaker so the artist hears the band." },
