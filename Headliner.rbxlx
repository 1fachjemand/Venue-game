-- Look of the band members / dancers per genre (the lead artist has an own look)
Artists.BAND_STYLE = {
	Rock = { hair = { "long", "short", "messy" }, tops = { { 30, 30, 34 }, { 120, 30, 30 }, { 60, 60, 66 } }, pants = { { 40, 50, 90 }, { 20, 20, 24 } }, acc = { "none", "bandana", "sunglasses" } },
