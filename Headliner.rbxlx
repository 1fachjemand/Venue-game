<Item class="ServerScriptService" referent="RBX2A9BCF40C34A449BB12DF2A01FC0D305"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBXCDEAD9E3FBA74EE7972B298664BE632A"><Properties><string name="Name">SaveServer</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HEADLINER server: disables avatars and handles saving (DataStore only works in a published place).
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

Players.CharacterAutoLoads = false

local Remotes = ReplicatedStorage:WaitForChild("Headliner"):WaitForChild("Remotes")
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("HeadlinerSave_v1")
end)

local lastSave = {}

Remotes.LoadGame.OnServerInvoke = function(player)
	if not store then
		return nil, "unavailable"
	end
	local ok, data = pcall(function()
		return store:GetAsync("player_" .. player.UserId)
	end)
	if ok then
		return data, "ok"
	end
	return nil, "unavailable"
end

Remotes.SaveGame.OnServerEvent:Connect(function(player, json)
	if not store or type(json) ~= "string" or #json > 3500000 then
		return
	end
	local now = os.clock()
	if lastSave[player] and now - lastSave[player] < 6 then
		return
	end
	lastSave[player] = now
	pcall(function()
		store:SetAsync("player_" .. player.UserId, json)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	lastSave[player] = nil
end)
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX810888716D9448E1B902A57E9F14E0EF"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBXE3EAE22C78AC45BEA2D88A560A83529B"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX03481E7212534822AC6F2C2530BA6961"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HEADLINER client entry point
if not game:IsLoaded() then
	game.Loaded:Wait()
end
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Root = ReplicatedStorage:WaitForChild("Headliner")
local App = require(Root:WaitForChild("Client"):WaitForChild("App"))
App.start()
]]></ProtectedString></Properties></Item>
</Item>
