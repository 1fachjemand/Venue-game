		["us"] = { lat = 37.26, lon = -99.69, rects = { {17,45,4,1}, {18,40,16,1}, {19,35,34,1}, {19,72,1,1}, {20,34,44,1}, {21,32,46,1}, {22,27,51,1}, {23,26,52,1}, {24,30,48,1}, {25,32,46,1}, {26,31,2,1}, {26,35,43,1}, {27,27,6,1}, {27,36,42,1}, {28,24,54,1}, {29,25,53,1}, {30,27,51,1}, {31,37,41,1}, {32,16,4,1}, {32,38,40,1}, {33,16,7,1}, {33,31,2,1}, {33,34,44,1}, {34,30,48,1}, {35,28,50,1}, {36,27,51,1}, {37,28,50,1}, {38,29,36,1}, {38,66,12,1}, {39,14,1,1}, {39,25,4,1}, {39,30,26,1}, {39,57,11,1}, {39,69,13,1}, {40,26,3,1}, {40,31,3,1}, {40,36,19,1}, {40,56,5,1}, {40,64,1,1}, {40,77,6,1}, {41,36,16,1}, {41,56,3,1}, {41,81,4,1}, {41,87,3,1}, {42,36,18,1}, {42,55,1,1}, {42,84,8,1}, {43,45,7,1}, {43,53,3,1}, {43,86,7,1}, {44,44,6,1}, {44,51,5,1}, {44,87,7,1}, {45,42,6,1}, {45,50,5,1}, {45,88,4,1}, {45,93,2,1}, {46,20,1,1}, {46,40,6,1}, {46,52,1,1}, {46,89,7,1}, {47,39,4,1}, {47,90,9,1}, {48,35,7,1}, {48,48,1,1}, {48,93,7,1}, {49,33,8,1}, {49,92,8,1}, {50,30,4,1}, {50,35,1,1}, {50,94,2,1}, {50,97,3,1}, {51,28,1,1}, {51,34,1,1}, {52,25,3,1}, {53,22,4,1}, {54,22,1,1}, {54,705,2,1}, {55,10,4,1}, {55,707,1,1}, {55,715,1,1}, {56,3,1,1}, {56,5,2,1}, {56,714,1,1}, {56,717,1,1}, {56,719,1,1}, {57,718,1,1}, {62,114,57,1}, {63,110,2,1}, {63,113,63,1}, {63,183,1,1}, {64,110,76,1}, {65,111,78,1}, {65,221,1,1}, {65,223,1,1}, {66,112,78,1}, {67,112,80,1}, {66,220,4,2}, {68,112,81,1}, {68,219,5,1}, {69,217,8,1}, {69,112,83,2}, {70,209,17,1}, {71,111,84,1}, {71,208,15,1}, {72,111,85,1}, {72,207,14,1}, {73,111,84,2}, {73,202,17,2}, {75,198,21,1}, {75,111,83,2}, {76,195,24,1}, {77,111,106,1}, {77,218,1,1}, {78,111,105,1}, {79,111,101,1}, {80,112,100,1}, {81,112,99,1}, {82,112,98,1}, {83,114,96,1}, {84,114,95,1}, {85,115,94,1}, {86,116,93,1}, {87,116,92,1}, {88,117,92,1}, {89,118,90,2}, {91,121,84,1}, {92,123,80,1}, {93,123,79,1}, {94,125,76,1}, {95,132,67,1}, {96,135,9,1}, {96,147,51,1}, {97,148,50,1}, {98,150,47,1}, {99,151,47,1}, {100,151,4,1}, {100,157,25,1}, {100,189,2,1}, {100,192,6,1}, {101,152,2,1}, {101,158,12,1}, {101,177,5,1}, {101,193,5,1}, {102,159,11,1}, {103,160,7,1}, {102,194,5,2}, {104,160,6,1}, {105,161,5,1}, {104,194,6,2}, {106,162,4,1}, {106,195,5,1}, {107,163,3,1}, {107,196,4,1}, {108,197,3,2}, {110,196,1,1}, {115,40,2,1}, {116,39,1,1}, {116,43,2,2}, {117,46,1,1}, {118,46,2,1}, {119,48,1,1}, {120,48,3,1}, {121,48,2,1} } },
		["za"] = { lat = -29.00, lon = 25.08, rects = { {204,418,5,1}, {205,416,7,1}, {206,414,9,1}, {207,414,10,1}, {208,413,11,1}, {209,400,1,2}, {210,406,2,1}, {209,411,13,2}, {211,405,19,1}, {211,400,2,2}, {212,404,18,1}, {213,400,22,1}, {213,424,2,1}, {214,400,26,2}, {216,393,2,1}, {216,400,25,1}, {217,393,32,1}, {218,393,23,1}, {218,418,6,1}, {219,418,5,1}, {219,394,21,2}, {220,416,6,1}, {221,395,26,2}, {223,396,23,1}, {224,396,22,1}, {225,395,22,1}, {226,396,20,1}, {227,396,18,1}, {228,396,9,1}, {228,408,2,1}, {229,398,3,1}, {253,435,1,1} } },
